// ZoneActionRow: buttons in Korri's order, each line centred; a button that
// does not fit beside the one before starts the next line (ZoneActionRow.css
// wraps), so no button is cut at any width. Up to six. The plan decides the
// lines (src/plan/screen.ts buttonRow): each button's `line`.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneButton } from "../atoms/ZoneButton.slint";
import { Btn } from "../types.slint";

export component ZoneActionRow {
    callback activated(target: string, at: float, released: bool);
    in property <[Btn]> buttons;
    in property <length> cap: Tokens.c1;
    property <length> a: Tokens.a;
    property <int> count: Math.min(6, buttons.length);
    // Between two buttons: their triangles and their nudge.
    property <length> gap: 2 * cap + 10 * a;
    pure function span(i: int) -> length {
        return i >= count ? 0 : i == 0 ? b0.span : i == 1 ? b1.span : i == 2 ? b2.span : i == 3 ? b3.span : i == 4 ? b4.span : b5.span;
    }
    pure function btn(i: int) -> Btn {
        return i < count ? buttons[i] : { label: "" };
    }
    // Each button's line is the plan's (src/plan/screen.ts buttonRow, the
    // view's `line`); its offset follows the one before it on that line.
    property <int> l0: btn(0).line;
    property <length> o0: 0;
    property <int> l1: btn(1).line;
    property <length> o1: l1 != l0 ? 0 : o0 + span(0) + gap;
    property <int> l2: btn(2).line;
    property <length> o2: l2 != l1 ? 0 : o1 + span(1) + gap;
    property <int> l3: btn(3).line;
    property <length> o3: l3 != l2 ? 0 : o2 + span(2) + gap;
    property <int> l4: btn(4).line;
    property <length> o4: l4 != l3 ? 0 : o3 + span(3) + gap;
    property <int> l5: btn(5).line;
    property <length> o5: l5 != l4 ? 0 : o4 + span(4) + gap;
    pure function line(i: int) -> int {
        return i == 0 ? l0 : i == 1 ? l1 : i == 2 ? l2 : i == 3 ? l3 : i == 4 ? l4 : l5;
    }
    pure function offset(i: int) -> length {
        return i == 0 ? o0 : i == 1 ? o1 : i == 2 ? o2 : i == 3 ? o3 : i == 4 ? o4 : o5;
    }
    // A line's width: its last button's offset and span.
    pure function line-w(k: int) -> length {
        return Math.max(i-end(0, k), i-end(1, k), i-end(2, k), i-end(3, k), i-end(4, k), i-end(5, k));
    }
    pure function i-end(i: int, k: int) -> length {
        return i < count && line(i) == k ? offset(i) + span(i) : 0;
    }
    out property <int> lines: count == 0 ? 0 : line(count - 1) + 1;
    out property <length> needed: lines * 2 * cap + Math.max(0, lines - 1) * 5 * a;
    pure function bx(i: int) -> length {
        return (root.width - line-w(line(i))) / 2 + offset(i);
    }
    pure function by(i: int) -> length {
        return line(i) * (2 * cap + 5 * a);
    }
    height: needed;
    b0 := ZoneButton { activated(target, at, released) => { root.activated(target, at, released); }  visible: root.count > 0; target: root.visible; x: root.bx(0); y: root.by(0); btn: root.btn(0); cap: root.cap; }
    b1 := ZoneButton { activated(target, at, released) => { root.activated(target, at, released); }  visible: root.count > 1; target: root.visible; x: root.bx(1); y: root.by(1); btn: root.btn(1); cap: root.cap; }
    b2 := ZoneButton { activated(target, at, released) => { root.activated(target, at, released); }  visible: root.count > 2; target: root.visible; x: root.bx(2); y: root.by(2); btn: root.btn(2); cap: root.cap; }
    b3 := ZoneButton { activated(target, at, released) => { root.activated(target, at, released); }  visible: root.count > 3; target: root.visible; x: root.bx(3); y: root.by(3); btn: root.btn(3); cap: root.cap; }
    b4 := ZoneButton { activated(target, at, released) => { root.activated(target, at, released); }  visible: root.count > 4; target: root.visible; x: root.bx(4); y: root.by(4); btn: root.btn(4); cap: root.cap; }
    b5 := ZoneButton { activated(target, at, released) => { root.activated(target, at, released); }  visible: root.count > 5; target: root.visible; x: root.bx(5); y: root.by(5); btn: root.btn(5); cap: root.cap; }
}
