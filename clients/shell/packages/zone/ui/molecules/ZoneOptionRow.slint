// ZoneOptionRow: one row of OPTIONS (and of every list page): the label on its black panel, the value on its own (bars before a network's words, a range's bar), the pink drop when focused, the red triangles inside the value panel's ends on a choice, the red caret blinking while Korri saves.
// On LAUNCH SETTINGS a changed value is yellow, with its earlier value beside it in the quiet white when the plan gave it room (`it.was`); `primary` fills the label's panel yellow (the keep row, the page's one filled control).

import { Tokens } from "../../ui/tokens.slint";
import { ZoneTap } from "../atoms/ZoneTap.slint";
import { ZoneShape } from "../atoms/ZoneShape.slint";
import { ZonePanel } from "../atoms/ZonePanel.slint";
import { ZoneCaps } from "../atoms/ZoneCaps.slint";
import { ZoneMeasure } from "../atoms/ZoneMeasure.slint";
import { ZoneTriangle } from "../atoms/ZoneTriangle.slint";
import { ZoneBars } from "../atoms/ZoneBars.slint";
import { ZoneUnderline } from "../atoms/ZoneUnderline.slint";
import { Row } from "../types.slint";

export component ZoneOptionRow {
    callback activated(target: string, at: float, released: bool);
    in property <Row> it;
    // A focus target, for the walk that reads what is drawn (tests/zone_package.rs).
    accessible-role: button;
    accessible-item-selectable: true;
    accessible-item-selected: root.it.focused;
    accessible-label: root.it.label;
    property <length> a: Tokens.a;
    in property <float> nudge: Tokens.nudge-button;
    in property <bool> blink-on: Tokens.blink-on;
    in property <float> label-share: 0.55;
    in property <bool> primary: false;
    property <length> c1: 10 * a;
    property <length> cell: 14 * a;
    property <length> run: 13 * a;
    property <length> label-w: Math.floor(root.width * label-share / a) * a;
    property <length> value-x: label-w + 4 * a;
    property <length> value-w: root.width - value-x;
    out property <length> need: cell + 4 * a;
    height: need;
    property <bool> lit: it.focused;
    // The value's box; with an earlier value beside it, the pair stands centred in the box
    // (the plan checked that both fit: src/plan/launch-settings.ts launchRowFit).
    property <length> bars-room: it.bars >= 0 && it.kind == "item" ? 14 * a : 0;
    // A choice's triangles stand two art px inside each end of the value's room: its words keep clear of them.
    property <length> arrows-room: it.choice && it.kind == "item" ? 4 * a : 0;
    property <length> value-box: Math.max((1 * Tokens.unit), value-w - 2 * run - bars-room - 2 * arrows-room - (it.kind == "range" ? 50 * a : 0));
    property <bool> paired: it.was != "" && it.kind == "item";
    now-w := ZoneMeasure { text: root.it.value; cap: root.c1; face: root.it.value-fact ? "fact" : "caps"; }
    was-w := ZoneMeasure { text: root.it.was; cap: root.c1; face: "fact"; }
    property <length> pair-x: value-x + run + bars-room + arrows-room + Math.max(0 * Tokens.unit, (value-box - now-w.preferred-width - 4 * a - was-w.preferred-width) / 2);
    // The highlight: hidden while touch is in use (Tokens.ring); the focus stays.
    property <bool> ring: it.focused && Tokens.ring;
    // ---- item: label panel, value panel ----
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        if root.ring: ZoneUnderline {
            x: 0;
            y: 0;
            width: root.label-w;
            height: root.cell;
            run: root.run;
            left-straight: true;
        }
        ZonePanel {
            x: 0;
            y: 0;
            width: root.label-w;
            height: root.cell;
            run: root.run;
            left-straight: true;
            ink: root.primary ? Tokens.yellow : Tokens.black;
        }
        ZoneCaps {
            x: 4 * root.a;
            y: 2 * root.a;
            box: root.label-w - root.run - 6 * root.a;
            elide: true;
            text: root.it.label;
            cap: root.c1;
            ink: root.primary ? "ink" : root.it.disabled ? "flat" : "white";
            colour: Tokens.steel;
            face: root.it.label-fact ? "fact" : "caps";
        }
        ZonePanel {
            y: 0;
            x: root.value-x;
            width: root.value-w;
            height: root.cell;
            run: root.run;
            right-straight: true;
            ink: Tokens.black;
        }
        property <length> bars-w: root.it.bars >= 0 && root.it.kind == "item" ? 14 * root.a : 0;
        if root.it.kind == "item" && root.it.bars >= 0: ZoneBars {
            x: root.value-x + root.run + 2 * root.a;
            y: (root.cell - 8 * root.a) / 2;
            lit: root.it.bars;
        }
        // A range: the bar, the danger orange on the track.
        if root.it.kind == "range": Rectangle {
            x: root.value-x + root.value-w - root.run - 50 * root.a;
            y: (root.cell - 4 * root.a) / 2;
            width: 44 * root.a;
            height: 4 * root.a;
            background: Tokens.track;
            Rectangle {
                y: 0;
                height: parent.height;
                x: 0;
                width: parent.width * Math.clamp(root.it.bars / 100, 0, 1);
                background: Tokens.danger-shade;
            }
        }
        value := ZoneCaps {
            x: root.paired ? root.pair-x : root.value-x + root.run + root.bars-room + root.arrows-room;
            y: 2 * root.a;
            box: root.paired ? now-w.preferred-width : root.value-box;
            centre: root.it.kind == "item" && !root.paired;
            elide: !root.paired;
            text: root.it.value;
            cap: root.c1;
            ink: root.it.disabled || root.it.changed ? "flat" : root.it.danger ? "danger" : root.it.saving && root.it.kind == "range" ? "hud" : "white";
            colour: root.it.disabled ? Tokens.steel : Tokens.yellow;
            face: root.it.value-fact ? "fact" : "caps";
        }
        if root.paired: ZoneCaps {
            x: root.pair-x + now-w.preferred-width + 4 * root.a;
            y: 2 * root.a;
            text: root.it.was;
            cap: root.c1;
            ink: "flat";
            colour: Tokens.white-shade;
            face: "fact";
        }
        // Choice triangles inside the value panel's ends, nudging.
        if root.ring && root.it.choice: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            ZoneTriangle {
                x: root.value-x + root.run - 2 * root.a - 2 * root.a * root.nudge;
                y: (root.cell - 7 * root.a) / 2;
                width: 4 * root.a;
                height: 7 * root.a;
                left: true;
                ink: Tokens.red;
            }
            ZoneTriangle {
                x: root.width - root.run - 2 * root.a + 2 * root.a * root.nudge;
                y: (root.cell - 7 * root.a) / 2;
                width: 4 * root.a;
                height: 7 * root.a;
                ink: Tokens.red;
            }
        }
        // Saving: a red pixel caret blinking at the value panel's end.
        if root.it.saving && root.it.kind == "item" && root.blink-on: Rectangle {
            x: root.width - root.run - 6 * root.a;
            y: 3 * root.a;
            width: 2 * root.a;
            height: root.cell - 6 * root.a;
            background: Tokens.red;
        }
    }
    ZoneTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: root.it.focus-id; }
}
