import { Tokens } from "../../ui/tokens.slint";
import { ZonePreview } from "../../ui/preview-frame.slint";
import { ZoneTagRow } from "./ZoneTagRow.slint";

export component Card inherits ZonePreview {
    ZoneTagRow { x: (parent.width - 96 * Tokens.a) / 2; y: (parent.height - 16 * Tokens.a) / 2; width: 96 * Tokens.a; tags: [{ label: "Spelunky", kind: "system", korri: true }, { label: "Here", kind: "here" }, { label: "zao", kind: "remote", korri: true }, { label: "Continue", kind: "continue" }]; }
