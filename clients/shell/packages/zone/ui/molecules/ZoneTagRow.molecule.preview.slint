export component Natural inherits ZonePreview {
    ZoneTagRow { x: (parent.width - self.natural) / 2; y: (parent.height - 16 * Tokens.a) / 2; width: self.natural; fill: false; tags: [{ label: "Saved", kind: "here" }, { label: "System gba", kind: "system", korri: true }]; }
}
