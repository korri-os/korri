// ZoneSecretSlab: Korri's backup secret on its white slab, in groups of
// four, in Jersey 10 at whole px a Jersey pixel so 162 characters stand on
// screen for copying by hand; the pink edge while the cursor rests on it.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneTap } from "../atoms/ZoneTap.slint";

export component ZoneSecretSlab inherits Rectangle {
    callback activated(target: string, at: float, released: bool);
    in property <string> secret;
    in property <bool> focused;
    // Its focus target's id: what a tap on it reports (ADR 0055).
    in property <string> focus-id;
    // A focus target, for the walk that reads what is drawn (tests/zone_package.rs).
    accessible-role: button;
    accessible-item-selectable: true;
    accessible-item-selected: root.focused;
    accessible-label: "secret";
    property <length> a: Tokens.a;
    background: Tokens.white;
    border-width: focused && Tokens.ring ? 3 * a : a;
    border-color: Tokens.pink;
    Text {
        x: 6 * root.a;
        y: 6 * root.a;
        width: root.width - 12 * root.a;
        height: root.height - 12 * root.a;
        text: root.secret;
        wrap: word-wrap;
        horizontal-alignment: center;
        font-family: "Jersey 10";
        font-size: 1400 / 750 * 5 * Tokens.unit * Math.max(1, Math.floor(root.a / Tokens.unit * 0.7));
        color: Tokens.black;
    }
    ZoneTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: root.focus-id; }
}
