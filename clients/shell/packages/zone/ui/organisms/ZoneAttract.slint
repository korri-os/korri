// ZoneAttract: Zone's idle layer.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneCaps } from "../atoms/ZoneCaps.slint";
import { ZoneCoverWell } from "../atoms/ZoneCoverWell.slint";
import { ZoneTitleCard } from "../molecules/ZoneTitleCard.slint";
import { Card } from "../types.slint";

// The idle attract (ZoneAttract): the game the logic names (its idle layer,
// opened by the shell's Tick after 30 s with no press, the next game every
// 6 s): its title card, then its stage (its cover, panning). Only the turn's
// motion runs on the view's clock, from the moment this game showed.
export component ZoneAttract {
    property <length> a: Tokens.a;
    in property <[Card]> cards;
    in property <int> index;
    property <float> shown-ms: 0;
    init => {
        self.shown-ms = Tokens.clock-ms;
    }
    changed index => {
        self.shown-ms = Tokens.clock-ms;
    }
    // A preview holds the turn at a fixed time; -1 runs it on the clock.
    in property <float> hold-ms: -1;
    property <float> within: hold-ms >= 0 ? hold-ms : Math.min(Tokens.idle-cycle-ms, Tokens.clock-ms - shown-ms);
    property <Card> card: cards.length == 0 ? { title: "" } : cards[Math.clamp(index, 0, cards.length - 1)];
    property <bool> stage: within >= 2900;
    if !root.stage: ZoneTitleCard {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.card.title;
        system: root.card.tags.length > 0 && root.card.tags[0].kind == "system" ? root.card.tags[0].label : "";
        act: 0;
        t: Math.clamp(root.within / 320, 0, 1);
    }
    if root.stage: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Tokens.black;
        clip: true;
        ZoneCoverWell {
            y: 0;
            x: -32 * root.a * Math.clamp((root.within - 2900) / 2700, 0, 1);
            width: root.width + 32 * root.a;
            height: root.height;
            art: root.card.art;
            has-art: root.card.has-art;
            stripes: root.card.stripes;
            initials: root.card.initials;
        }
        ZoneCaps {
            x: 8 * root.a;
            y: root.height - 18 * root.a;
            text: root.card.title;
            cap: root.a * 10;
            face: "korri";
        }
    }
}
