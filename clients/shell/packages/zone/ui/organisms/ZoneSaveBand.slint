// ZoneSaveBand: MANIA MODE's save select: BACK UP, SWITCH (FROM BACKUP),
// SWITCH (BUNKER), then one card per retired key; the focused one centred
// as far as the band allows, a red triangle at each edge where more cards
// lie (steel where none do); a retired key's BACK UP and DELETE under the
// band while it has the cursor. One cursor on screen: `marked` off leaves
// the band unmarked while a keyboard, a dialog or the slab holds it.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneTap } from "../atoms/ZoneTap.slint";
import { ZoneSlide } from "../atoms/ZoneSlide.slint";
import { ZoneTriangle } from "../atoms/ZoneTriangle.slint";
import { ZoneSaveCard } from "../molecules/ZoneSaveCard.slint";
import { ZoneActionRow } from "../molecules/ZoneActionRow.slint";
import { SaveCard, Btn } from "../types.slint";

export component ZoneSaveBand {
    callback dragged(region: string, by: int);
    callback activated(target: string, at: float, released: bool);
    in property <[SaveCard]> cards;
    in property <int> at;
    in property <bool> marked;
    // The cursor stands on the focused retired key's buttons: its card stays marked.
    in property <bool> lit;
    in property <[Btn]> retired;
    property <length> a: Tokens.a;
    property <length> row-h: retired.length > 0 ? 2 * Tokens.c1 + 12 * a : 0;
    property <length> band-h: root.height - row-h;
    property <length> card-h: Math.max(0, Math.min(Tokens.card-most * a, band-h - 12 * a, (root.width - 40 * a) / 0.7));
    property <length> card-w: Math.floor(card-h * 0.7 / a) * a;
    property <length> gap: 8 * a;
    property <length> track: root.width / 2 - at * (card-w + gap) - card-w / 2;
    property <length> rest-shift: Math.max(Math.min(track, 20 * a), Math.min(20 * a, root.width - cards.length * (card-w + gap) - 20 * a + gap));
    // A sideways drag slides the band a card at a time; focus follows (ADR 0055).
    slide := ZoneSlide { dragged(region, by) => { root.dragged(region, by); }  region: "saves"; pitch: root.card-w + root.gap; rest: -root.rest-shift; first: root.at <= 0; last: root.at >= root.cards.length - 1; }
    property <length> shift: rest-shift + slide.offset;
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.band-h;
        clip: true;
        // Between the cards: a drag still slides the band, a tap does nothing.
        ZoneTap { activated(target, at, released) => { root.activated(target, at, released); }  slides: true;  slide(dx) => { slide.move(dx); }  slid => { slide.release(); }  x: 0; y: 0; width: parent.width; height: parent.height; }
        for c[i] in root.cards: ZoneSaveCard { activated(target, at, released) => { root.activated(target, at, released); }  slide(dx) => { slide.move(dx); }  slid => { slide.release(); } 
            cache-rendering-hint: true;
            x: root.shift + i * (root.card-w + root.gap);
            y: (root.band-h - root.card-h) / 2;
            width: root.card-w;
            height: root.card-h;
            card: c;
            // The card's own focus (the view's), or its buttons' (`lit`).
            focused: c.focused || (root.lit && i == root.at);
            slides: true;
        }
    }
    if root.marked && Tokens.ring: ZoneTriangle {
        x: 4 * root.a;
        y: root.band-h / 2 - 6 * root.a;
        width: 10 * root.a;
        height: 12 * root.a;
        left: true;
        ink: root.at > 0 ? Tokens.red : Tokens.steel;
    }
    if root.marked && Tokens.ring: ZoneTriangle {
        x: root.width - 14 * root.a;
        y: root.band-h / 2 - 6 * root.a;
        width: 10 * root.a;
        height: 12 * root.a;
        ink: root.at < root.cards.length - 1 ? Tokens.red : Tokens.steel;
    }
    if root.retired.length > 0: ZoneActionRow { activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: root.band-h + 4 * root.a;
        width: root.width;
        buttons: root.retired;
    }
}
