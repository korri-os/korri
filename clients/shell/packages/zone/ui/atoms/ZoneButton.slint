// ZoneButton: black panel, white caps (steel when inert, red when destructive), the pink drop when lit or focused, the breathing red triangles when focused.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneTap } from "./ZoneTap.slint";
import { ZonePanel } from "./ZonePanel.slint";
import { ZoneCaps } from "./ZoneCaps.slint";
import { ZoneMeasure } from "./ZoneMeasure.slint";
import { ZoneTriangle } from "./ZoneTriangle.slint";
import { ZoneUnderline } from "./ZoneUnderline.slint";
import { Btn } from "../types.slint";

// A button (ZoneButton): black panel, white caps (steel when inert, the
// danger red when destructive), the pink drop when lit (2 art px) or
// focused (3), and the breathing red triangles when focused.
export component ZoneButton {
    callback activated(target: string, at: float, released: bool);
    in property <Btn> btn;
    // False on a row that draws nothing (a trial row): not a focus target.
    in property <bool> target: true;
    // A focus target, for the walk that reads what is drawn (tests/zone_package.rs).
    accessible-role: button;
    accessible-item-selectable: root.btn.label != "" && root.target;
    accessible-item-selected: root.btn.focused;
    accessible-label: root.btn.label;
    property <length> a: Tokens.a;
    in property <float> nudge: Tokens.nudge-button;
    in property <length> cap: 10 * a;
    property <length> run: 2 * cap - a;
    out property <length> span: btn.label == "" ? 0 : words.preferred-width + 2 * (run + 5 * a);
    width: span;
    height: 2 * cap;
    // The highlight: hidden while touch is in use (Tokens.ring); the focus stays.
    property <bool> ring: btn.focused && Tokens.ring;
    property <length> depth: ring ? 3 * a : 2 * a;
    words := ZoneMeasure {
        text: root.btn.label.to-uppercase();
        cap: root.cap;
    }
    if root.btn.label != "": Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        if root.btn.lit || root.ring: ZoneUnderline {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            run: root.run;
            depth: root.depth;
        }
        ZonePanel {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            run: root.run;
            ink: Tokens.black;
        }
        ZoneCaps {
            x: root.run + 5 * root.a;
            y: (root.height - root.cap) / 2;
            text: root.btn.label;
            cap: root.cap;
            ink: root.btn.disabled ? "flat" : root.btn.danger ? "danger" : "white";
            colour: Tokens.steel;
        }
    }
    // The inline cursor: 7 art px wide, 1.1 times as tall, breathing 2 to 4 art px.
    property <length> tw: 7 * a;
    property <length> gap: 2 * a + 2 * a * nudge;
    if root.ring: ZoneTriangle {
        x: -root.gap - root.tw;
        y: (root.height - root.tw * 1.1) / 2;
        width: root.tw;
        height: root.tw * 1.1;
        ink: Tokens.red;
    }
    if root.ring: ZoneTriangle {
        x: root.width + root.gap;
        y: (root.height - root.tw * 1.1) / 2;
        width: root.tw;
        height: root.tw * 1.1;
        left: true;
        ink: Tokens.red;
    }
    ZoneTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: root.target && root.btn.label != "" ? root.btn.focus-id : ""; }
}
