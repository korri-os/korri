// ZoneTab: one tab of the strip; the active one is the banner, the others black panels; a focused tab lifts 2 art px and wears the pink drop.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneBanner } from "./ZoneBanner.slint";
import { ZonePanel } from "./ZonePanel.slint";
import { ZoneCaps } from "./ZoneCaps.slint";
import { ZoneMeasure } from "./ZoneMeasure.slint";
import { Tab } from "../types.slint";

// One tab: the active one is the banner, the others black panels. A
// focused tab lifts 2 art px with the snap and wears the pink drop.
export component ZoneTab {
    in property <Tab> tab;
    property <length> a: Tokens.a;
    in property <length> pad-y;
    property <length> c1: 10 * a;
    property <length> th: c1 + 2 * pad-y;
    property <length> run: th - a;
    property <length> tab-w: small.preferred-width + 2 * (run + 2 * a);
    small := ZoneMeasure { text: root.tab.label.to-uppercase(); cap: root.c1; }
    out property <length> span: tab.active ? banner.span : tab-w;
    width: span;
    height: 0;
    property <length> lift: tab.focused ? -2 * a : 0;
    animate lift {
        duration: 180ms;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    // The focus target the probe and the walk read: the tab's drawn box (the
    // tab itself is a zero-height line through its centre). Draws nothing.
    Rectangle {
        x: 0;
        y: -self.height / 2 + root.lift;
        width: root.span;
        height: root.tab.active ? banner.height : root.th;
        accessible-role: button;
        accessible-item-selectable: true;
        accessible-item-selected: root.tab.focused;
        accessible-label: root.tab.label;
    }
    banner := ZoneBanner {
        x: 0;
        visible: root.tab.active;
        y: -self.height / 2 + root.lift;
        label: root.tab.label;
        focused: root.tab.focused;
    }
    if !root.tab.active: Rectangle {
        x: 0;
        y: -root.th / 2 + root.lift;
        width: root.tab-w;
        height: root.th;
        if root.tab.focused: ZonePanel {
            x: -3 * root.a;
            y: 3 * root.a;
            width: root.tab-w;
            height: root.th;
            run: root.run;
            ink: Tokens.pink;
        }
        ZonePanel {
            x: 0;
            y: 0;
            width: root.tab-w;
            height: root.th;
            run: root.run;
            ink: Tokens.black;
        }
        ZoneCaps {
            x: root.run + 2 * root.a;
            y: root.pad-y;
            text: root.tab.label;
            cap: root.c1;
        }
    }
}
