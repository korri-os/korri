// ZoneKeycap: the disc, its letter, and at a wide enough strip the word on a black tail behind it.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneTap } from "./ZoneTap.slint";
import { ZoneShape } from "./ZoneShape.slint";
import { ZoneCaps } from "./ZoneCaps.slint";

// A keycap hint (ZoneKeycap): the disc, its letter, and at a wide enough
// strip the word on a black tail behind it.
export component ZoneKeycap {
    callback activated(target: string, at: float, released: bool);
    in property <string> key;
    in property <string> word;
    // The hint's focus target (ADR 0055): a tap runs its button. Empty: none.
    in property <string> focus-id;
    // A focus target for the probe; the cursor is never on it.
    accessible-role: button;
    accessible-item-selectable: root.focus-id != "";
    accessible-item-selected: false;
    accessible-label: root.word;
    in property <color> key-ink;
    property <length> a: Tokens.a;
    in property <bool> words;
    in property <length> pad;
    property <length> c1: 10 * a;
    property <length> d: 1.5 * c1;
    out property <length> span: words ? d + pad + label.natural + 14 * a : d;
    width: span;
    height: d;
    property <length> wx: d / 2;
    property <length> ww: span - d / 2;
    property <length> wy: d / 2 - 6 * a;
    if root.words: ZoneShape {
        x: root.wx;
        y: root.wy;
        width: root.ww;
        height: 12 * root.a;
        ink: Tokens.black;
        commands: "M 0 0 L " + Tokens.pt(0, 12 * root.a) + " L " + Tokens.pt(root.ww - 11 * root.a, 12 * root.a)
            + " L " + Tokens.pt(root.ww - 11 * root.a, 11 * root.a) + " L " + Tokens.pt(root.ww, 0) + " Z";
    }
    Rectangle {
        x: root.wx;
        y: root.wy;
        width: root.ww;
        height: 12 * root.a;
        clip: true;
        visible: root.words;
        label := ZoneCaps {
            x: root.d / 2 + root.pad;
            y: root.a;
            text: root.word;
            cap: root.c1;
        }
    }
    Rectangle {
        x: 0;
        y: 0;
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: Tokens.black;
    }
    Rectangle {
        x: root.a;
        y: root.a;
        width: root.d - 2 * root.a;
        height: root.d - 2 * root.a;
        border-radius: self.width / 2;
        background: Tokens.key-disc;
    }
    letter := ZoneCaps {
        x: (root.d - self.natural) / 2;
        y: 2 * root.a;
        text: root.key;
        cap: root.c1;
        ink: "flat";
        colour: root.key-ink;
    }
    ZoneTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: root.focus-id; }
}
