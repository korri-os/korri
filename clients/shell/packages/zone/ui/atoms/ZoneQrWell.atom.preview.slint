import { Tokens } from "../../ui/tokens.slint";
import { ZonePreview } from "../../ui/preview-frame.slint";
import { ZoneQrWell } from "./ZoneQrWell.slint";

export component Default inherits ZonePreview {
    ground: "savedata";
