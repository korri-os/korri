import { Tokens } from "../../ui/tokens.slint";
import { ZonePreview } from "../../ui/preview-frame.slint";
import { ZoneCoverWell } from "./ZoneCoverWell.slint";

export component NoArt inherits ZonePreview {
    ZoneCoverWell { x: (parent.width - 60 * Tokens.a) / 2; y: (parent.height - 80 * Tokens.a) / 2; width: 60 * Tokens.a; height: 80 * Tokens.a; has-art: false; stripes: 3; initials: "LZ"; }
}

export component Tiny inherits ZonePreview {
    ZoneCoverWell { x: (parent.width - 20 * Tokens.a) / 2; y: (parent.height - 26 * Tokens.a) / 2; width: 20 * Tokens.a; height: 26 * Tokens.a; has-art: false; stripes: 0; initials: "CC"; }
}
