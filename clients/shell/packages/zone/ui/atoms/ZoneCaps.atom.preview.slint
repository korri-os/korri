import { Tokens } from "../../ui/tokens.slint";
import { ZonePreview } from "../../ui/preview-frame.slint";
import { ZoneCaps } from "./ZoneCaps.slint";

export component White inherits ZonePreview {
    ZoneCaps { x: (parent.width - self.width) / 2; y: (parent.height - Tokens.c2) / 2; text: "Save data"; cap: Tokens.c2; }
}

export component Hud inherits ZonePreview {
    ZoneCaps { x: (parent.width - self.width) / 2; y: (parent.height - Tokens.c1) / 2; text: "Last played"; ink: "hud"; }
}

export component Danger inherits ZonePreview {
    ZoneCaps { x: (parent.width - self.width) / 2; y: (parent.height - Tokens.c2) / 2; text: "Run"; ink: "danger"; cap: Tokens.c2; }
