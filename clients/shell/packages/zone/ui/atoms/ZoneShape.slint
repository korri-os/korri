// A filled path in local px: every slant Zone draws (CSS drew them with clip-path).

import { Tokens } from "../../ui/tokens.slint";

// A filled path in local px.
export component ZoneShape inherits Path {
    in property <brush> ink;
    fill: ink;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: self.width / (1 * Tokens.unit);
    viewbox-height: self.height / (1 * Tokens.unit);
    clip: false;
}
