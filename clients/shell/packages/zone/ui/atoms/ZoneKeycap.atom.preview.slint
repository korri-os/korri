// ZoneKeycap's preview states, with fixture data from Zone's fixtures.
// Written by preview/write-previews.py.

import { Tokens } from "../../ui/tokens.slint";
import { ZonePreview } from "../../ui/preview-frame.slint";
import { ZoneKeycap } from "./ZoneKeycap.slint";

export component BackWord inherits ZonePreview {
    ZoneKeycap { x: (parent.width - self.span) / 2; y: (parent.height - self.height) / 2; key: "B"; word: "Back"; key-ink: Tokens.key-b; words: true; pad: 5 * Tokens.a; }
}

export component KeyOnly inherits ZonePreview {
    ZoneKeycap { x: (parent.width - self.span) / 2; y: (parent.height - self.height) / 2; key: "A"; word: "Confirm"; key-ink: Tokens.key-a; words: false; pad: 2 * Tokens.a; }
}
