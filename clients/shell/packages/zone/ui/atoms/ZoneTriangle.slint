// ZoneTriangle: the solid cursor triangle; `left` points left.

import { Tokens } from "../../ui/tokens.slint";
import { ZoneShape } from "./ZoneShape.slint";

// A solid triangle; `left` points left.
export component ZoneTriangle inherits ZoneShape {
    in property <bool> left;
    commands: left ? "M 1 0 L 0 0.5 L 1 1 Z" : "M 0 0 L 1 0.5 L 0 1 Z";
    viewbox-width: 1;
    viewbox-height: 1;
}
