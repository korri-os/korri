// Zone as a native surface package (docs/briefs/2026-10-31-native-surfaces-contract.md).
//
// The binding: the only file that knows the view. The shell sets the
// Surface's (and the Overlay's) properties from logic.ts's view() and
// overlay(); this file feeds the Tokens global its inputs (the window's
// size, the look, the screen group's ground) and hands each page plain
// properties. Below it every component is a shape (ui/, pages/).
//
// Frame cost: every still part stands in a `cache-rendering-hint` layer
// (the shell's Slint caches them, clients/shell/vendor), and a page that is
// not shown holds no items. Each frame only the ground's three dots and the
// cursor's triangles move.

import { Tokens } from "ui/tokens.slint";
import { Tab, Hints, Signal, Foot, Btn, Tag, Row, Key, Keyboard, Dialog, Busy, Card, Fact, Head, WellInfo, SaveCard, Seat, NewSave, LaunchCard, TallyRow, Tally, Hud } from "ui/types.slint";
import { ZoneStatusLayer } from "ui/organisms/ZoneStatusLayer.slint";
import { ZoneGames } from "pages/ZoneGames.slint";
import { ZoneOptions } from "pages/ZoneOptions.slint";
import { ZoneSaveData } from "pages/ZoneSaveData.slint";
import { ZoneRunWith } from "pages/ZoneRunWith.slint";
import { ZoneStore } from "pages/ZoneStore.slint";
import { ZoneLaunchSettings } from "pages/ZoneLaunchSettings.slint";
import { ZoneOnboarding } from "pages/ZoneOnboarding.slint";
import { ZonePaused } from "pages/ZonePaused.slint";

export { Tab, Hints, Signal, Foot, Btn, Tag, Row, Key, Keyboard, Dialog, Busy, Card, Fact, Head, WellInfo, SaveCard, Seat, NewSave, LaunchCard, TallyRow, Tally, Hud }

export component Surface inherits Window {
    title: "Zone";
    background: Tokens.ground-fill;

    // ---- From logic.ts's view() ----
    in property <string> look: "blend";
    in property <string> page: "games";
    in property <string> ground: "games";
    in property <bool> tabs-shown: true;
    in property <string> banner;
    in property <int> pips;
    in property <int> pip;
    in property <[Tab]> tabs;
    in property <Hints> hints;
    in property <Foot> foot;
    in property <string> zone: "cards";
    in property <string> catalog: "Loading";
    in property <[Card]> cards;
    in property <int> focused-card;
    in property <bool> card-focused;
    in property <int> first-index;
    in property <int> total;
    in property <[Fact]> facts;
    in property <[Btn]> actions;
    in property <bool> find-shown;
    in property <string> find-label: "Find";
    in property <bool> find-focused;
    in property <string> kept;
    in property <bool> get-shown;
    in property <bool> get-focused;
    in property <bool> typing;
    in property <bool> attract;
    in property <int> attract-card;
    in property <bool> opts-shown;
    in property <string> opts-title;
    in property <[Row]> opts-rows;
    in property <Head> head;
    in property <[Row]> rows;
    in property <WellInfo> well;
    in property <[SaveCard]> save-cards;
    in property <int> save-focus;
    in property <bool> save-marked;
    in property <[Btn]> retired;
    in property <bool> qr-shown;
    in property <image> qr;
    in property <string> secret;
    in property <bool> slab-focused;
    in property <[Seat]> seats;
    in property <string> seat-name;
    in property <bool> versus;
    in property <Btn> next;
    in property <NewSave> new-save;
    in property <Keyboard> keyboard;
    in property <Dialog> dialog;
    in property <Busy> busy;
    in property <Hud> hud;
    in property <LaunchCard> launch-card;
    in property <Tally> tally;
    in property <bool> veil;

    // ---- The Tokens' inputs ----
    init => {
        Tokens.width = self.width;
        Tokens.height = self.height;
        Tokens.look = self.look;
        Tokens.ground = self.ground;
    }
    changed width => {
        Tokens.width = self.width;
    }
    changed height => {
        Tokens.height = self.height;
    }
    changed look => {
        Tokens.look = self.look;
    }
    changed ground => {
        Tokens.ground = self.ground;
    }

    if root.page == "games": ZoneGames {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        catalog: root.catalog;
        cards: root.cards;
        focused-card: root.focused-card;
        card-focused: root.card-focused;
        first-index: root.first-index;
        total: root.total;
        facts: root.facts;
        actions: root.actions;
        find-shown: root.find-shown;
        find-label: root.find-label;
        find-focused: root.find-focused;
        kept: root.kept;
        get-shown: root.get-shown;
        get-focused: root.get-focused;
        typing: root.typing;
        keyboard: root.keyboard;
        opts-shown: root.opts-shown;
        opts-title: root.opts-title;
        opts-rows: root.opts-rows;
        launch-card: root.launch-card;
        tally: root.tally;
        attract: root.attract;
        attract-card: root.attract-card;
    }
    if root.page == "options" || root.page == "join": ZoneOptions {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
    }
    if root.page == "runwith": ZoneRunWith {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
    }
    if root.page == "store": ZoneStore {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
        bottom-room: root.busy.shown ? 60 * Tokens.a : 0;
    }
    if root.page == "launch": ZoneLaunchSettings {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
    }
    if root.page == "savedata": ZoneSaveData {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        cards: root.save-cards;
        at: root.save-focus;
        marked: root.save-marked;
        retired: root.retired;
        qr-shown: root.qr-shown;
        qr: root.qr;
        secret: root.secret;
        slab-focused: root.slab-focused;
        keyboard: root.keyboard;
    }
    if root.page == "onboarding": ZoneOnboarding {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        banner: root.banner;
        pips: root.pips;
        pip: root.pip;
        rows: root.rows;
        seats: root.seats;
        seat-name: root.seat-name;
        versus: root.versus;
        next: root.next;
        new-save: root.new-save;
        keyboard: root.keyboard;
    }
    ZoneStatusLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        busy: root.busy;
        dialog: root.dialog;
        hud: root.hud;
        veil-busy: root.page != "store" && !root.launch-card.shown;
        foot-h: root.foot.shown ? Tokens.foot-h : 0;
    }
}

// PAUSED: the Overlay, driven by overlay().
export component Overlay inherits Window {
    title: "Zone overlay";
    background: Tokens.ground-paused;
    in property <string> look: "blend";
    in property <string> heading: "Paused";
    in property <bool> korri-heading;
    in property <bool> has-art;
    in property <image> art;
    in property <[Row]> rows;
    in property <int> focus-at;
    in property <Dialog> dialog;
    in property <Busy> busy;
    in property <Hints> hints;
    init => {
        Tokens.width = self.width;
        Tokens.height = self.height;
        Tokens.look = self.look;
        Tokens.ground = "paused";
    }
    changed width => {
        Tokens.width = self.width;
    }
    changed height => {
        Tokens.height = self.height;
    }
    changed look => {
        Tokens.look = self.look;
    }
    ZonePaused {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        heading: root.heading;
        korri-heading: root.korri-heading;
        has-art: root.has-art;
        art: root.art;
        rows: root.rows;
        focus-at: root.focus-at;
        dialog: root.dialog;
        busy: root.busy;
        hints: root.hints;
    }
}
