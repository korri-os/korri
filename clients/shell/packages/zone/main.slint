// Zone as a native surface package (docs/briefs/2026-10-31-native-surfaces-contract.md).
//
// The binding: the only file that knows the view. The shell sets the
// Surface's (and the Overlay's) properties from logic.ts's view() and
// overlay(); this file feeds the Tokens global its inputs (the window's
// size, the look, the screen group's ground) and hands each page plain
// properties. Below it every component is a shape (ui/, pages/).
//
// Input: one generic activation callback and one drag callback, no
// per-control callbacks (ADR 0055). A tap or a click on a focus target
// reports its id through `activated(target, at, released)`; every layer
// passes it up to the root and the shell carries it to logic.js as
// `Activated`. `at` is the finger's place along a range's track, 0 to 1
// (`at < 0`: absent); `released` is true on the message sent as the finger
// lifts off a range (false: absent). A sideways drag or fling on a rack that
// moves by focus (the band, the save band) sends `dragged(region, by)` each
// time the finger crosses a whole card: `Dragged` moves focus by `by` in
// that region. `touching` hides the focus highlight after a tap or a drag,
// and a finger's scroll of a list hides it here in the view
// (`scrolled-by-finger`) until the cursor next moves (`focus-key`) or a
// button follows a tap.
//
// Frame cost: every still part stands in a `cache-rendering-hint` layer
// (the shell's Slint caches them, clients/shell/vendor), and a page that is
// not shown holds no items. Each frame only the ground's three dots and the
// cursor's triangles move.

import { Tokens } from "ui/tokens.slint";
import { Screen, Mark, Tab, Hints, Signal, Foot, Btn, Tag, Row, Key, Keyboard, Dialog, Busy, Card, Fact, Strip, Head, WellInfo, SaveCard, Seat, NewSave, LaunchCard, TallyRow, Tally, Hud } from "ui/types.slint";
import { ZoneStatusLayer } from "ui/organisms/ZoneStatusLayer.slint";
import { ZoneGames } from "pages/ZoneGames.slint";
import { ZoneOptions } from "pages/ZoneOptions.slint";
import { ZoneSaveData } from "pages/ZoneSaveData.slint";
import { ZoneRunWith } from "pages/ZoneRunWith.slint";
import { ZoneStore } from "pages/ZoneStore.slint";
import { ZoneLaunchSettings } from "pages/ZoneLaunchSettings.slint";
import { ZoneOnboarding } from "pages/ZoneOnboarding.slint";
import { ZonePaused } from "pages/ZonePaused.slint";

export { Screen, Mark, Tab, Hints, Signal, Foot, Btn, Tag, Row, Key, Keyboard, Dialog, Busy, Card, Fact, Strip, Head, WellInfo, SaveCard, Seat, NewSave, LaunchCard, TallyRow, Tally, Hud }

export component Surface inherits Window {
    // A focus target was tapped or clicked (ADR 0055): one callback for every target.
    callback activated(target: string, at: float, released: bool);
    // A rack moved by focus was dragged across `by` whole items (ADR 0055).
    callback dragged(region: string, by: int);
    // A tap or a drag came last, not a button: the focus highlight hides.
    in property <bool> touching;
    // Where logic's cursor is: a move ends a finger's scroll.
    in property <string> focus-key;
    // A finger scrolled a list (ADR 0055): the highlight hides too.
    // View-local: no message, no logic per frame.
    property <bool> scrolled-by-finger;
    function finger-scrolled() {
        if (!self.scrolled-by-finger) {
            self.scrolled-by-finger = true;
            Tokens.touching = true;
        }
    }
    // What ends a finger's scroll, in one place: for now the cursor moving,
    // or a button after a tap (logic's `touching` falling). The highlight
    // returns, and the lists bring the focused row back (Tokens.ring).
    function finger-done() {
        self.scrolled-by-finger = false;
        Tokens.touching = self.touching;
    }
    changed focus-key => {
        self.finger-done();
    }
    title: "Zone";
    background: Tokens.ground-fill;

    // ---- From logic.ts's view() ----
    in property <string> look: "blend";
    in property <Screen> screen: Tokens.screen;
    in property <string> page: "games";
    in property <string> ground: "games";
    in property <bool> tabs-shown: true;
    in property <string> banner;
    in property <int> pips;
    in property <int> pip;
    in property <[Tab]> tabs;
    in property <Hints> hints;
    in property <Foot> foot;
    in property <string> zone: "cards";
    in property <string> catalog: "Loading";
    in property <[Card]> cards;
    in property <int> focused-card;
    in property <bool> card-focused;
    in property <[Mark]> card-marks;
    in property <int> first-index;
    in property <int> total;
    in property <[Fact]> facts;
    in property <[Btn]> actions;
    in property <bool> find-shown;
    in property <Btn> find;
    in property <string> kept;
    in property <bool> get-shown;
    in property <Btn> get;
    in property <bool> typing;
    in property <bool> attract;
    in property <int> attract-card;
    in property <bool> opts-shown;
    in property <string> opts-title;
    in property <[Row]> opts-rows;
    in property <Head> head;
    in property <[Row]> rows;
    in property <WellInfo> well;
    in property <[SaveCard]> save-cards;
    in property <int> save-focus;
    in property <bool> save-marked;
    in property <bool> save-lit;
    in property <[Btn]> retired;
    in property <bool> qr-shown;
    in property <image> qr;
    in property <string> secret;
    in property <Btn> slab;
    in property <[Seat]> seats;
    in property <string> seat-name;
    in property <bool> versus;
    in property <Btn> next;
    in property <NewSave> new-save;
    in property <Keyboard> keyboard;
    in property <Dialog> dialog;
    in property <Busy> busy;
    in property <Hud> hud;
    in property <LaunchCard> launch-card;
    in property <Tally> tally;
    in property <bool> veil;

    // ---- The Tokens' inputs ----
    init => {
        Tokens.width = self.width;
        Tokens.height = self.height;
        Tokens.look = self.look;
        Tokens.ground = self.ground;
        Tokens.screen = self.screen;
        Tokens.touching = self.touching;
    }
    changed touching => {
        if (self.touching) {
            Tokens.touching = true;
        } else {
            self.finger-done();
        }
    }
    changed screen => {
        Tokens.screen = self.screen;
    }
    changed width => {
        Tokens.width = self.width;
    }
    changed height => {
        Tokens.height = self.height;
    }
    changed look => {
        Tokens.look = self.look;
    }
    changed ground => {
        Tokens.ground = self.ground;
    }

    if root.page == "games": ZoneGames { scrolled => { root.finger-scrolled(); }  dragged(region, by) => { root.dragged(region, by); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        catalog: root.catalog;
        cards: root.cards;
        focused-card: root.focused-card;
        card-focused: root.card-focused;
        card-marks: root.card-marks;
        first-index: root.first-index;
        total: root.total;
        facts: root.facts;
        actions: root.actions;
        find-shown: root.find-shown;
        find: root.find;
        kept: root.kept;
        get-shown: root.get-shown;
        get: root.get;
        typing: root.typing;
        keyboard: root.keyboard;
        opts-shown: root.opts-shown;
        opts-title: root.opts-title;
        opts-rows: root.opts-rows;
        launch-card: root.launch-card;
        tally: root.tally;
        attract: root.attract;
        attract-card: root.attract-card;
    }
    if root.page == "options" || root.page == "join": ZoneOptions { scrolled => { root.finger-scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
    }
    if root.page == "runwith": ZoneRunWith { scrolled => { root.finger-scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
    }
    if root.page == "store": ZoneStore { scrolled => { root.finger-scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
        bottom-room: root.busy.shown ? 60 * Tokens.a : 0;
    }
    if root.page == "launch": ZoneLaunchSettings { scrolled => { root.finger-scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        foot: root.foot;
        head: root.head;
        rows: root.rows;
        well: root.well;
        keyboard: root.keyboard;
    }
    if root.page == "savedata": ZoneSaveData { dragged(region, by) => { root.dragged(region, by); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        cards: root.save-cards;
        at: root.save-focus;
        marked: root.save-marked;
        lit: root.save-lit;
        retired: root.retired;
        qr-shown: root.qr-shown;
        qr: root.qr;
        secret: root.secret;
        slab-focused: root.slab.focused;
        slab-id: root.slab.focus-id;
        keyboard: root.keyboard;
    }
    if root.page == "onboarding": ZoneOnboarding { scrolled => { root.finger-scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        hints: root.hints;
        banner: root.banner;
        pips: root.pips;
        pip: root.pip;
        rows: root.rows;
        seats: root.seats;
        seat-name: root.seat-name;
        versus: root.versus;
        next: root.next;
        new-save: root.new-save;
        keyboard: root.keyboard;
    }
    ZoneStatusLayer { activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        busy: root.busy;
        dialog: root.dialog;
        hud: root.hud;
        veil-busy: root.page != "store" && !root.launch-card.shown;
        foot-h: root.foot.shown ? Tokens.foot-h : 0;
    }
}

// PAUSED: the Overlay, driven by overlay(). See-through: the running game
// is PAUSED's ground (ADR 0053). A window without alpha (the shell on Linux)
// shows black there instead. `has-art` and `art` stay declared for the
// view's sake; the live game takes the cover art's place.
export component Overlay inherits Window {
    // A focus target was tapped or clicked (ADR 0055): one callback for every target.
    callback activated(target: string, at: float, released: bool);
    // A rack moved by focus was dragged across `by` whole items (ADR 0055).
    callback dragged(region: string, by: int);
    // A tap or a drag came last, not a button: the focus highlight hides.
    in property <bool> touching;
    // Where logic's cursor is: a move ends a finger's scroll.
    in property <string> focus-key;
    // A finger scrolled a list (ADR 0055): the highlight hides too.
    // View-local: no message, no logic per frame.
    property <bool> scrolled-by-finger;
    function finger-scrolled() {
        if (!self.scrolled-by-finger) {
            self.scrolled-by-finger = true;
            Tokens.touching = true;
        }
    }
    // What ends a finger's scroll, in one place: for now the cursor moving,
    // or a button after a tap (logic's `touching` falling). The highlight
    // returns, and the lists bring the focused row back (Tokens.ring).
    function finger-done() {
        self.scrolled-by-finger = false;
        Tokens.touching = self.touching;
    }
    changed focus-key => {
        self.finger-done();
    }
    title: "Zone overlay";
    background: Tokens.ground-live;
    in property <string> look: "blend";
    in property <Screen> screen: Tokens.screen;
    in property <string> heading: "Paused";
    in property <bool> korri-heading;
    in property <bool> has-art;
    in property <image> art;
    in property <[Row]> rows;
    in property <int> focus-at;
    in property <Dialog> dialog;
    in property <Busy> busy;
    in property <Hints> hints;
    in property <Strip> strip;
    init => {
        Tokens.width = self.width;
        Tokens.height = self.height;
        Tokens.look = self.look;
        Tokens.ground = "paused";
        Tokens.screen = self.screen;
        Tokens.touching = self.touching;
    }
    changed touching => {
        if (self.touching) {
            Tokens.touching = true;
        } else {
            self.finger-done();
        }
    }
    changed screen => {
        Tokens.screen = self.screen;
    }
    changed width => {
        Tokens.width = self.width;
    }
    changed height => {
        Tokens.height = self.height;
    }
    changed look => {
        Tokens.look = self.look;
    }
    ZonePaused { scrolled => { root.finger-scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        heading: root.heading;
        korri-heading: root.korri-heading;
        rows: root.rows;
        focus-at: root.focus-at;
        dialog: root.dialog;
        busy: root.busy;
        hints: root.hints;
        strip: root.strip;
    }
}
