// ZoneSaveData: SAVE DATA, MANIA MODE's save select over identity: the save
// band (SWITCH BUNKER), and the bunker keyboard over the page.

import { Tokens } from "../ui/tokens.slint";
import { ZoneSaveBand } from "../ui/organisms/ZoneSaveBand.slint";
import { ZoneOptionsEntry } from "../ui/organisms/ZoneOptionsEntry.slint";
import { ZoneShell } from "../ui/templates/ZoneShell.slint";
import { Tab, Hints, Foot, SaveCard, Keyboard } from "../ui/types.slint";

export component ZoneSaveData {
    callback dragged(region: string, by: int);
    callback activated(target: string, at: float, released: bool);
    in property <[Tab]> tabs;
    in property <Hints> hints;
    in property <Foot> foot;
    in property <[SaveCard]> cards;
    in property <int> at;
    in property <bool> marked;
    in property <Keyboard> keyboard;
    property <length> a: Tokens.a;
    shell := ZoneShell { activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        tabs: root.tabs;
        hints: root.hints;
        foot: root.foot;
        ZoneSaveBand { dragged(region, by) => { root.dragged(region, by); }  activated(target, at, released) => { root.activated(target, at, released); } 
            x: 0;
            y: 4 * root.a;
            width: root.width;
            height: shell.body-h - 8 * root.a;
            cards: root.cards;
            at: root.at;
            marked: root.marked;
        }
    }
    if root.keyboard.shown: ZoneOptionsEntry { activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: Tokens.top-h;
        width: root.width;
        height: root.height - Tokens.top-h;
        board: root.keyboard;
    }
}
