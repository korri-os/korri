// Pico, Korri's fantasy-console surface, as a native surface package
// (docs/briefs/2026-10-31-native-surfaces-contract.md, section 3.1).
//
// The binding: the one file that knows the view. `Surface` draws the catalog
// and first-boot setup from logic.js `view()`; `Overlay` draws the pause menu
// over a running game from `overlay()`. Every component below it takes plain
// properties (ui/atoms … ui/templates, pages/). No callbacks and no keys:
// the shell delivers input to logic.js, which moves Pico's cursor.
//
// The window's size goes to the tokens (ui/tokens.slint), and every size
// follows from it: the layout is a function of width and height alone.

import { P8 } from "ui/palette.slint";
import { Tokens } from "ui/tokens.slint";
import { HintView } from "ui/atoms/PicoHint.slint";
import { ButtonView } from "ui/atoms/PicoRow.slint";
import { ChipView } from "ui/atoms/PicoBadge.slint";
import { BarView } from "ui/atoms/PicoDownloadBar.slint";
import { KeyView } from "ui/atoms/PicoKey.slint";
import { SegmentView } from "ui/atoms/PicoSegments.slint";
import { StepView } from "ui/atoms/PicoStepTrack.slint";
import { CartView } from "ui/molecules/PicoCart.slint";
import { CardView, LineView } from "ui/molecules/PicoNotice.slint";
import { RowView } from "ui/molecules/PicoSettingRow.slint";
import { InviteView } from "ui/molecules/PicoInviteRow.slint";
import { SetupView, PackView } from "ui/molecules/PicoSetupHeading.slint";
import { GridSectionView } from "ui/organisms/PicoCartGrid.slint";
import { ResumeView } from "ui/organisms/PicoResumeList.slint";
import { LaunchStageView } from "ui/organisms/PicoLaunchStage.slint";
import { DetailView } from "ui/organisms/PicoGameDetail.slint";
import { FindView, ResultView } from "ui/organisms/PicoLibraryBrowser.slint";
import { EditorView } from "ui/organisms/PicoTextEditor.slint";
import { IdentityView } from "ui/organisms/PicoIdentityDialog.slint";
import { StoreResultView } from "ui/organisms/PicoStoreResults.slint";
import { StoreEntryView } from "ui/organisms/PicoStoreEntry.slint";
import { SheetItem } from "ui/organisms/PicoPauseMenu.slint";
import { AttractView, PicoAttract } from "ui/organisms/PicoAttract.slint";
import { NoticeView, PicoInviteNotices } from "ui/organisms/PicoInviteNotices.slint";
import { FrameView } from "ui/templates/PicoScreenShell.slint";
import { SheetView } from "ui/templates/PicoGameOverlay.slint";
import { StripView, StripFact } from "ui/molecules/PicoStatusStrip.slint";
import { SplitView, PicoDisplays } from "ui/templates/PicoDisplays.slint";
import { HomeView, StageView, HeroView } from "ui/templates/PicoHomeLayout.slint";
import { PicoMenu } from "ui/organisms/PicoMenu.slint";
import { PicoHome } from "pages/PicoHome.slint";
import { PicoLibrary } from "pages/PicoLibrary.slint";
import { PicoGameDetail } from "pages/PicoGameDetail.slint";
import { PicoSettings } from "pages/PicoSettings.slint";
import { PicoLaunchSettings } from "pages/PicoLaunchSettings.slint";
import { PanelView } from "pages/PicoSettingsPanel.slint";
import { PicoStore, StoreView } from "pages/PicoStore.slint";
import { PicoOnboarding } from "pages/PicoOnboarding.slint";
import { PicoRunnerPicker } from "pages/PicoRunnerPicker.slint";
import { PicoOverlay } from "pages/PicoOverlay.slint";
import { PicoShowcase } from "pages/PicoShowcase.slint";

export {
    HintView, ButtonView, ChipView, BarView, KeyView, SegmentView, StepView, CartView, CardView, LineView, RowView,
    InviteView, SetupView, PackView, GridSectionView, ResumeView, LaunchStageView, DetailView, FindView, ResultView,
    EditorView, IdentityView, StoreResultView, StoreEntryView, SheetItem, AttractView, NoticeView, FrameView, SheetView, StripView, StripFact,
    SplitView, HomeView, StageView, HeroView, PanelView, StoreView,
}

export component Surface inherits Window {
    in property <string> font-family: "Pico Tiny5";
    in property <int> font-rows: 7;
    in property <string> layer: "catalog";
    in property <bool> covered;
    // Which page shows, and what it shows: "panel", "modal", "choice",
    // "editor", "identity", "store", "setup".
    in property <string> page: "home";
    in property <string> mode;
    in property <string> question;
    in property <FrameView> frame;
    in property <CardView> card;
    in property <HomeView> home;
    in property <FindView> find;
    in property <DetailView> detail;
    in property <PanelView> panel;
    in property <EditorView> editor;
    in property <IdentityView> identity;
    in property <StoreView> store;
    in property <SetupView> setup;
    in property <SheetView> sheet;
    in property <[NoticeView]> notices;
    in property <int> notice-round;
    in property <AttractView> attract;
    in property <SplitView> split;

    title: "Pico";
    background: P8.bg;
    default-font-family: font-family;
    preferred-width: Tokens.window-width;
    preferred-height: Tokens.window-height;

    init => {
        Tokens.fit(self.width, self.height);
        Tokens.rows = font-rows;
        Tokens.family = font-family;
    }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    changed font-rows => { Tokens.rows = font-rows; }
    changed font-family => { Tokens.family = font-family; }


    displays := PicoDisplays {
        split: split;
        Rectangle {
            x: displays.choose-x;
            y: displays.choose-y;
            width: displays.choose-w;
            height: displays.choose-h;
            clip: true;
            if page == "home" : PicoHome { frame: frame; home: home; card: card; }
            if page == "find" : PicoLibrary { frame: frame; find: find; }
            if page == "detail" : PicoGameDetail { frame: frame; detail: detail; card: card; question: question; }
            if page == "settings" : PicoSettings { frame: frame; panel: panel; card: card; editor: editor; identity: identity; mode: mode; }
            if page == "launch" : PicoLaunchSettings { frame: frame; panel: panel; card: card; editor: editor; identity: identity; mode: mode; }
            if page == "store" : PicoStore { frame: frame; store: store; card: card; editor: editor; mode: mode; }
            if page == "setup" : PicoOnboarding { frame: frame; setup: setup; editor: editor; identity: identity; mode: mode; }
            if page == "runner" : PicoRunnerPicker { sheet: sheet; }
            if attract.shown : PicoAttract { attract: attract; }
            if !split.on && notices.length > 0 : PicoInviteNotices { notices: notices; round: notice-round; }
        }
        if split.on : Rectangle {
            x: displays.show-x;
            y: displays.show-y;
            width: displays.show-w;
            height: displays.show-h;
            clip: true;
            PicoShowcase { home: home; }
            if attract.shown : PicoAttract { attract: attract; }
            if notices.length > 0 : PicoInviteNotices { notices: notices; round: notice-round; }
        }
    }
    // MENU's list at the window's top level, with no clipping ancestor: it
    // stands over the floor's MENU key in the choosing screen's rectangle
    // (the whole window, or its part of a split), in window coordinates.
    if page == "home" && home.menu-open : PicoMenu {
        x: displays.x + displays.choose-x + 2 * Tokens.u;
        y: displays.y + displays.choose-y + max(Tokens.u, displays.choose-h - Tokens.floor-band - self.height);
        room-width: displays.choose-w - 4 * Tokens.u;
        room-height: displays.choose-h - Tokens.floor-band - Tokens.u;
        entries: home.menu;
    }
}

export component Overlay inherits Window {
    in property <string> font-family: "Pico Tiny5";
    in property <int> font-rows: 7;
    in property <CardView> card;
    in property <SheetView> sheet;
    in property <StripView> strip;

    title: "Pico overlay";
    // See-through: the running game shows round the card (ADR 0053). A
    // window without alpha (the shell on Linux) shows black there instead.
    background: P8.see-through;
    default-font-family: font-family;
    preferred-width: Tokens.window-width;
    preferred-height: Tokens.window-height;

    init => {
        Tokens.fit(self.width, self.height);
        Tokens.rows = font-rows;
        Tokens.family = font-family;
    }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    changed font-rows => { Tokens.rows = font-rows; }

    PicoOverlay { sheet: sheet; card: card; strip: strip; }
}
