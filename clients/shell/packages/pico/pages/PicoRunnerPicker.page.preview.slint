// Preview states of PicoRunnerPicker, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoRunnerPicker.page.preview.slint
import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoRunnerPicker } from "PicoRunnerPicker.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoRunnerPicker {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        sheet: { kicker: "RUNTIMES", title: "Wario Land 4", items: [{ kind: "text", label: "Choose a runner on this device." }, { kind: "heading", label: "retroarch/mgba" }, { kind: "fact", label: "System", value: "gba" }, { kind: "fact", label: "Program", value: "/nix/store/retroarch" }, { kind: "row", label: "Launch once", focused: true, target: true }, { kind: "row", label: "Remember for this game" }], focused-item: 0, hints: [{ key: "a", label: "SELECT" }, { key: "b", label: "CANCEL" }] };
    }
}
