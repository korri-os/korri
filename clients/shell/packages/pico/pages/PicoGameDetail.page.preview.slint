import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoGameDetail } from "PicoGameDetail.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoGameDetail {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "LIBRARY", sep: true, label: "Hollow Knight", clock: "10:24", readout: "", hints: [{ key: "a", label: "PLAY" },{ key: "b", label: "BACK" }], has-lead: false, lead-kind: "menu", lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [] };
        detail: { stacked: Tokens.width < 256 * Tokens.p, cart: { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, title: "Hollow Knight", subtitle: "Switch · This device", chips: [{ text: "RESUME", kind: "ok" }, { text: "3", caption: "PLAYS", kind: "stat" }, { text: "2H 10M", caption: "PLAYED", kind: "stat" }], primary: { label: "CONTINUE", detail: "", focused: true, disabled: false, warn: false, lit: false }, bar: { shown: false }, actions: [{ label: "Verify files", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "Move to SD", detail: "No card inserted", focused: false, disabled: true, warn: false, lit: false }, { label: "Remove from device", detail: "", focused: false, disabled: false, warn: true, lit: false }] };
    }
}

