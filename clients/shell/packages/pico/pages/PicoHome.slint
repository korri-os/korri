import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { CardView } from "../ui/molecules/PicoNotice.slint";
import { PicoHomeLayout, HomeView } from "../ui/templates/PicoHomeLayout.slint";
import { PicoScreenShell, FrameView } from "../ui/templates/PicoScreenShell.slint";

// Home: the library in the screen shell. MENU's list is mounted at window
// level by main.slint, over every screen.
export component PicoHome inherits Rectangle {
    callback dragged(region: string, by: int);
    callback activated(target: string, at: float, released: bool);
    in property <FrameView> frame;
    in property <HomeView> home;
    in property <CardView> card;
    shell := PicoScreenShell { activated(target, at, released) => { root.activated(target, at, released); } 
        frame: frame;
        PicoHomeLayout { dragged(region, by) => { root.dragged(region, by); }  activated(target, at, released) => { root.activated(target, at, released); } 
            reveal(left, top, wide, tall) => { shell.show(left, top, wide, tall); }
            home: home;
            card: card;
            room: shell.body-h;
        }
    }
}
