// Preview states of PicoStore, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStore.page.preview.slint
import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoStore } from "PicoStore.slint";


export component Providers inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoStore {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "korri", sep: false, label: "GET GAMES", clock: "10:24", readout: "", hints: [{ key: "a", label: "OPEN" },{ key: "b", label: "BACK" }], has-lead: false, lead-kind: "menu", lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [] };
        store: { view: "providers", message: "Pick where to look for a game.", providers: [{ label: "PICO-8 BBS", detail: "▶", focused: true, disabled: false, warn: false, lit: false }], search: { label: "SEARCH", detail: "TYPE A NAME", focused: false, disabled: false, warn: false, lit: false }, search-note: "", results: [{ cart: { id: "cc", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 8, sticker: 1, sticker-ink-light: false, progress: "played", hero: true, focused: true }, title: "Celeste Classic 2", subtitle: "PICO-8" }], focused-result: 0, entry: { cart: { id: "cc", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 8, sticker: 1, sticker-ink-light: false, progress: "new", hero: false, focused: false }, title: "Celeste Classic 2", subtitle: "PICO-8 · PICO-8 BBS", chips: [{ text: "NOT ON THIS DEVICE", kind: "empty" }], description: "Madeline climbs again, with a grappling hook this time.", has-primary: true, primary: { label: "GET", detail: "", focused: true, disabled: false, warn: false, lit: false } } };
    }
}

