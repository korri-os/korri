import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoPauseMenu } from "../ui/organisms/PicoPauseMenu.slint";
import { PicoGameOverlay, SheetView } from "../ui/templates/PicoGameOverlay.slint";

// RUNTIMES: the runners this device has for a game, their facts, and
// Korri's actions, over the catalog.
export component PicoRunnerPicker inherits Rectangle {
    callback scrolled();
    callback activated(target: string, at: float, released: bool);
    in property <SheetView> sheet;
    overlay := PicoGameOverlay { scrolled => { root.scrolled(); }  activated(target, at, released) => { root.activated(target, at, released); } 
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        kicker: sheet.kicker;
        title: sheet.title;
        hints: sheet.hints;
        PicoPauseMenu { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { overlay.show(left, top, wide, tall); }  items: sheet.items; }
    }
}
