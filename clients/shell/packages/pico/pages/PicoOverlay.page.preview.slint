// Preview states of PicoOverlay, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoOverlay.page.preview.slint
import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoOverlay } from "PicoOverlay.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        sheet: { kicker: "PAUSED", title: "Hollow Knight", items: [{ kind: "row", label: "Continue playing", focused: true, target: true }, { kind: "row", label: "Quit game", warn: true }, { kind: "note", label: "Unsaved progress is lost." }, { kind: "section", label: "MGBA" }, { kind: "row", label: "Save state" }, { kind: "row", label: "Load state", disabled: true }, { kind: "note", label: "No save yet" }, { kind: "row", label: "Fast forward", value: "OFF", arrows: true }, { kind: "row", label: "Shader", value: "NONE", arrows: true }, { kind: "row", label: "Volume", value: "80", range: true, cells: 8 }], focused-item: 0, hints: [{ key: "a", label: "SELECT" }, { key: "b", label: "RESUME" }] };
        strip: { shown: true, device: [{ value: "3:42 PM", known: true, battery: -2 }, { value: "82%", known: true, battery: 4 }], stream: [{ before: "RTT", value: "3", after: "ms", known: true, battery: -2 }, { value: "20.1", after: "Mb/s", known: true, battery: -2 }, { value: "0", after: "DROPPED", known: true, battery: -2 }] };
    }
}

export component ConfirmQuit inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        card: { shown: true, tone: "warn", kicker: "ARE YOU SURE?", title: "QUIT GAME?", message: "Unsaved progress is lost.", lines: [], actions: [{ label: "QUIT GAME", detail: "", focused: false, disabled: false, warn: true, lit: false },{ label: "CANCEL", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }], inline: false };
        strip: { shown: true, device: [{ value: "3:42 PM", known: true, battery: -2 }, { value: "82%", known: true, battery: 4 }], stream: [{ before: "RTT", value: "3", after: "ms", known: true, battery: -2 }, { value: "20.1", after: "Mb/s", known: true, battery: -2 }, { value: "0", after: "DROPPED", known: true, battery: -2 }] };
    }
}

// Nothing Korri knows: no title, no clock, no battery, no stream sample.
export component Unknown inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        sheet: { kicker: "PAUSED", title: "--", items: [{ kind: "row", label: "Resume", focused: true, target: true }, { kind: "row", label: "End", warn: true }, { kind: "section", label: "STREAM CONTROLS" }, { kind: "row", label: "Crop to fill", value: "OFF", arrows: true }, { kind: "row", label: "Mouse mode", value: "TRACK PAD(NATURAL/DOUBLE TAP TO DRAG)", arrows: true }, { kind: "row", label: "SGSR sharpness", value: "20", range: true, cells: 4 }], focused-item: 0, hints: [{ key: "a", label: "SELECT" }, { key: "b", label: "RESUME" }] };
        strip: { shown: true, device: [{ value: "--:--", known: false, battery: -2 }, { value: "--", known: false, battery: -1 }], stream: [{ before: "RTT", value: "--", after: "ms", known: false, battery: -2 }, { value: "--", after: "Mb/s", known: false, battery: -2 }, { value: "--", after: "DROPPED", known: false, battery: -2 }] };
    }
}
