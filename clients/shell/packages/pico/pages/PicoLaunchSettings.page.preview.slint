// Preview states of PicoLaunchSettings, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoLaunchSettings.page.preview.slint
import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoLaunchSettings } from "PicoLaunchSettings.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoLaunchSettings {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "Wario Land 4", sep: false, label: "LAUNCH SETTINGS", clock: "10:24", readout: "", hints: [{ key: "a", label: "SELECT" }, { key: "b", label: "BACK" }], has-lead: true, lead-kind: "plain", lead: { label: "RELOAD", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [] };
        panel: { spines: [{ label: "DEVICE", detail: "", focused: false, disabled: false, warn: false, lit: true }, { label: "SYSTEM GBA", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "GAME", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "PROFILE BATTERY SAVER", detail: "", focused: false, disabled: false, warn: false, lit: false }], spine-tone: 0, beside: Tokens.width / Tokens.p >= 400, rows: [{ section: "RUNNER", label: "Runner", value: "", description: "The most specific place that names an installed runner wins.", source: "mGBA from Game", device-only: false, kind: "cycle", focused: true, target: true, warn: false, state: "idle", state-text: "", segments: [{ label: "INHERIT", on: true }, { label: "MGBA" }, { label: "GPSP" }], bars: 0, locked: false }, { section: "CPU", label: "CPU min", value: "Inherit", description: "Applies at next launch.", source: "33 % (0.60 GHz) from Device", device-only: true, kind: "step", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }, { section: "", label: "CPU max", value: "Inherit", description: "", source: "", device-only: false, kind: "step", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }], focused-row: 0, scopes: [{ label: "ANY RUNNER", detail: "", focused: false, disabled: false, warn: false, lit: true },{ label: "FAMILY RETROARCH", detail: "", focused: false, disabled: false, warn: false, lit: false },{ label: "MGBA", detail: "", focused: false, disabled: false, warn: false, lit: false }], notes: [], message: "" };
    }
}
