// Preview states of PicoOnboarding, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoOnboarding.page.preview.slint
import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoOnboarding } from "PicoOnboarding.slint";


export component Hello inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoOnboarding {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "SETUP", sep: false, label: "HELLO", clock: "10:24", readout: "", hints: [{ key: "a", label: "START" }], has-lead: false, lead-kind: "menu", lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [{ state: "now" }, { state: "next" }, { state: "next" }, { state: "next" }, { state: "next" }, { state: "next" }, { state: "next" }] };
        setup: { step: "hello", layout: "hello", tone: "ask", title: "Hello.", message: "Let's get this console ready to play. Have your Wi-Fi password handy.", busy: "", rows: [], carts: [], more: "", answers: [], inline: false, go: { label: "START", detail: "", focused: true, disabled: false, warn: false, lit: false }, has-go: true, pack: { shown: false } };
    }
}

