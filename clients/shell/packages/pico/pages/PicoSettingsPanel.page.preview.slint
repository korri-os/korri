// Preview states of PicoSettingsPanel, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSettingsPanel.page.preview.slint
import { P8 } from "../ui/palette.slint";
import { Tokens } from "../ui/tokens.slint";
import { PicoSettingsPanel } from "PicoSettingsPanel.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoSettingsPanel {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        panel: { spines: [{ label: "DEVICE", detail: "", focused: false, disabled: false, warn: false, lit: true }, { label: "PLUGINS", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "GAMES", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "PICO", detail: "", focused: false, disabled: false, warn: false, lit: false }], spine-tone: 0, beside: Tokens.width / Tokens.p >= 400, rows: [{ section: "", label: "Name", value: "usu", description: "", source: "", device-only: false, kind: "text", focused: true, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }, { section: "", label: "Software", value: "korrid 0.4.1", description: "", source: "", device-only: false, kind: "fact", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }, { section: "", label: "Wi-Fi", value: "Home-5G", description: "Join a network.", source: "", device-only: false, kind: "action", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }], focused-row: 0, scopes: [], notes: [], message: "" };
    }
}

