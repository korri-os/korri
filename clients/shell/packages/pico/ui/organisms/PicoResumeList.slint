import { P8 } from "../palette.slint";
import { Tokens, Cycle } from "../tokens.slint";
import { PicoLine } from "../atoms/PicoLine.slint";
import { PicoCart, CartView } from "../molecules/PicoCart.slint";

export struct ResumeView { cart: CartView, title: string, subtitle: string }

// The games with a save waiting, each a cart with its title and system.
export component PicoResumeList inherits VerticalLayout {
    callback reveal(left: length, top: length, wide: length, tall: length);
    alignment: start;
    in property <[ResumeView]> games;
    spacing: 2 * Tokens.p;
    PicoLine { text: "RESUME"; color: P8.ink-quiet; }
    HorizontalLayout {
        alignment: start;
        spacing: 6 * Tokens.p;
        // The cart, its shadow and its target read the row through the list
        // by index: after the shell updates a row in place, the row's own
        // copy can lag a render (seen when the probe reads elements between
        // renders), which left the cursor's shadow and scroll behind.
        for game[i] in games : VerticalLayout {
            width: 44 * Tokens.p;
            alignment: start;
            spacing: Tokens.p;
            Rectangle {
                height: 40 * Tokens.p;
                accessible-role: AccessibleRole.list-item;
                accessible-label: game.cart.title;
                accessible-item-selectable: true;
                accessible-item-selected: root.games[i].cart.target && root.games[i].cart.focused;
                // Always present, shown by the row's data: a row updates in place.
                Rectangle { visible: root.games[i].cart.target && root.games[i].cart.focused; x: shell.x + 3 * Tokens.p; y: shell.y + 3 * Tokens.p; width: shell.width; height: shell.height; background: Cycle.now; }
                shell := PicoCart { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  x: 0; y: parent.height - self.shell-h - 2 * Tokens.p; cart: root.games[i].cart; box-w: 20 * Tokens.p; box-h: 28 * Tokens.p; }
                Rectangle { x: 0; y: parent.height - 2 * Tokens.p; width: parent.width; height: 2 * Tokens.p; background: P8.floor; }
            }
            Text { text: game.title; font-size: Tokens.sm; color: P8.ink; wrap: word-wrap; }
            PicoLine { text: game.subtitle; color: P8.ink-quiet; }
        }
    }
}
