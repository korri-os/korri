// Preview states of PicoGameDetail, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoGameDetail.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoGameDetail } from "PicoGameDetail.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoGameDetail { height: 180 * Tokens.p; detail: { stacked: Tokens.width < 256 * Tokens.p, cart: { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, title: "Hollow Knight", subtitle: "Switch · This device", chips: [{ text: "RESUME", kind: "ok" }, { text: "3", caption: "PLAYS", kind: "stat" }], primary: { label: "CONTINUE", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }, bar: { shown: false }, actions: [{ label: "Verify files", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "Remove from device", detail: "", focused: false, disabled: false, warn: true, lit: false }] }; }
    }
}
