import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoLine } from "../atoms/PicoLine.slint";
import { PicoRow, ButtonView } from "../atoms/PicoRow.slint";

// Where to look for a game: Korri's providers, one row each.
export component PicoStoreProviders inherits VerticalLayout {
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <string> message;
    in property <[ButtonView]> providers;
    spacing: 4 * Tokens.p;
    alignment: start;
    if message != "" : PicoLine { text: message; font-size: Tokens.md; color: P8.ink-dim; }
    for provider in providers : HorizontalLayout {
        alignment: start;
        PicoRow { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  width: min(280 * Tokens.p, root.width); button: provider; kind: "card"; }
    }
}
