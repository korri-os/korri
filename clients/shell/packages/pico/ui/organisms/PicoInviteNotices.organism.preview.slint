// Preview states of PicoInviteNotices, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoInviteNotices.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoInviteNotices } from "PicoInviteNotices.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoInviteNotices { height: 200 * Tokens.p; notices: [{ playing: "Simon is playing", game: "Turtles in Time", where: "on Odin 2 Portal" }, { playing: "Ana is playing", game: "Comet Courier", where: "on Living room" }]; }
    }
}
