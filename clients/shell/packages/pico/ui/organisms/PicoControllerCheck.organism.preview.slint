// Preview states of PicoControllerCheck, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoControllerCheck.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoControllerCheck } from "PicoControllerCheck.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoControllerCheck { height: 200 * Tokens.p; setup: { step: "pads", layout: "card", tone: "ask", title: "1 controller ready", message: "Press a button on each controller you will play with.", busy: "", rows: [{ section: "", label: "Built-in controls", value: "READY", description: "", source: "", device-only: false, kind: "fact", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false },{ section: "", label: "8BitDo Pro 2", value: "Press any button", description: "", source: "", device-only: false, kind: "fact", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }], carts: [], more: "", answers: [{ label: "NEXT", detail: "", focused: true, disabled: false, warn: false, lit: false }], inline: false, go: { label: "", detail: "", focused: false, disabled: false, warn: false, lit: false }, has-go: false, pack: { } }; }
    }
}
