// Preview states of PicoChoicePicker, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoChoicePicker.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoChoicePicker } from "PicoChoicePicker.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoChoicePicker { height: 180 * Tokens.p; choices: { shown: true, tone: "ask", kicker: "", title: "Add setting", message: "1 more setting mGBA offers here.", lines: [], actions: [{ label: "FPS limit", detail: "", focused: true, disabled: false, warn: false, lit: false },{ label: "CANCEL", detail: "", focused: false, disabled: false, warn: false, lit: false }], inline: false }; }
    }
}
