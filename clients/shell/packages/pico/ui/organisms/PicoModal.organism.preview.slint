// Preview states of PicoModal, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoModal.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoModal } from "PicoModal.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoModal { height: 180 * Tokens.p; card: { shown: true, tone: "warn", kicker: "COULD NOT START", title: "Tetris", message: "No installed runner can play this game.", lines: [], actions: [{ label: "OK", detail: "", focused: true, disabled: false, warn: false, lit: false }], inline: false }; }
    }
}
