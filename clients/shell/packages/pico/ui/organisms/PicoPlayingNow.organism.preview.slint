// Preview states of PicoPlayingNow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoPlayingNow.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPlayingNow } from "PicoPlayingNow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoPlayingNow { count: "2 GAMES"; invites: [{ title: "Turtles in Time", who: "Simon is playing on Odin 2 Portal", actions: [{ label: "Play on stream", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }, { label: "Dismiss", detail: "", focused: false, disabled: false, warn: false, lit: false }] }, { title: "Comet Courier", who: "Ana is playing on Living room", actions: [{ label: "Play on stream", detail: "", focused: false, disabled: false, warn: false, lit: false }] }]; }
    }
}
