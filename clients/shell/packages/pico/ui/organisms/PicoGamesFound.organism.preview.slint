// Preview states of PicoGamesFound, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoGamesFound.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoGamesFound } from "PicoGamesFound.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoGamesFound { height: 220 * Tokens.p; setup: { step: "games", layout: "card", tone: "ask", title: "9 games found", message: "Korri found 9 games to play.", busy: "", rows: [], carts: [{ id: "celeste", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 4, sticker: 7, sticker-ink-light: false, progress: "new", hero: true, focused: false },{ id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false },{ id: "tetris", title: "Tetris", has-art: false, art-ratio: 1, initials: "T", system: "gb", shell: 7, sticker: 0, sticker-ink-light: false, progress: "played", hero: false, focused: false }], more: "+6 more", answers: [{ label: "NEXT", detail: "", focused: true, disabled: false, warn: false, lit: false }], inline: false, go: { label: "", detail: "", focused: false, disabled: false, warn: false, lit: false }, has-go: false, pack: { shown: true, tone: "ask", title: "Starter pack", message: "Free games and the programs to play them.", answers: [{ label: "Install", detail: "", focused: false, disabled: false, warn: false, lit: false }] } }; }
    }
}
