import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoBusyMeter } from "../atoms/PicoBusyMeter.slint";
import { PicoRow } from "../atoms/PicoRow.slint";
import { PicoCard } from "../molecules/PicoCard.slint";
import { PicoSetupHeading, SetupView } from "../molecules/PicoSetupHeading.slint";
import { PicoNetworkRow } from "../molecules/PicoNetworkRow.slint";

// Setup's Wi-Fi step: the networks Korri found, or where joining stands, in
// setup's words, and what to do next.
export component PicoWifiSetup {
    in property <SetupView> setup;
    preferred-height: card.preferred-height + 5 * Tokens.p;
    min-height: self.preferred-height;
    card := PicoCard {
        x: 0;
        y: 0;
        width: root.width - 5 * Tokens.p;
        height: max(self.min-height, self.preferred-height);
        tone: setup.tone;
        PicoSetupHeading { title: setup.title; message: setup.message; ink: P8.shell-ink(setup.tone); }
        if setup.busy != "" : PicoBusyMeter { label: setup.busy; ink: P8.note(setup.tone); }
        for network in setup.rows : PicoNetworkRow {
            ssid: network.label;
            bars: network.bars;
            locked: network.locked;
            connected: network.value == "CONNECTED";
            focused: network.focused;
        }
        if setup.inline : HorizontalLayout { spacing: 2 * Tokens.p; for a in setup.answers : PicoRow { button: a; kind: "card"; } }
        if !setup.inline : VerticalLayout { spacing: 2 * Tokens.p; for a in setup.answers : PicoRow { button: a; kind: "card"; } }
    }
}
