// Preview states of PicoGameActions, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoGameActions.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoGameActions } from "PicoGameActions.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoGameActions { actions: [{ label: "Verify files", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }, { label: "Move to SD", detail: "No card inserted", focused: false, disabled: true, warn: false, lit: false }, { label: "Remove from device", detail: "", focused: false, disabled: false, warn: true, lit: false }]; }
    }
}
