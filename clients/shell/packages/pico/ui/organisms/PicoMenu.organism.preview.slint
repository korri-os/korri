// Preview states of PicoMenu, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoMenu.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoMenu } from "PicoMenu.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoMenu { entries: [{ label: "FIND", detail: "", focused: true, disabled: false, warn: false, lit: false }, { label: "SETTINGS", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "VIEW", detail: "◀ SHELF ▶", focused: false, disabled: false, warn: false, lit: false }]; }
    }
}
