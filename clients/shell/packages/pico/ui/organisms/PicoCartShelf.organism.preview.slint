// Preview states of PicoCartShelf, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoCartShelf.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoCartShelf } from "PicoCartShelf.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoCartShelf { carts: [{ id: "celeste", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 4, sticker: 7, sticker-ink-light: false, progress: "new", hero: true, focused: false },{ id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false },{ id: "tetris", title: "Tetris", has-art: false, art-ratio: 1, initials: "T", system: "gb", shell: 7, sticker: 0, sticker-ink-light: false, progress: "played", hero: false, focused: false },{ id: "spelunky", title: "Spelunky", has-art: false, art-ratio: 1, initials: "S", system: "nes", shell: 6, sticker: 9, sticker-ink-light: false, progress: "new", hero: false, focused: false },{ id: "lantern", title: "Lantern Keep", has-art: false, art-ratio: 1, initials: "LK", system: "gba", shell: 7, sticker: 0, sticker-ink-light: false, progress: "new", hero: false, focused: false },{ id: "tide", title: "Tide Pool", has-art: false, art-ratio: 1, initials: "TP", system: "md", shell: 5, sticker: 8, sticker-ink-light: false, progress: "new", hero: false, focused: false },{ id: "comet", title: "Comet Courier", has-art: false, art-ratio: 1, initials: "CC", system: "other", shell: 7, sticker: 0, sticker-ink-light: false, progress: "resume", hero: false, focused: false },{ id: "bramble", title: "Bramble", has-art: false, art-ratio: 1, initials: "B", system: "gbc", shell: 0, sticker: 3, sticker-ink-light: false, progress: "new", hero: false, focused: false },{ id: "petal", title: "Petal Quest", has-art: false, art-ratio: 1, initials: "PQ", system: "pico8", shell: 1, sticker: 4, sticker-ink-light: false, progress: "new", hero: false, focused: false }]; total: 9; selected-index: 0; }
    }
}

export component Empty inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoCartShelf { carts: []; total: 0; }
    }
}
