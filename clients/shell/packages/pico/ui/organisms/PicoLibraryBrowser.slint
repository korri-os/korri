import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoLine } from "../atoms/PicoLine.slint";
import { PicoChip } from "../atoms/PicoChip.slint";
import { PicoRail } from "../atoms/PicoRail.slint";
import { ButtonView } from "../atoms/PicoRow.slint";
import { KeyView } from "../atoms/PicoKey.slint";
import { PicoQueryField } from "../molecules/PicoQueryField.slint";
import { PicoKeyboard } from "../molecules/PicoKeyboard.slint";
import { PicoResultRow } from "../molecules/PicoResultRow.slint";
import { CartView } from "../molecules/PicoCart.slint";

export struct ResultView { cart: CartView, title: string }

export struct FindView {
    query: string,
    sections: [ButtonView],
    orders: [ButtonView],
    keys: [KeyView],
    key-rows: int,
    // The results the rack can show: results[0] is the first-result'th of
    // the result-count games found (logic.js sends no more).
    results: [ResultView],
    first-result: int,
    result-count: int,
    focused-result: int,
    empty: bool,
    count: string,
}

// Find: what is typed, the collections, the orders, the keys, and the games
// Korri found, in a rack that keeps the cursor's game in view. Chips that do
// not fit a row scroll with the cursor.
export component PicoLibraryBrowser inherits VerticalLayout {
    callback activated(target: string, at: float, released: bool);
    callback reveal(left: length, top: length, wide: length, tall: length);
    alignment: start;
    in property <FindView> find;
    property <length> slot-w: 54 * Tokens.p;
    spacing: 3 * Tokens.p;
    PicoQueryField { query: find.query; }
    sections := PicoRail { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  for b in find.sections : PicoChip { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { sections.show(left, top, wide, tall); }  button: b; } }
    orders := PicoRail { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  for b in find.orders : PicoChip { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { orders.show(left, top, wide, tall); }  button: b; } }
    PicoKeyboard { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  keys: find.keys; rows: find.key-rows; }
    if find.empty : VerticalLayout {
        PicoLine { text: "NOTHING MATCHES"; color: P8.go; }
        PicoLine { text: "Try fewer letters, or a different collection."; color: P8.ink-dim; }
    }
    if !find.empty : Rectangle {
        min-height: 54 * Tokens.p;
        clip: true;
        property <length> scroll: max(0, min(find.result-count * slot-w - self.width, find.focused-result * slot-w - self.width / 2 + slot-w / 2));
        for result[i] in find.results : PicoResultRow { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); } 
            x: (find.first-result + i) * slot-w - parent.scroll;
            y: 0;
            width: slot-w - 4 * Tokens.p;
            height: parent.height;
            cart: result.cart;
            title: result.title;
            cart-h: 30 * Tokens.p;
        }
    }
}
