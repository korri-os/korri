// Preview states of PicoWifiSetup, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoWifiSetup.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoWifiSetup } from "PicoWifiSetup.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoWifiSetup { height: 200 * Tokens.p; setup: { step: "wifi", layout: "card", tone: "ask", title: "Pick a network", message: "Setup needs a connection to go on.", busy: "", rows: [{ section: "", label: "Home-5G", value: "", description: "", source: "", device-only: false, kind: "network", focused: true, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 4, locked: true },{ section: "", label: "Corner Cafe Free", value: "", description: "", source: "", device-only: false, kind: "network", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 2, locked: false }], carts: [], more: "", answers: [{ label: "Hidden network", detail: "", focused: false, disabled: false, warn: false, lit: false },{ label: "Scan again", detail: "", focused: false, disabled: false, warn: false, lit: false }], inline: true, go: { label: "", detail: "", focused: false, disabled: false, warn: false, lit: false }, has-go: false, pack: { } }; }
    }
}
