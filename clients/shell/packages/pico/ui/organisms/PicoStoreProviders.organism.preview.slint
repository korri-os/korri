// Preview states of PicoStoreProviders, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStoreProviders.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStoreProviders } from "PicoStoreProviders.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoStoreProviders { message: "Pick where to look for a game."; providers: [{ label: "PICO-8 BBS", detail: "▶", focused: true, target: true, disabled: false, warn: false, lit: false }]; }
    }
}
