import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPara } from "../atoms/PicoPara.slint";
import { PicoRow, ButtonView } from "../atoms/PicoRow.slint";

export struct IdentityView {
    title: string,
    problem: string,
    note: string,
    qr: string,
    qr-size: int,
    secret: string,
    rows: [ButtonView],
}

// The identity dialog: Korri's problem, the warning, a backup's QR code and
// text, and the form: fields that open the keyboard, the records choice, the
// statement to tick, and the answer.
export component PicoIdentityDialog inherits HorizontalLayout {
    callback activated(target: string, at: float, released: bool);
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <IdentityView> identity;
    property <length> qr-side: identity.qr == "" ? 0 : min(150 * Tokens.p, 40 * Tokens.u);
    spacing: Tokens.u;
    if identity.qr != "" : VerticalLayout {
        alignment: start;
        Rectangle {
            width: qr-side + 8 * Tokens.p;
            height: qr-side + 8 * Tokens.p;
            background: P8.white;
            Path {
                x: 4 * Tokens.p;
                y: 4 * Tokens.p;
                width: qr-side;
                height: qr-side;
                viewbox-width: identity.qr-size;
                viewbox-height: identity.qr-size;
                commands: identity.qr;
                fill: P8.black;
            }
        }
    }
    VerticalLayout {
        spacing: 3 * Tokens.p;
        alignment: start;
        if identity.problem != "" : PicoPara { text: identity.problem; font-size: Tokens.sm; color: P8.warn; }
        if identity.note != "" : PicoPara { text: identity.note; font-size: Tokens.sm; color: P8.ink-dim; }
        if identity.secret != "" : PicoPara { text: identity.secret; font-size: Tokens.sm; color: P8.peach; }
        for row in identity.rows : PicoRow { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  button: row; }
    }
}
