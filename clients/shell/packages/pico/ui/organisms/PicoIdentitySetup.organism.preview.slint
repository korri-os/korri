// Preview states of PicoIdentitySetup, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoIdentitySetup.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoIdentitySetup } from "PicoIdentitySetup.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoIdentitySetup { height: 200 * Tokens.p; setup: { step: "you", layout: "card", tone: "ask", title: "Who are you?", message: "Your identity is the key that ties your Korri devices together.", busy: "", rows: [], carts: [], more: "", answers: [{ label: "New identity", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false },{ label: "Restore from backup", detail: "", focused: false, disabled: false, warn: false, lit: false },{ label: "Connect a signer", detail: "", focused: false, disabled: false, warn: false, lit: false }], inline: false, go: { label: "", detail: "", focused: false, disabled: false, warn: false, lit: false }, has-go: false, pack: { } }; }
    }
}
