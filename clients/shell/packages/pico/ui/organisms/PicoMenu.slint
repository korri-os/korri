import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoRow, ButtonView } from "../atoms/PicoRow.slint";

// MENU's list, standing on the floor over the MENU key: FIND, GET GAMES,
// SETTINGS and VIEW.
export component PicoMenu inherits Rectangle {
    in property <[ButtonView]> entries;
    width: min(110 * Tokens.p, 60 * Tokens.u);
    height: list.preferred-height;
    Rectangle { x: 3 * Tokens.p; y: 3 * Tokens.p; width: root.width; height: root.height; background: P8.cast-near; }
    Rectangle { background: P8.shell-tell; }
    list := VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        padding: 4 * Tokens.p;
        padding-right: 7 * Tokens.p;
        spacing: 3 * Tokens.p;
        for entry in entries : PicoRow { button: entry; kind: "card"; }
    }
}
