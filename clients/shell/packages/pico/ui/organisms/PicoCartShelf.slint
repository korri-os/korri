import { P8 } from "../palette.slint";
import { Tokens, Cycle } from "../tokens.slint";
import { PicoTap } from "../atoms/PicoTap.slint";
import { PicoCart, CartView } from "../molecules/PicoCart.slint";

// Every game a small cartridge on one floor. Every slot is as tall as the
// tallest cart (the narrowest art); the chosen cart is lifted with a hard
// shadow that cycles under the cursor. The rack scrolls only as far as it
// must to keep the chosen cart in view, with one cart of margin each side.
export component PicoCartShelf inherits Rectangle {
    callback activated(target: string, at: float, released: bool);
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <[CartView]> carts;
    in property <int> first-index;
    in property <int> total;
    in property <int> selected-index;
    in property <float> narrowest-art: 1;
    // A short body packs smaller carts.
    in property <bool> small: Tokens.short;
    property <length> art-w: small ? 20 * Tokens.p : 28 * Tokens.p;
    property <length> art-h: small ? 36 * Tokens.p : 56 * Tokens.p;
    property <length> gap: small ? 3 * Tokens.p : 4 * Tokens.p;
    property <length> tallest: narrowest-art <= 0 ? art-h : min(art-h, art-w / narrowest-art);
    property <length> slot-h: 4 * Tokens.p + tallest + 6 * Tokens.p + Tokens.p;
    property <length> slot-w: art-w + 6 * Tokens.p + 3 * Tokens.p;
    property <length> pitch: slot-w + gap;
    out property <length> rack-h: 8 * Tokens.p + slot-h + Tokens.u + 3 * Tokens.p;
    property <int> place: first-index + selected-index;
    property <length> content-w: total * slot-w + max(0, total - 1) * gap;
    property <length> want: pitch * place;
    property <length> scroll: max(0, min(content-w - root.width, max(want + 2 * slot-w - root.width, min(held, want - slot-w))));
    property <length> held: 0;
    changed scroll => { held = scroll; }
    height: rack-h;
    clip: true;
    Rectangle {
        x: -scroll;
        y: 0;
        width: content-w;
        height: rack-h - 3 * Tokens.p;
        for cart[index] in carts : Rectangle {
            x: (first-index + index) * pitch;
            y: 8 * Tokens.p + slot-h - Tokens.p - shell.shell-h - (cart.hero ? 4 * Tokens.p : 0);
            width: shell.shell-w;
            height: shell.shell-h;
            // Always present, shown by the row's data: a row updates in place.
            Rectangle { visible: cart.hero || ((cart.target && cart.focused) && Tokens.ring); x: 3 * Tokens.p; y: 3 * Tokens.p; width: parent.width; height: parent.height; background: (cart.target && cart.focused) && Tokens.ring ? Cycle.now : P8.ink; }
            // The slot, level across the shelf: the focus target.
            Rectangle {
                x: 0;
                y: 8 * Tokens.p - parent.y;
                width: parent.width;
                height: slot-h;
                accessible-role: AccessibleRole.list-item;
                accessible-label: cart.title;
                accessible-item-selectable: true;
                accessible-item-selected: (cart.target && cart.focused);
            }
            // Over the cart and its slot: a tap on either is a tap on the cart.
            PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: min(0, 8 * Tokens.p - parent.y); width: parent.width; height: max(parent.height, 8 * Tokens.p - parent.y + slot-h) - self.y; target: cart.target ? cart.focus-id : ""; }
            shell := PicoCart { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  x: 0; y: 0; cart: cart; box-w: art-w; box-h: art-h; }
        }
    }
    Rectangle { x: 0; y: rack-h - 3 * Tokens.p; width: root.width; height: 3 * Tokens.p; background: P8.floor; }
}
