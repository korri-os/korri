import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoNotice, CardView } from "../molecules/PicoNotice.slint";

// A question over the screen: the screen under it goes solid and the card
// stands in its middle; a report too long for the box scrolls with the cursor.
export component PicoModal inherits Rectangle {
    in property <CardView> card;
    background: P8.bg;
    property <length> w: min(root.width - 5 * Tokens.p, max(200 * Tokens.p, root.width * 70%));
    preferred-height: notice.preferred-height + 5 * Tokens.p;
    min-height: self.preferred-height;
    notice := PicoNotice {
        x: Tokens.snap((root.width - w) / 2);
        y: Tokens.snap(max(0, (root.height - self.preferred-height) / 2));
        width: w;
        height: max(self.min-height, self.preferred-height);
        card: card;
    }
}
