import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoTap } from "../atoms/PicoTap.slint";
import { PicoSlide } from "../atoms/PicoSlide.slint";
import { PicoLine } from "../atoms/PicoLine.slint";
import { PicoRow, ButtonView } from "../atoms/PicoRow.slint";
import { CartView } from "../molecules/PicoCart.slint";
import { PicoResultRow } from "../molecules/PicoResultRow.slint";
import { PicoNotice, CardView } from "../molecules/PicoNotice.slint";

export struct StoreResultView { cart: CartView, title: string, subtitle: string }

// One provider's search: the SEARCH row with what was typed, and the games
// it found as carts with their titles; or Korri's words when it failed.
export component PicoStoreResults inherits VerticalLayout {
    callback dragged(region: string, by: int);
    callback activated(target: string, at: float, released: bool);
    callback reveal(left: length, top: length, wide: length, tall: length);
    alignment: start;
    in property <ButtonView> search;
    in property <string> note;
    in property <[StoreResultView]> results;
    in property <int> focused-result;
    in property <CardView> problem;
    property <length> slot-w: 54 * Tokens.p;
    spacing: 4 * Tokens.p;
    HorizontalLayout { alignment: start; PicoRow { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  width: min(280 * Tokens.p, root.width); button: search; } }
    if note != "" : PicoLine { text: note; color: P8.ink-dim; }
    if problem.shown : PicoNotice { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  card: problem; }
    if results.length > 0 : Rectangle {
        min-height: 60 * Tokens.p;
        clip: true;
        property <length> scroll: max(0, min(results.length * slot-w - self.width, focused-result * slot-w - self.width / 2 + slot-w / 2));
        // A sideways drag slides the results a game at a time; focus follows (ADR 0055).
        slide := PicoSlide { dragged(region, by) => { root.dragged(region, by); }  region: "results"; pitch: root.slot-w; rest: parent.scroll; first: root.focused-result <= 0; last: root.focused-result >= root.results.length - 1; }
        PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  slides: true;  slide(dx) => { slide.move(dx); }  slid => { slide.release(); }  x: 0; y: 0; width: parent.width; height: parent.height; }
        for result[i] in results : PicoResultRow {  slide(dx) => { slide.move(dx); }  slid => { slide.release(); }  activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); } 
            x: i * slot-w - parent.scroll + slide.offset;
            y: 0;
            width: slot-w - 4 * Tokens.p;
            height: parent.height;
            cart: result.cart;
            title: result.title;
            subtitle: result.subtitle;
        }
    }
}
