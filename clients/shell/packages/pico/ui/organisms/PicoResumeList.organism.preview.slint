// Preview states of PicoResumeList, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoResumeList.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoResumeList } from "PicoResumeList.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoResumeList { games: [{ cart: { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, title: "Hollow Knight", subtitle: "Switch" }, { cart: { id: "comet", title: "Comet Courier", has-art: false, art-ratio: 1, initials: "CC", system: "other", shell: 7, sticker: 0, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, title: "Comet Courier", subtitle: "PC" }]; }
    }
}
