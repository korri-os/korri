// Preview states of PicoAttract, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoAttract.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoAttract } from "PicoAttract.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoAttract { height: 200 * Tokens.p; attract: { shown: true, carts: [{ id: "celeste", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 4, sticker: 7, sticker-ink-light: false, progress: "new", hero: true, focused: false }, { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }], chosen: 0 }; }
    }
}

export component EmptyLibrary inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoAttract { height: 200 * Tokens.p; attract: { shown: true, carts: [], chosen: 0 }; }
    }
}
