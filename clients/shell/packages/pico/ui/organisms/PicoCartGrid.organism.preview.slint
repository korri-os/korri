// Preview states of PicoCartGrid, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoCartGrid.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoCartGrid } from "PicoCartGrid.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoCartGrid { columns: 6; sections: [{ title: "CONTINUE", carts: [{ id: "celeste", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 4, sticker: 7, sticker-ink-light: false, progress: "new", hero: true, focused: false }, { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }] }, { title: "ZAO", carts: [{ id: "tetris", title: "Tetris", has-art: false, art-ratio: 1, initials: "T", system: "gb", shell: 7, sticker: 0, sticker-ink-light: false, progress: "played", hero: false, focused: false }, { id: "tide", title: "Tide Pool", has-art: false, art-ratio: 1, initials: "TP", system: "md", shell: 5, sticker: 8, sticker-ink-light: false, progress: "new", hero: false, focused: false }] }]; }
    }
}
