// Preview states of PicoIdentityDialog, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoIdentityDialog.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoIdentityDialog } from "PicoIdentityDialog.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoIdentityDialog { identity: { title: "SWITCH FROM BACKUP", note: "Save files and save states stay under the plugin account.", rows: [{ label: "Encrypted backup", detail: "—", focused: true, target: true, disabled: false, warn: false, lit: false }, { label: "Password", detail: "—", focused: false, disabled: false, warn: false, lit: false }, { label: "SWITCH IDENTITY", detail: "", focused: false, disabled: true, warn: true, lit: false }] }; }
    }
}

export component Backup inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoIdentityDialog { identity: { title: "BACK UP IDENTITY", note: "Korri cannot recover a lost key.", qr: "M 0 0 H 7 V 7 H 0 Z M 14 0 H 21 V 7 H 14 Z M 0 14 H 7 V 21 H 0 Z M 9 9 H 12 V 12 H 9 Z", qr-size: 21, secret: "ncryptsec1qgq…", rows: [{ label: "DONE", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }] }; }
    }
}
