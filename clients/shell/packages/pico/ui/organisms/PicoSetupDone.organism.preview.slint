// Preview states of PicoSetupDone, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSetupDone.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoSetupDone } from "PicoSetupDone.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoSetupDone { height: 160 * Tokens.p; setup: { step: "play", layout: "done", tone: "ask", title: "Ready to play.", message: "", busy: "", rows: [{ section: "", label: "Device", value: "usu", description: "", source: "", device-only: false, kind: "fact", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false },{ section: "", label: "Wi-Fi", value: "Home-5G", description: "", source: "", device-only: false, kind: "fact", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }], carts: [], more: "", answers: [], inline: false, go: { label: "GO TO GAMES", detail: "", focused: true, disabled: false, warn: false, lit: false }, has-go: true, pack: { } }; }
    }
}
