// Preview states of PicoGameStage, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoGameStage.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoGameStage } from "PicoGameStage.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoGameStage { height: 160 * Tokens.p; cart: { id: "celeste", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 4, sticker: 7, sticker-ink-light: false, progress: "new", hero: true, focused: false }; kicker: "CONTINUE"; title: "Celeste Classic"; subtitle: "PICO-8 · This device"; chips: [{ text: "NEVER PLAYED", kind: "empty" }]; index: 1; total: 9; }
    }
}

export component LongTitle inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoGameStage { height: 160 * Tokens.p; cart: { id: "petal", title: "Petal Quest", has-art: false, art-ratio: 1, initials: "PQ", system: "pico8", shell: 1, sticker: 4, sticker-ink-light: false, progress: "new", hero: false, focused: false }; title: "The Legend of the Supercalifragilisticexpialidocious Lighthouse Keeper"; subtitle: "PICO-8"; chips: []; index: 3; total: 9; }
    }
}
