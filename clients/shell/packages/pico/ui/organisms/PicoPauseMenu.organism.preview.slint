// Preview states of PicoPauseMenu, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoPauseMenu.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPauseMenu } from "PicoPauseMenu.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { background: P8.shell-tell; height: 200 * Tokens.p; PicoPauseMenu { x: 4 * Tokens.p; y: 4 * Tokens.p; width: parent.width - 8 * Tokens.p; items: [{ kind: "row", label: "Continue playing", focused: true, target: true }, { kind: "row", label: "Quit game", warn: true }, { kind: "note", label: "Unsaved progress is lost." }, { kind: "section", label: "MGBA" }, { kind: "row", label: "Load state", disabled: true }, { kind: "row", label: "Fast forward", value: "OFF", arrows: true }, { kind: "row", label: "Volume", value: "80", range: true, cells: 8 }, { kind: "fact", label: "System", value: "gba" }]; } }
    }
}
