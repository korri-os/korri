// Preview states of PicoLocationPicker, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoLocationPicker.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoLocationPicker } from "PicoLocationPicker.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoLocationPicker { height: 160 * Tokens.p; places: { shown: true, tone: "ask", kicker: "", title: "Tetris", message: "", lines: [], actions: [{ label: "This device", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false },{ label: "zao", detail: "", focused: false, disabled: false, warn: false, lit: false }], inline: false }; }
    }
}
