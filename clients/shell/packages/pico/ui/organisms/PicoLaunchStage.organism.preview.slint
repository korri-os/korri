// Preview states of PicoLaunchStage, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoLaunchStage.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoLaunchStage } from "PicoLaunchStage.slint";


export component Starting inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoLaunchStage { height: 200 * Tokens.p; launch: { kicker: "STARTING", detail: "Preparing the game.", bar: { shown: true, cells: 16, walking: false }, has-cart: true, cart: { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, phase: "starting", actions: [] }; }
    }
}

export component Downloading inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoLaunchStage { height: 200 * Tokens.p; launch: { kicker: "Downloading FEX rootfs", detail: "116 MB of 1.2 GB", bar: { shown: true, cells: 2, walking: false }, has-cart: true, cart: { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, phase: "starting", actions: [{ label: "Cancel", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }] }; }
    }
}

export component Steps inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoLaunchStage { height: 200 * Tokens.p; launch: { kicker: "Starting Hollow…", steps: { shown: true, count: 4, current: 2, words: "Step 3 of 4 · Getting the game ready" }, bar: { shown: false, cells: 0, walking: false }, has-cart: true, cart: { id: "hollow", title: "Hollow Knight", has-art: false, art-ratio: 1, initials: "HK", system: "snes", shell: 0, sticker: 3, sticker-ink-light: false, progress: "resume", hero: false, focused: false }, phase: "starting", actions: [{ label: "Cancel", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }] }; }
    }
}
