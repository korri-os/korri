import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoCart, CartView } from "../molecules/PicoCart.slint";
import { PicoGameFacts } from "../molecules/PicoGameFacts.slint";
import { ChipView } from "../atoms/PicoBadge.slint";

// The chosen game, large, on its two shadow steps, beside what Korri says
// about it. A short stage drops the art; a choice drops the cart 12 pixels
// into place in 4 steps (pico-land).
export component PicoGameStage {
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <CartView> cart;
    in property <string> kicker;
    in property <string> title;
    in property <string> subtitle;
    in property <[ChipView]> chips;
    in property <int> index;
    in property <int> total;
    property <bool> no-art: root.height < 16 * Tokens.sm || (root.width < 67.5 * Tokens.sm * 4 / 7 && root.height < 40 * Tokens.sm);
    property <length> box-w: min(root.width * 42%, 190 * Tokens.p);
    property <length> box-h: max(16 * Tokens.p, min(root.height - 38 * Tokens.p, 190 * Tokens.p));
    property <int> land: 4;
    property <string> shown: cart.id;
    changed shown => { land = 0; }
    Timer { interval: 60ms; running: land < 4; triggered => { land += 1; } }
    if !no-art : Rectangle {
        x: 0;
        y: Tokens.snap(max(0, (root.height - still.shell-h - 8 * Tokens.p) / 2)) - 3 * Tokens.p * (4 - land);
        width: still.shell-w + 8 * Tokens.p;
        height: still.shell-h + 8 * Tokens.p;
        Rectangle { x: 8 * Tokens.p; y: 8 * Tokens.p; width: still.shell-w; height: still.shell-h; background: P8.cast-far; }
        Rectangle { x: 4 * Tokens.p; y: 4 * Tokens.p; width: still.shell-w; height: still.shell-h; background: P8.cast-near; }
        still := PicoCart { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  x: 0; y: 0; cart: cart; still: true; box-w: box-w; box-h: box-h; initials-size: Tokens.xl; }
    }
    PicoGameFacts {
        x: no-art ? 0 : box-w + 18 * Tokens.p;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        kicker: kicker;
        title: title;
        subtitle: subtitle;
        chips: chips;
        index: index;
        total: total;
        large: root.height >= 24 * Tokens.sm;
        roomy: root.height >= 16 * Tokens.sm;
    }
}
