import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoTitle } from "../atoms/PicoTitle.slint";
import { PicoButton } from "../atoms/PicoButton.slint";
import { PicoSettingRow } from "../molecules/PicoSettingRow.slint";
import { SetupView } from "../molecules/PicoSetupHeading.slint";

// Setup's PLAY: what was set up, and GO TO GAMES.
export component PicoSetupDone inherits VerticalLayout {
    in property <SetupView> setup;
    alignment: center;
    spacing: Tokens.u;
    PicoTitle { text: setup.title; }
    for fact in setup.rows : PicoSettingRow { item: fact; ink: P8.ink-dim; }
    if setup.has-go : HorizontalLayout { alignment: start; padding-top: Tokens.u; PicoButton { button: setup.go; } }
}
