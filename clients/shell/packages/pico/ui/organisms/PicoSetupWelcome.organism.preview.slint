// Preview states of PicoSetupWelcome, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSetupWelcome.organism.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoSetupWelcome } from "PicoSetupWelcome.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoSetupWelcome { height: 160 * Tokens.p; setup: { step: "hello", layout: "hello", tone: "ask", title: "Hello.", message: "Let's get this console ready to play. Have your Wi-Fi password handy.", busy: "", rows: [], carts: [], more: "", answers: [], inline: false, go: { label: "START", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }, has-go: true, pack: { } }; }
    }
}
