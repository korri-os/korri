// Preview states of PicoSettingRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSettingRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoSettingRow } from "PicoSettingRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 90 * Tokens.p; background: P8.shell-tell; VerticalLayout { padding: 4 * Tokens.p; spacing: Tokens.p; PicoSettingRow { item: { section: "RUNNER", label: "Runner", value: "", description: "", source: "mGBA from Game", device-only: false, kind: "cycle", focused: true, warn: false, state: "idle", state-text: "", segments: [{ label: "INHERIT", on: true }, { label: "MGBA" }, { label: "GPSP" }], bars: 0, locked: false }; } PicoSettingRow { item: { section: "", label: "CPU min", value: "Inherit", description: "Applies at next launch.", source: "33 % from Device", device-only: true, kind: "step", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; } PicoSettingRow { item: { section: "", label: "Home-5G", value: "CONNECTED", description: "", source: "", device-only: false, kind: "network", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 3, locked: true }; } } }
    }
}
