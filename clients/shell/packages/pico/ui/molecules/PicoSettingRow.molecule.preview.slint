// Preview states of PicoSettingRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSettingRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoSettingRow } from "PicoSettingRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 90 * Tokens.p; background: P8.shell-tell; VerticalLayout { padding: 4 * Tokens.p; spacing: Tokens.p; PicoSettingRow { item: { section: "RUNNER", label: "Runner", value: "", description: "", source: "mGBA from Game", device-only: false, kind: "cycle", focused: true, target: true, warn: false, state: "idle", state-text: "", segments: [{ label: "INHERIT", on: true }, { label: "MGBA" }, { label: "GPSP" }], bars: 0, locked: false }; } PicoSettingRow { item: { section: "", label: "CPU min", value: "Inherit", description: "Applies at next launch.", source: "33 % from Device", device-only: true, kind: "step", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; } PicoSettingRow { item: { section: "", label: "Home-5G", value: "CONNECTED", description: "", source: "", device-only: false, kind: "network", focused: false, warn: false, state: "idle", state-text: "", segments: [], bars: 3, locked: true }; } } }
    }
}

// Launch settings (ADR 0066): a changed row with its earlier value; the focused
// row with the words its plate cut and where its value stays; a row that
// cannot change; and the keep row.
export component OneList inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 150 * Tokens.p; background: P8.shell-tell; VerticalLayout { padding: 4 * Tokens.p; spacing: 3 * Tokens.p; alignment: start; PicoSettingRow { item: { section: "VIDEO", label: "Render scale", value: "2x", description: "", source: "", device-only: false, was: "4x", wrap: true, kind: "step", focused: false, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; } PicoSettingRow { item: { section: "", label: "Texture filter", value: "Sharp bilinear, integer prescale", description: "", source: "Stays on aka", device-only: false, was: "Nearest", wrap: true, kind: "step", focused: true, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; } PicoSettingRow { item: { section: "", label: "FPS limit", value: "Off", description: "Not supported by WiiCompiled", source: "", device-only: false, was: "", wrap: true, kind: "fact", focused: false, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; } } }
        PicoSettingRow { primary: true; ink: P8.ink-quiet; item: { section: "", label: "Keep 2 changes", value: "This game", description: "", source: "", device-only: false, was: "", wrap: true, kind: "pick", focused: false, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; }
        PicoSettingRow { primary: true; ink: P8.ink-quiet; item: { section: "", label: "Keep 2 changes", value: "This game", description: "Used every time you play this game.", source: "", device-only: false, was: "", wrap: true, kind: "pick", focused: true, target: true, warn: false, state: "idle", state-text: "", segments: [], bars: 0, locked: false }; }
    }
}
