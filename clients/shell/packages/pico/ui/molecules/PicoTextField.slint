import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoLine } from "../atoms/PicoLine.slint";

// The editor's field: the text (a secret masked), the caret, and the
// placeholder when empty. A long text keeps its end in sight.
export component PicoTextField {
    in property <string> text;
    in property <string> placeholder;
    in property <length> font-size: Tokens.short ? Tokens.md : Tokens.lg;
    height: font-size * 1.3;
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        spacing: Tokens.p;
        alignment: start;
        PicoLine {
            line-height: root.height;
            text: text == "" ? placeholder : text;
            font-size: text == "" ? Tokens.md : root.font-size;
            color: text == "" ? P8.ink-quiet : P8.ink;
            horizontal-alignment: right;
        }
        Rectangle {
            width: font-size * 3 / 7;
            Rectangle { x: 0; y: (parent.height - font-size) / 2; width: parent.width; height: font-size * 5 / 7 + 2 * Tokens.p; background: P8.accent; }
        }
    }
}
