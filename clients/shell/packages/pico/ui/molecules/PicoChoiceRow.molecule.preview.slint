// Preview states of PicoChoiceRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoChoiceRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoChoiceRow } from "PicoChoiceRow.slint";
import { ButtonView } from "../atoms/PicoRow.slint";

export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 40 * Tokens.p; background: P8.shell-ask; VerticalLayout { padding: 4 * Tokens.p; PicoChoiceRow { choice: { label: "FPS limit", detail: "", focused: true, disabled: false, warn: false, lit: false }; note: "1 more setting mGBA offers here."; } } }
    }
}
