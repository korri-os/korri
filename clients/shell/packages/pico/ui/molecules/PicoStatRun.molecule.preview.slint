// Preview states of PicoStatRun, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStatRun.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStatRun } from "PicoStatRun.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoStatRun { chips: [{ text: "RESUME", kind: "ok" }, { text: "1.5 GB DOWNLOAD", kind: "info" }, { text: "3", caption: "PLAYS", kind: "stat" }, { text: "2H 10M", caption: "PLAYED", kind: "stat" }]; }
        PicoStatRun { width: 60 * Tokens.p; chips: [{ text: "RESUME", kind: "ok" }, { text: "1.5 GB DOWNLOAD", kind: "info" }, { text: "3", caption: "PLAYS", kind: "stat" }, { text: "2H 10M", caption: "PLAYED", kind: "stat" }]; }
    }
}
