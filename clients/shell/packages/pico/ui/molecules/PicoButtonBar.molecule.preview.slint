// Preview states of PicoButtonBar, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoButtonBar.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoButtonBar } from "PicoButtonBar.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoButtonBar { has-lead: true; lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }; readout: "9 CARTS · 2 RESUMABLE"; hints: [{ key: "a", label: "PLAY" }, { key: "b", label: "BACK" }]; }
    }
}
