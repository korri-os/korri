// Preview states of PicoNotice, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoNotice.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoNotice } from "PicoNotice.slint";


export component Ask inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoNotice { card: { shown: true, tone: "ask", kicker: "PLAY WHERE?", title: "Tetris", message: "", lines: [], actions: [{ label: "This device", detail: "", focused: true, disabled: false, warn: false, lit: false },{ label: "zao", detail: "", focused: false, disabled: false, warn: false, lit: false }], inline: false }; }
    }
}

export component Warn inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoNotice { card: { shown: true, tone: "warn", kicker: "ARE YOU SURE?", title: "REMOVE FROM DEVICE?", message: "Hollow Knight — this cannot be undone.", lines: [], actions: [{ label: "REMOVE FROM DEVICE", detail: "", focused: false, disabled: false, warn: true, lit: false },{ label: "CANCEL", detail: "", focused: true, disabled: false, warn: false, lit: false }], inline: false }; }
    }
}

export component Report inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoNotice { card: { shown: true, tone: "ask", kicker: "CHECK FIRST", title: "Turn on Chiptune?", message: "", lines: [{ text: "Publisher @ada, trusted on this device.", focused: true }, { text: "Uses the network." }], actions: [{ label: "TURN ON", detail: "", focused: false, disabled: false, warn: false, lit: false },{ label: "CANCEL", detail: "", focused: false, disabled: false, warn: false, lit: false }], inline: true }; }
    }
}
