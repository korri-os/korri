// One game drawn as a cartridge (PicoCart) (surfaces/pico/src/ui/molecules/PicoCart.css):
// plastic shell, a notch or the system's silhouette at the top, grip ridges
// at the foot, and the cover as the sticker in its window. The shell takes
// the art's shape. Every size is whole virtual pixels.

import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoReveal } from "../atoms/PicoReveal.slint";
import { PicoCoverArt } from "../atoms/PicoCoverArt.slint";

export struct CartView {
    id: string,
    title: string,
    art: image,
    has-art: bool,
    initials: string,
    system: string,
    shell: int,
    sticker: int,
    sticker-ink-light: bool,
    // Width over height of the art as Pico samples it; 0 reads the image.
    art-ratio: float,
    progress: string,
    // Lifted: the chosen cart on a shelf.
    hero: bool,
    // The cursor is on it: its shadow cycles.
    focused: bool,
    // A focus target in this view: only then is `focused` current.
    target: bool,
    // The focus target's id (src/native/focus.ts): what a tap on it reports (ADR 0055).
    focus-id: string,
}

export component PicoCart {
    // A cart is drawn; the rack that holds it marks the focus target (a
    // slot of one size per rack, so carts of different heights stand level).
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <CartView> cart;
    property <length> p: Tokens.p;
    // `still` is the large cartridge on the stage; otherwise a shelf cart.
    in property <bool> still;
    // The box the art fits in (--pico-art-w, --pico-art-h).
    in property <length> box-w;
    in property <length> box-h;
    in property <length> initials-size: Tokens.md;
    property <length> small-text: Tokens.sm;
    property <length> body-text: Tokens.md;

    // Shell metrics: still and shelf placements, then the systems that change them.
    property <length> pad: still ? 5 * p : 3 * p;
    property <length> top-pad: cart.system == "nes" ? 8 * p : still ? 6 * p : 4 * p;
    property <length> foot: cart.system == "gba" ? 4 * p : still ? 8 * p : 6 * p;
    property <length> notch: still ? 3 * p : 2 * p;
    property <length> ridge: still ? 3 * p : 2 * p;
    property <length> band: cart.system == "gbc" ? p : cart.system == "md" ? 3 * p : 0;

    // The art at its own ratio, fitted in the box and never cropped. Missing
    // art is a square sticker.
    property <float> ratio: !cart.has-art ? 1 : cart.art-ratio > 0 ? cart.art-ratio : cart.art.height > 0 ? cart.art.width / cart.art.height : 1;
    property <length> art-w: cart.has-art ? min(box-w, box-h * ratio) : min(box-w, box-h);
    property <length> art-h: cart.has-art ? art-w / ratio : art-w;

    out property <length> shell-w: art-w + 2 * pad;
    out property <length> shell-h: band + top-pad + art-h + foot;
    width: shell-w;
    height: shell-h;

    // The plastic.
    Rectangle {
        background: P8.plastic(cart.shell);
    }

    // GBC's stripe and Mega Drive's dark top band.
    if band > 0 : Rectangle {
        y: 0;
        height: band;
        background: P8.ink-dark;
    }

    // The label slot, cut in background colour. Its shape is the system's.
    if cart.system == "pico8" : Rectangle {
        x: Tokens.snap(shell-w * 20%);
        y: band;
        width: Tokens.snap(shell-w * 60%);
        height: notch;
        background: P8.bg;
    }
    if cart.system == "gb" || cart.system == "gbc" : Rectangle {
        x: shell-w - Tokens.snap(shell-w * 22%);
        y: band;
        width: Tokens.snap(shell-w * 22%);
        height: notch * 2;
        background: P8.bg;
    }
    if cart.system == "gba" : Rectangle {
        x: 0;
        y: band;
        width: 3 * p;
        height: notch * 2;
        background: P8.bg;
    }
    if cart.system == "gba" : Rectangle {
        x: shell-w - 3 * p;
        y: band;
        width: 3 * p;
        height: notch * 2;
        background: P8.bg;
    }
    if cart.system == "snes" : Rectangle {
        x: Tokens.snap(shell-w * 12%);
        y: band;
        width: Tokens.snap(shell-w * 19%);
        height: notch;
        background: P8.bg;
    }
    if cart.system == "snes" : Rectangle {
        x: shell-w - Tokens.snap(shell-w * 12%) - Tokens.snap(shell-w * 19%);
        y: band;
        width: Tokens.snap(shell-w * 19%);
        height: notch;
        background: P8.bg;
    }
    if cart.system == "other" : Rectangle {
        x: Tokens.snap(shell-w * 30%);
        y: band;
        width: Tokens.snap(shell-w * 40%);
        height: notch;
        background: P8.bg;
    }
    // NES: ridges across the top instead of a slot.
    if cart.system == "nes" : Rectangle {
        x: pad;
        y: band + 2 * p;
        width: shell-w - 2 * pad;
        height: 3 * p;
        Rectangle { y: 0; height: p; background: P8.ink-dark; }
        Rectangle { y: 2 * p; height: p; background: P8.ink-dark; }
    }

    // The window: a one-pixel dark outline, then the art or the sticker.
    Rectangle {
        x: pad - p;
        y: band + top-pad - p;
        width: art-w + 2 * p;
        height: art-h + 2 * p;
        background: P8.ink-dark;
    }
    PicoCoverArt {
        x: pad;
        y: band + top-pad;
        width: art-w;
        height: art-h;
        art: cart.art;
        has-art: cart.has-art;
        initials: cart.initials;
        sticker: cart.sticker;
        ink-light: cart.sticker-ink-light;
        initials-size: root.initials-size;
    }

    // Grip ridges along the foot: one dark pixel every three. GBA has none.
    if cart.system != "gba" : Rectangle {
        x: pad;
        y: shell-h - 2 * p - ridge;
        width: shell-w - 2 * pad;
        height: ridge;
        clip: true;
        for index in ceil((shell-w - 2 * pad) / (3 * p)) : Rectangle {
            x: index * 3 * p;
            width: p;
            background: P8.ink-dark;
        }
    }

    // Never played: a plate band across the window's foot with NEW on it.
    if cart.progress == "new" && !still : Rectangle {
        y: shell-h - (foot - p) - (p + small-text);
        height: p + small-text;
        background: P8.plate;
        Text {
            y: p;
            height: small-text;
            text: "NEW";
            font-size: small-text;
            color: P8.go;
            horizontal-alignment: center;
        }
    }

    // A save waiting: a green tab off the top-right corner.
    if cart.progress == "resume" : Rectangle {
        property <length> pad-x: still ? 2 * p : p;
        property <length> pad-top: still ? 2 * p : p;
        property <length> pad-bottom: still ? p : 0;
        property <length> size: still ? body-text : small-text;
        x: shell-w + (still ? 4 * p : 3 * p) - self.width;
        y: still ? -4 * p : -3 * p;
        width: glyph.preferred-width + 2 * pad-x;
        height: pad-top + size + pad-bottom;
        Rectangle {
            x: p;
            y: p;
            background: P8.ink-dark;
        }
        Rectangle {
            background: P8.ok;
        }
        glyph := Text {
            x: pad-x;
            y: pad-top;
            height: size;
            text: "▶";
            font-size: size;
            color: P8.ink-dark;
        }
    }
    PicoReveal { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  x: 0; y: 0; width: root.width; height: root.height; focused: (cart.target && cart.focused); }
}
