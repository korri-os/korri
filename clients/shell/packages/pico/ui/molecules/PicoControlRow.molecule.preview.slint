// Preview states of PicoControlRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoControlRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoControlRow } from "PicoControlRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 80 * Tokens.p; background: P8.shell-tell; VerticalLayout { padding: 4 * Tokens.p; spacing: 2 * Tokens.p; PicoControlRow { label: "Load state"; disabled: true; note: "No save yet"; } PicoControlRow { label: "Fast forward"; value: "OFF"; arrows: true; focused: true; } PicoControlRow { label: "Volume"; range: true; cells: 8; value: "80"; } } }
    }
}
