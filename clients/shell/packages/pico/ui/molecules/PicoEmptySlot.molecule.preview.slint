// Preview states of PicoEmptySlot, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoEmptySlot.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoEmptySlot } from "PicoEmptySlot.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoEmptySlot { height: 80 * Tokens.p; }
    }
}
