// Preview states of PicoStatusBar, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStatusBar.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStatusBar } from "PicoStatusBar.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoStatusBar { place: "korri"; label: "LIBRARY"; clock: "10:24"; }
        PicoStatusBar { place: "LIBRARY"; sep: true; label: "Hollow Knight"; clock: "10:24"; }
    }
}
