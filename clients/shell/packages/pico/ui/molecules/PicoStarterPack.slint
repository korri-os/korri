import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPara } from "../atoms/PicoPara.slint";
import { PicoRow, ButtonView } from "../atoms/PicoRow.slint";
import { PicoCard } from "PicoCard.slint";

// The Starter pack's offer and where its install stands.
export component PicoStarterPack inherits PicoCard {
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <string> title;
    in property <string> message;
    in property <[ButtonView]> answers;
    PicoPara { text: title; color: P8.shell-ink(root.tone); }
    PicoPara { text: message; font-size: Tokens.sm; color: P8.note(root.tone); }
    for answer in answers : PicoRow { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  button: answer; kind: "card"; }
}
