import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoChip } from "../atoms/PicoChip.slint";
import { ButtonView } from "../atoms/PicoRow.slint";
import { PicoRail } from "../atoms/PicoRail.slint";

// Which runner a layer's card shows: ANY RUNNER, a family, each runner.
export component PicoScopeTabs inherits PicoRail {
    callback activated(target: string, at: float, released: bool);
    in property <[ButtonView]> scopes;
    in property <color> tone: P8.blue;
    spacing: 2 * Tokens.p;
    for scope in scopes : PicoChip { activated(target, at, released) => { root.activated(target, at, released); }  reveal(left, top, wide, tall) => { root.show(left, top, wide, tall); }  button: scope; ground: tone; ink: P8.ink-dark; lit-ground: P8.ink-dark; lit-ink: P8.ink; }
}
