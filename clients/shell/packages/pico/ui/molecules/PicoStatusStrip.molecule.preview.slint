// Preview states of PicoStatusStrip, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStatusStrip.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStatusStrip } from "PicoStatusStrip.slint";


export component Default inherits Window {
    background: P8.navy;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        // Every fact, as much room as it wants: one line.
        PicoStatusStrip {
            room: parent.width;
            strip: {
                shown: true,
                device: [{ value: "3:42 PM", known: true, battery: -2 }, { value: "82%", known: true, battery: 4 }],
                stream: [{ before: "RTT", value: "3", after: "ms", known: true, battery: -2 }, { value: "20.1", after: "Mb/s", known: true, battery: -2 }, { value: "0", after: "DROPPED", known: true, battery: -2 }],
            };
        }
        // Nothing Korri knows, in a narrow room: one fact a line, each unknown.
        PicoStatusStrip {
            room: 0;
            strip: {
                shown: true,
                device: [{ value: "--:--", known: false, battery: -2 }, { value: "--", known: false, battery: -1 }],
                stream: [{ before: "RTT", value: "--", after: "ms", known: false, battery: -2 }, { value: "--", after: "Mb/s", known: false, battery: -2 }, { value: "--", after: "DROPPED", known: false, battery: -2 }],
            };
        }
    }
}
