// Preview states of PicoResultRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoResultRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoResultRow } from "PicoResultRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { alignment: start; spacing: 4 * Tokens.p; height: 60 * Tokens.p; PicoResultRow { width: 50 * Tokens.p; cart: { id: "a", title: "Celeste Classic", has-art: false, art-ratio: 1, initials: "CC", system: "pico8", shell: 8, sticker: 1, sticker-ink-light: false, progress: "played", hero: true, focused: true, target: true }; title: "Celeste Classic 2"; subtitle: "PICO-8"; } PicoResultRow { width: 50 * Tokens.p; cart: { id: "b", title: "The Legend", has-art: false, art-ratio: 1, initials: "TL", system: "pico8", shell: 9, sticker: 2, sticker-ink-light: false, progress: "played", hero: false, focused: false }; title: "The Legend of the Supercalifragilistic Lighthouse Keeper"; subtitle: "PICO-8"; } }
    }
}
