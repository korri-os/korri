// Preview states of PicoControllerRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoControllerRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoControllerRow } from "PicoControllerRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoControllerRow { name: "Built-in controls"; heard: true; ink: P8.ink; }
        PicoControllerRow { name: "8BitDo Pro 2"; heard: false; ink: P8.ink; }
    }
}
