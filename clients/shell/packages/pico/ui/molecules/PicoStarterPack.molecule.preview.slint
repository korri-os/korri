// Preview states of PicoStarterPack, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStarterPack.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStarterPack } from "PicoStarterPack.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoStarterPack { tone: "ask"; title: "Starter pack"; message: "Free games and the programs to play them. No internet needed."; answers: [{ label: "Install", detail: "", focused: true, disabled: false, warn: false, lit: false }]; }
    }
}
