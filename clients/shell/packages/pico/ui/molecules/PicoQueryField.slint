import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoLine } from "../atoms/PicoLine.slint";

// What is typed into Find, with the block caret; the prompt when empty.
export component PicoQueryField {
    in property <string> query;
    in property <string> placeholder: "TYPE TO FIND A GAME";
    in property <length> font-size: Tokens.short ? Tokens.md : Tokens.lg;
    height: font-size * 1.3;
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        spacing: Tokens.p;
        alignment: start;
        PicoLine {
            line-height: root.height;
            text: query == "" ? placeholder : query;
            font-size: query == "" ? Tokens.md : root.font-size;
            color: query == "" ? P8.ink-quiet : P8.ink;
        }
        Rectangle {
            width: font-size * 3 / 7;
            Rectangle { x: 0; y: (parent.height - font-size) / 2; width: parent.width; height: font-size * 5 / 7 + 2 * Tokens.p; background: P8.accent; }
        }
    }
}
