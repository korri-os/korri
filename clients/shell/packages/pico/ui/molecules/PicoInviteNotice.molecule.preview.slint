// Preview states of PicoInviteNotice, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoInviteNotice.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoInviteNotice } from "PicoInviteNotice.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoInviteNotice { width: 150 * Tokens.p; playing: "Simon is playing"; game: "Turtles in Time"; where: "on Odin 2 Portal"; }
    }
}
