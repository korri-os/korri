// Preview states of PicoNetworkRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoNetworkRow.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoNetworkRow } from "PicoNetworkRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoNetworkRow { ssid: "Home-5G"; bars: 4; locked: true; focused: true; }
        PicoNetworkRow { ssid: "Corner Cafe Free"; bars: 2; }
        PicoNetworkRow { ssid: "Home-2.4"; bars: 3; locked: true; connected: true; }
    }
}
