// Preview states of PicoTabs, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoTabs.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoTabs } from "PicoTabs.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoTabs { height: Tokens.md + 4 * Tokens.p; spines: [{ label: "DEVICE", detail: "", focused: true, disabled: false, warn: false, lit: true }, { label: "PLUGINS", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "GAMES", detail: "", focused: false, disabled: false, warn: false, lit: false }]; }
        PicoTabs { beside: true; width: 60 * Tokens.p; height: 60 * Tokens.p; spines: [{ label: "DEVICE", detail: "", focused: false, disabled: false, warn: false, lit: true }, { label: "PLUGINS", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "GAMES", detail: "", focused: false, disabled: false, warn: false, lit: false }]; }
    }
}
