// Preview states of PicoGameFacts, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoGameFacts.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoGameFacts } from "PicoGameFacts.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoGameFacts { kicker: "CONTINUE"; title: "Celeste Classic"; subtitle: "PICO-8 · This device"; chips: [{ text: "NEVER PLAYED", kind: "empty" }]; index: 1; total: 9; }
    }
}
