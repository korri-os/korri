// Preview states of PicoScopeTabs, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoScopeTabs.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoScopeTabs } from "PicoScopeTabs.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoScopeTabs { scopes: [{ label: "ANY RUNNER", detail: "", focused: false, disabled: false, warn: false, lit: true }, { label: "FAMILY RETROARCH", detail: "", focused: false, disabled: false, warn: false, lit: false }, { label: "MGBA", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }]; }
    }
}
