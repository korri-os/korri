// Preview states of PicoSetupHeading, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSetupHeading.molecule.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoSetupHeading } from "PicoSetupHeading.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { background: P8.shell-ask; height: 50 * Tokens.p; PicoSetupHeading { title: "Pick a network"; message: "Setup needs a connection to go on."; } }
    }
}
