// Preview states of PicoClock, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoClock.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoClock } from "PicoClock.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoClock { label: "10:24"; }
    }
}
