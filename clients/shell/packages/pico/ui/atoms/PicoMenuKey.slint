import { P8 } from "../palette.slint";
import { Tokens, Cycle } from "../tokens.slint";
import { PicoTap } from "PicoTap.slint";
import { PicoLine } from "PicoLine.slint";
import { ButtonView } from "PicoRow.slint";

// The floor's lead control: MENU with its three bars, or a quiet word (RELOAD).
// It stands on the floor, never in a scrolled body, so it reveals nothing.
export component PicoMenuKey {
    callback activated(target: string, at: float, released: bool);
    // A focus target, for screen readers and the shell's probe: the
    // cursor's control is the selected item.
    accessible-role: AccessibleRole.button;
    accessible-label: button.label;
    accessible-item-selectable: true;
    accessible-item-selected: (button.target && button.focused);
    in property <ButtonView> button;
    in property <bool> menu: true;
    // The highlight: hidden while touch is in use (Tokens.ring); the focus stays.
    property <bool> ring: button.target && button.focused && Tokens.ring;
    width: row.preferred-width;
    height: 12 * Tokens.p;
    Rectangle { x: Tokens.drop-sm; y: Tokens.drop-sm; width: root.width; height: root.height; background: ring ? Cycle.now : P8.plate-shadow; }
    Rectangle { background: ring ? P8.pick : P8.plate; }
    row := HorizontalLayout {
        padding-top: 2 * Tokens.p;
        padding-bottom: 2 * Tokens.p;
        padding-left: 3 * Tokens.p;
        padding-right: 3 * Tokens.p;
        spacing: 2 * Tokens.p;
        property <color> ink: ring ? P8.pick-ink : button.disabled ? P8.ink-quiet : P8.plate-ink;
        if menu : Rectangle {
            width: 8 * Tokens.p;
            for bar in 3 : Rectangle { x: Tokens.p; y: (1 + 2 * bar) * Tokens.p; width: 6 * Tokens.p; height: Tokens.p; background: row.ink; }
        }
        PicoLine { line-height: 8 * Tokens.p; text: button.label; font-size: menu ? Tokens.sm : Tokens.md; color: row.ink; overflow: clip; }
    }
    PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: button.target ? button.focus-id : ""; }
}
