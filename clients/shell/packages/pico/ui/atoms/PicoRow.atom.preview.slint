// Preview states of PicoRow, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoRow.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoRow } from "PicoRow.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoRow { button: { label: "Verify files", detail: "", focused: false, disabled: false, warn: false, lit: false }; }
        PicoRow { button: { label: "Move to SD", detail: "No card", focused: false, disabled: true, warn: false, lit: false }; }
        PicoRow { button: { label: "Remove from device", detail: "", focused: false, disabled: false, warn: true, lit: false }; }
        PicoRow { button: { label: "Name", detail: "usu ▶", focused: true, target: true, disabled: false, warn: false, lit: false }; }
    }
}

export component OnCard inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { background: P8.shell-ask; height: 40 * Tokens.p; VerticalLayout { padding: 4 * Tokens.p; spacing: 2 * Tokens.p; PicoRow { kind: "card"; button: { label: "This device", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }; } PicoRow { kind: "card"; button: { label: "zao", detail: "", focused: false, disabled: false, warn: false, lit: false }; } } }
    }
}
