import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";

// A region that scrolls what it holds to keep the cursor's control in sight
// (the web build had the host's scrollIntoView). What it holds reports its
// focused control to `show`. What it holds is laid out
// at its natural height, never less than the region's; a control outside
// what the region holds never scrolls it.
export component PicoScroll inherits Rectangle {
    in property <length> margin: Tokens.u;
    // The height of what it holds: a region that hugs its list asks for this.
    out property <length> natural: content.min-height;
    property <length> scroll: 0;
    property <length> limit: max(0, content.height - root.height);
    // Where the control to reveal stands, in window coordinates, until the
    // region moves a moment later: a row inside (PicoRail) slides first.
    property <length> want-top;
    property <length> want-tall;
    property <bool> pending;
    // Bring the control at this place into sight, if it is one of this region's.
    public function show(left: length, top: length, wide: length, tall: length) {
        want-top = top;
        want-tall = tall;
        pending = true;
    }
    Timer {
        interval: 1ms;
        running: pending;
        triggered => {
            pending = false;
            let top = want-top - root.absolute-position.y + min(scroll, limit);
            // A control outside what this region holds is not its to reveal.
            if (top < 0 || top > content.height) {
                return;
            }
            if (top < min(scroll, limit) + margin) {
                scroll = max(0, top - margin);
            } else if (top + want-tall > min(scroll, limit) + root.height - margin) {
                scroll = min(limit, top + want-tall - root.height + margin);
            }
        }
    }
    clip: true;
    content := VerticalLayout {
        x: 0;
        y: -min(scroll, limit);
        width: root.width;
        height: max(root.height, self.min-height);
        @children
    }
}
