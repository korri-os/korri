import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";

// A region that scrolls what it holds to keep the cursor's control in sight
// (the web build had the host's scrollIntoView). What it holds is laid out
// at its natural height, never less than the region's; a control outside
// the region (the floor's MENU) never scrolls it.
export component PicoScroll inherits Rectangle {
    in property <length> margin: Tokens.u;
    property <length> scroll: 0;
    property <length> limit: max(0, content.height - root.height);
    property <int> serial: Focus.serial;
    changed serial => {
        // Where the control stands in the content, from the window's top.
        let top = Focus.y - root.absolute-position.y + min(scroll, limit);
        if (Focus.y < root.absolute-position.y - root.height || Focus.y > root.absolute-position.y + 2 * root.height + limit) {
            return;
        }
        if (top < min(scroll, limit) + margin) {
            scroll = max(0, top - margin);
        } else if (top + Focus.h > min(scroll, limit) + root.height - margin) {
            scroll = min(limit, top + Focus.h - root.height + margin);
        }
    }
    clip: true;
    content := VerticalLayout {
        x: 0;
        y: -min(scroll, limit);
        width: root.width;
        height: max(root.height, self.min-height);
        @children
    }
}
