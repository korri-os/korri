// Preview states of PicoCoverArt, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoCoverArt.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoCoverArt } from "PicoCoverArt.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { spacing: Tokens.u; alignment: start; height: 40 * Tokens.p; PicoCoverArt { width: 40 * Tokens.p; initials: "PQ"; sticker: 1; } PicoCoverArt { width: 40 * Tokens.p; initials: "CC"; sticker: 8; ink-light: true; } }
    }
}
