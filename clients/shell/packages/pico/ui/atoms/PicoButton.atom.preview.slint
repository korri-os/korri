// Preview states of PicoButton, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoButton.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoButton } from "PicoButton.slint";
import { ButtonView } from "PicoRow.slint";

export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { spacing: 2 * Tokens.u; alignment: start; PicoButton { button: { label: "CONTINUE", detail: "", focused: true, disabled: false, warn: false, lit: false }; } PicoButton { button: { label: "PLAY", detail: "", focused: false, disabled: false, warn: false, lit: false }; } }
    }
}

export component NoMark inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { alignment: start; PicoButton { mark: false; button: { label: "GET", detail: "", focused: false, disabled: false, warn: false, lit: false }; } }
    }
}
