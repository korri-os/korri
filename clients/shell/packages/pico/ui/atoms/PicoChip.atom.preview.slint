// Preview states of PicoChip, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoChip.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoChip } from "PicoChip.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { spacing: 3 * Tokens.p; alignment: start; PicoChip { button: { label: "ALL", detail: "", focused: false, disabled: false, warn: false, lit: true }; } PicoChip { button: { label: "CONTINUE", detail: "", focused: true, target: true, disabled: false, warn: false, lit: false }; } PicoChip { button: { label: "ZAO", detail: "", focused: false, disabled: false, warn: false, lit: false }; } }
    }
}
