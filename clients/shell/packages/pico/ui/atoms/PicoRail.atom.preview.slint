// Preview states of PicoRail, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoRail.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoRail } from "PicoRail.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoRail { Rectangle { width: 120 * Tokens.p; height: 10 * Tokens.p; background: P8.navy; } Rectangle { width: 120 * Tokens.p; background: P8.maroon; } Rectangle { width: 120 * Tokens.p; background: P8.green; } }
    }
}
