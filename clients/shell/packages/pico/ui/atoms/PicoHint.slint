import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPixelDisc } from "PicoPixelDisc.slint";
import { PicoLine } from "PicoLine.slint";
import { PicoTap } from "PicoTap.slint";

// One focus target of a hint (ADR 0055).
export struct HintHalf { focused: bool, target: bool, focus-id: string }

// A face button and what it does: "a", "b", or "lr" for left and right. A
// hint is a focus target a finger can press (ADR 0055): it runs that
// button's own handler, and the cursor never walks onto it, so `focused`
// stays false. ◀▶ is two targets: its left half (the hint's own) steps
// left, its right half (`right`) steps right.
export struct HintView { key: string, label: string, focused: bool, target: bool, focus-id: string, right: HintHalf }

export component PicoHint {
    callback activated(target: string, at: float, released: bool);
    // A focus target for the shell's probe; the cursor is never on it. ◀▶
    // is its two halves instead.
    accessible-role: AccessibleRole.button;
    accessible-label: hint.label;
    accessible-item-selectable: hint.target && hint.key != "lr";
    accessible-item-selected: hint.target && hint.key != "lr" && hint.focused;
    in property <HintView> hint;
    property <bool> halves: hint.key == "lr";
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    row := HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        spacing: 2 * Tokens.p;
        Rectangle {
            width: 8 * Tokens.p;
            PicoPixelDisc {
                x: 0;
                y: Tokens.snap((parent.height - self.height) / 2);
                disc: hint.key == "a" ? P8.key-a : hint.key == "b" ? P8.key-b : P8.key-lr;
                glyph: hint.key == "a" ? "A" : hint.key == "b" ? "B" : "◀▶";
            }
        }
        PicoLine { text: hint.label; color: P8.ink-dim; overflow: clip; }
    }
    if !halves : PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: hint.target ? hint.focus-id : ""; }
    // ◀▶ ADJUST: its left half steps left, its right half right.
    if halves : Rectangle {
        x: 0;
        y: 0;
        width: root.width / 2;
        height: root.height;
        accessible-role: AccessibleRole.button;
        accessible-label: hint.label;
        accessible-item-selectable: hint.target;
        accessible-item-selected: hint.target && hint.focused;
        PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: parent.width; height: parent.height; target: hint.target ? hint.focus-id : ""; }
    }
    if halves : Rectangle {
        x: root.width / 2;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        accessible-role: AccessibleRole.button;
        accessible-label: hint.label;
        accessible-item-selectable: hint.right.target;
        accessible-item-selected: hint.right.target && hint.right.focused;
        PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: parent.width; height: parent.height; target: hint.right.target ? hint.right.focus-id : ""; }
    }
}
