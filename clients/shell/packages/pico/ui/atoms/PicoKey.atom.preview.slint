// Preview states of PicoKey, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoKey.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoKey } from "PicoKey.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 3 * Tokens.md; PicoKey { x: 0; y: 0; width: 4 * Tokens.md; height: Tokens.md + 5 * Tokens.p; key: { cap: "a", focused: true, target: true }; } PicoKey { x: 5 * Tokens.md; y: 0; width: 4 * Tokens.md; height: Tokens.md + 5 * Tokens.p; key: { cap: "b" }; } PicoKey { x: 10 * Tokens.md; y: 0; width: 8 * Tokens.md; height: Tokens.md + 5 * Tokens.p; key: { cap: "↑ CAPS", lit: true }; } }
    }
}
