// Preview states of PicoBattery, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoBattery.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoBattery } from "PicoBattery.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    HorizontalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        PicoBattery { height: Tokens.sm * 1.5; cells: 5; }
        PicoBattery { height: Tokens.sm * 1.5; cells: 4; }
        PicoBattery { height: Tokens.sm * 1.5; cells: 1; }
        PicoBattery { height: Tokens.sm * 1.5; cells: 0; }
        PicoBattery { height: Tokens.sm * 1.5; known: false; }
    }
}
