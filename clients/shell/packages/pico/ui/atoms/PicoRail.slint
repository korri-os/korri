import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";

// A row that keeps its items at their own width and slides sideways to keep
// the cursor's item in sight: tabs and filters that do not fit their row.
export component PicoRail inherits Rectangle {
    in property <length> spacing: 3 * Tokens.p;
    in property <length> margin: Tokens.u;
    property <length> scroll: 0;
    property <length> limit: max(0, row.width - root.width);
    property <int> serial: Focus.serial;
    changed serial => {
        let left = Focus.x - root.absolute-position.x + min(scroll, limit);
        let top = Focus.y - root.absolute-position.y;
        // Only an item of this row moves it.
        if (top < 0 || top >= root.height || left < 0 || left > row.width) {
            return;
        }
        if (left < min(scroll, limit) + margin) {
            scroll = max(0, left - margin);
        } else if (left + Focus.w > min(scroll, limit) + root.width - margin) {
            scroll = min(limit, left + Focus.w - root.width + margin);
        }
    }
    clip: true;
    height: row.preferred-height;
    row := HorizontalLayout {
        x: -min(scroll, limit);
        y: 0;
        width: max(root.width, self.preferred-width);
        height: root.height;
        alignment: start;
        spacing: root.spacing;
        @children
    }
}
