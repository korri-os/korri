// Preview states of PicoStat, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoStat.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStat } from "PicoStat.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { spacing: Tokens.u; alignment: start; PicoStat { figure: "3"; caption: "PLAYS"; } PicoStat { figure: "2H 10M"; caption: "PLAYED"; } }
    }
}
