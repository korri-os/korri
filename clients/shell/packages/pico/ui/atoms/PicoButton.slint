import { P8 } from "../palette.slint";
import { Tokens, Cycle } from "../tokens.slint";
import { PicoTap } from "PicoTap.slint";
import { PicoReveal } from "PicoReveal.slint";
import { PicoLine } from "PicoLine.slint";
import { ButtonView } from "PicoRow.slint";

// The one thing the screen wants pressed: yellow, a play mark, a brown hard
// shadow that cycles under the cursor.
export component PicoButton {
    callback activated(target: string, at: float, released: bool);
    // A focus target, for screen readers and the shell's probe: the
    // cursor's control is the selected item.
    accessible-role: AccessibleRole.button;
    accessible-label: button.label;
    accessible-item-selectable: true;
    accessible-item-selected: (button.target && button.focused);
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <ButtonView> button;
    in property <length> font-size: Tokens.lg;
    in property <bool> mark: true;
    // The highlight: hidden while touch is in use (Tokens.ring); the focus stays.
    property <bool> ring: button.target && button.focused && Tokens.ring;
    width: row.preferred-width;
    height: font-size + 8 * Tokens.p;
    Rectangle {
        x: Tokens.drop;
        y: Tokens.drop;
        width: root.width;
        height: root.height;
        background: ring ? Cycle.now : P8.go-shadow;
    }
    Rectangle { background: button.disabled ? P8.slate : P8.go; }
    row := HorizontalLayout {
        padding-left: 5 * Tokens.p;
        padding-right: 6 * Tokens.p;
        spacing: 5 * Tokens.p;
        if mark : Rectangle {
            width: font-size * 3 / 7;
            for r in 5 : Rectangle {
                x: 0;
                y: Tokens.snap((parent.height - font-size * 5 / 7) / 2) + r * font-size / 7;
                width: (r < 3 ? r + 1 : 5 - r) * font-size / 7;
                height: font-size / 7;
                background: P8.go-ink;
            }
        }
        PicoLine { line-height: root.height; text: button.label; font-size: root.font-size; color: P8.go-ink; overflow: clip; }
    }
    PicoReveal { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  x: 0; y: 0; width: root.width; height: root.height; focused: (button.target && button.focused); }
    PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: button.target ? button.focus-id : ""; }
}
