import { P8 } from "../palette.slint";
import { Tokens, Cycle } from "../tokens.slint";
import { PicoTap } from "PicoTap.slint";
import { PicoReveal } from "PicoReveal.slint";

// One key: navy with a maroon drop; yellow under the cursor; pink when on
// (CAPS). It stands at a column and row of a ten-column board.
export struct KeyView { cap: string, focused: bool, target: bool, focus-id: string, lit: bool, row: int, col: int, cols: int }

export component PicoKey {
    callback activated(target: string, at: float, released: bool);
    // A focus target, for screen readers and the shell's probe: the
    // cursor's control is the selected item.
    accessible-role: AccessibleRole.button;
    accessible-label: key.cap;
    accessible-item-selectable: true;
    accessible-item-selected: (key.target && key.focused);
    callback reveal(left: length, top: length, wide: length, tall: length);
    in property <KeyView> key;
    // The highlight: hidden while touch is in use (Tokens.ring); the focus stays.
    property <bool> ring: key.target && key.focused && Tokens.ring;
    Rectangle { x: Tokens.p; y: Tokens.p; width: root.width; height: root.height; background: ring ? Cycle.now : P8.plate-shadow; }
    Rectangle { background: ring ? P8.go : key.lit ? P8.accent : P8.plate; }
    Text {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        text: key.cap;
        font-size: key.cap.character-count > 1 ? Tokens.sm : Tokens.md;
        color: ring || key.lit ? P8.ink-dark : P8.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: clip;
    }
    PicoReveal { reveal(left, top, wide, tall) => { root.reveal(left, top, wide, tall); }  x: 0; y: 0; width: root.width; height: root.height; focused: (key.target && key.focused); }
    PicoTap { activated(target, at, released) => { root.activated(target, at, released); }  x: 0; y: 0; width: root.width; height: root.height; target: key.target ? key.focus-id : ""; }
}
