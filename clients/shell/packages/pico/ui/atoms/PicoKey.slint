import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoReveal } from "PicoReveal.slint";

// One key: navy with a maroon drop; yellow under the cursor; pink when on
// (CAPS). It stands at a column and row of a ten-column board.
export struct KeyView { cap: string, focused: bool, lit: bool, row: int, col: int, cols: int }

export component PicoKey {
    in property <KeyView> key;
    Rectangle { x: Tokens.p; y: Tokens.p; width: root.width; height: root.height; background: key.focused ? Cycle.now : P8.plate-shadow; }
    Rectangle { background: key.focused ? P8.go : key.lit ? P8.accent : P8.plate; }
    Text {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        text: key.cap;
        font-size: key.cap.character-count > 1 ? Tokens.sm : Tokens.md;
        color: key.focused || key.lit ? P8.ink-dark : P8.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: clip;
    }
    PicoReveal { x: 0; y: 0; width: root.width; height: root.height; focused: key.focused; }
}
