// Preview states of PicoSlide, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoSlide.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoSlide } from "PicoSlide.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    slide := PicoSlide { region: "shelf"; pitch: 40 * Tokens.p; rest: 0; least: 0; most: 400 * Tokens.p; }
    VerticalLayout {
        padding: 2 * Tokens.u;
        alignment: start;
        Rectangle { height: 20 * Tokens.p; Rectangle { x: -(slide.active ? slide.place : 0px); width: 30 * Tokens.p; background: P8.navy; } }
    }
}
