// Preview states of PicoPixelDisc, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoPixelDisc.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPixelDisc } from "PicoPixelDisc.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        HorizontalLayout { spacing: Tokens.u; alignment: start; PicoPixelDisc { glyph: "A"; } PicoPixelDisc { disc: P8.key-b; glyph: "B"; } }
    }
}
