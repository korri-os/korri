// Preview states of PicoTap, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoTap.atom.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoTap } from "PicoTap.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    VerticalLayout {
        padding: 2 * Tokens.u;
        spacing: Tokens.u;
        alignment: start;
        Rectangle { height: 20 * Tokens.p; background: P8.navy; PicoTap { x: 0; y: 0; width: parent.width; height: parent.height; target: "row"; } }
        Rectangle { height: 20 * Tokens.p; background: P8.navy; PicoTap { x: 0; y: 0; width: parent.width; height: parent.height; target: "range"; range: true; track-start: parent.width / 2; track-end: parent.width; } }
    }
}
