import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";

// Where setup stands: one bar a step. Done is green, skipped is orange
// dashes, the step now is the accent, the rest are plates.
export struct StepView { state: string }

export component PicoStepTrack {
    in property <[StepView]> steps;
    height: 2 * Tokens.p;
    property <length> step-w: (root.width - (steps.length - 1) * 2 * Tokens.p) / max(1, steps.length);
    for step[i] in steps : Rectangle {
        x: Tokens.snap(i * (step-w + 2 * Tokens.p));
        y: 0;
        width: Tokens.snap(step-w);
        height: root.height;
        background: step.state == "done" ? P8.ok : step.state == "now" ? P8.accent : step.state == "skipped" ? P8.bg : P8.plate;
        if step.state == "skipped" : HorizontalLayout {
            spacing: 2 * Tokens.p;
            for d in floor(parent.width / (4 * Tokens.p)) : Rectangle { width: 2 * Tokens.p; background: P8.skip; }
        }
    }
}
