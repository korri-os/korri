// Preview states of PicoGameOverlay, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoGameOverlay.template.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoGameOverlay } from "PicoGameOverlay.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoGameOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        kicker: "PAUSED";
        title: "Hollow Knight";
        hints: [{ key: "a", label: "SELECT" }, { key: "b", label: "RESUME" }];
        Rectangle { height: 40 * Tokens.p; background: P8.ink-dark; }
    }
}
