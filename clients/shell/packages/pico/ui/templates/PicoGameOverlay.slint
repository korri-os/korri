import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoLine } from "../atoms/PicoLine.slint";
import { PicoPara } from "../atoms/PicoPara.slint";
import { PicoHint, HintView } from "../atoms/PicoHint.slint";
import { PicoScroll } from "../atoms/PicoScroll.slint";
import { PicoCard } from "../molecules/PicoCard.slint";
import { SheetItem } from "../organisms/PicoPauseMenu.slint";

// A tall blue card over everything, with its own list (the pause menu, the
// runner picker).
export struct SheetView { kicker: string, title: string, items: [SheetItem], focused-item: int, hints: [HintView] }

// Over a running game or over the catalog: a blue card with its kicker and
// title, the list in it scrolling to the cursor, and the hints below.
//
// Over the catalog the card fills the box. Over a live game (`over-game`,
// ADR 0053) the game stays in sight: the card hugs its list, top left, and
// takes 45% of the width (never under 200 virtual pixels; the whole width
// when less than 64 would be left beside it), and wears its outline; the
// hints stand on a black plate.
export component PicoGameOverlay inherits Rectangle {
    in property <string> kicker;
    in property <string> title;
    in property <[HintView]> hints;
    in property <bool> over-game;
    property <length> foot: Tokens.snap(Tokens.sm * 1.5) + 2 * Tokens.u;
    property <length> full-w: root.width - 4 * Tokens.u - 5 * Tokens.p;
    property <length> full-h: root.height - 2 * Tokens.u - foot - 5 * Tokens.p;
    property <length> side-w: max(200 * Tokens.p, Tokens.snap(root.width * 45%));
    property <length> card-w: over-game && full-w - side-w >= 64 * Tokens.p ? side-w : full-w;
    // What the list holds reports its focused control here.
    public function show(left: length, top: length, wide: length, tall: length) {
        list.show(left, top, wide, tall);
    }
    card := PicoCard {
        x: 2 * Tokens.u;
        y: 2 * Tokens.u;
        width: root.card-w;
        height: root.over-game ? min(root.full-h, self.preferred-height) : root.full-h;
        tone: "tell";
        outline: root.over-game;
        if kicker != "" : PicoLine { text: kicker; color: P8.shell-tell-kicker; }
        if title != "" : PicoPara { text: title; font-size: Tokens.short ? Tokens.md : Tokens.lg; color: P8.shell-tell-ink; }
        list := PicoScroll { vertical-stretch: 1; preferred-height: self.natural; @children }
    }
    Rectangle {
        x: hint-row.x - Tokens.u;
        y: hint-row.y - 2 * Tokens.p;
        width: hint-row.width + 2 * Tokens.u;
        height: hint-row.height + 4 * Tokens.p;
        background: P8.bg;
    }
    hint-row := HorizontalLayout {
        x: root.width - 2 * Tokens.u - self.preferred-width;
        y: root.height - foot + Tokens.u;
        width: self.preferred-width;
        height: Tokens.snap(Tokens.sm * 1.5);
        spacing: Tokens.snap(Tokens.u * 1.5);
        for hint in hints : PicoHint { hint: hint; }
    }
}
