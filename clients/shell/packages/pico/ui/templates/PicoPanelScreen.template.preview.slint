// Preview states of PicoPanelScreen, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoPanelScreen.template.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoPanelScreen } from "PicoPanelScreen.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoPanelScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spines: [{ label: "DEVICE", detail: "", focused: true, disabled: false, warn: false, lit: true }, { label: "GAMES", detail: "", focused: false, disabled: false, warn: false, lit: false }];
        Text { text: "A group of settings"; font-size: Tokens.md; }
    }
}

export component Beside inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoPanelScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spines: [{ label: "DEVICE", detail: "", focused: false, disabled: false, warn: false, lit: true }, { label: "GAMES", detail: "", focused: false, disabled: false, warn: false, lit: false }];
        Text { text: "A group of settings"; font-size: Tokens.md; }
    }
}
