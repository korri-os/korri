// Preview states of PicoScreenShell, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoScreenShell.template.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoScreenShell } from "PicoScreenShell.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoScreenShell {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "korri", sep: false, label: "LIBRARY", clock: "10:24", readout: "9 CARTS", hints: [{ key: "a", label: "PLAY" },{ key: "b", label: "BACK" }], has-lead: true, lead-kind: "menu", lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [] };
        Rectangle { height: 100 * Tokens.p; background: P8.navy; }
    }
}

export component Breadcrumb inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoScreenShell {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "LIBRARY", sep: true, label: "Hollow Knight", clock: "10:24", readout: "", hints: [{ key: "a", label: "SELECT" },{ key: "b", label: "BACK" }], has-lead: false, lead-kind: "menu", lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [] };
    }
}

export component Track inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    PicoScreenShell {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        frame: { place: "SETUP", sep: false, label: "WI-FI", clock: "10:24", readout: "", hints: [{ key: "a", label: "SELECT" },{ key: "b", label: "BACK" }], has-lead: false, lead-kind: "menu", lead: { label: "MENU", detail: "", focused: false, disabled: false, warn: false, lit: false }, track: [{ state: "done" }, { state: "now" }, { state: "next" }] };
    }
}
