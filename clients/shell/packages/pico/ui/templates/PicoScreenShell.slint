import { P8 } from "../palette.slint";
import { Tokens, Cycle, Focus } from "../tokens.slint";
import { PicoStepTrack, StepView } from "../atoms/PicoStepTrack.slint";
import { HintView } from "../atoms/PicoHint.slint";
import { ButtonView } from "../atoms/PicoRow.slint";
import { PicoScroll } from "../atoms/PicoScroll.slint";
import { PicoStatusBar } from "../molecules/PicoStatusBar.slint";
import { PicoButtonBar } from "../molecules/PicoButtonBar.slint";

// What frames every screen: where you are, setup's steps, the floor.
export struct FrameView {
    place: string,
    sep: bool,
    label: string,
    clock: string,
    readout: string,
    hints: [HintView],
    has-lead: bool,
    lead-kind: string,
    lead: ButtonView,
    track: [StepView],
}

// Every screen of the catalog and setup: the status bar, setup's step track,
// the body (which scrolls to keep the cursor's control in sight), and the
// floor row. The frame never moves; only the body differs.
export component PicoScreenShell inherits Rectangle {
    in property <FrameView> frame;
    out property <length> body-y: bar.y + bar.height + (frame.track.length > 0 ? 6 * Tokens.p : 0) + Tokens.u;
    out property <length> body-h: floor.y - Tokens.u - body-y;
    bar := PicoStatusBar {
        x: 2 * Tokens.u;
        y: Tokens.u;
        width: root.width - 4 * Tokens.u;
        place: frame.place;
        sep: frame.sep;
        label: frame.label;
        clock: frame.clock;
    }
    if frame.track.length > 0 : PicoStepTrack { x: 2 * Tokens.u; y: bar.y + bar.height + 3 * Tokens.p; width: root.width - 4 * Tokens.u; steps: frame.track; }
    PicoScroll {
        x: 2 * Tokens.u;
        y: body-y;
        width: root.width - 4 * Tokens.u;
        height: body-h;
        @children
    }
    floor := PicoButtonBar {
        x: 2 * Tokens.u;
        y: root.height - self.height - Tokens.snap(Tokens.u * 1.5) + Tokens.u;
        width: root.width - 4 * Tokens.u;
        hints: frame.hints;
        readout: frame.readout;
        has-lead: frame.has-lead;
        lead-menu: frame.lead-kind == "menu";
        lead: frame.lead;
    }
}
