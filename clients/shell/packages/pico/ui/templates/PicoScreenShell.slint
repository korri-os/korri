import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoStepTrack, StepView } from "../atoms/PicoStepTrack.slint";
import { HintView } from "../atoms/PicoHint.slint";
import { ButtonView } from "../atoms/PicoRow.slint";
import { PicoScroll } from "../atoms/PicoScroll.slint";
import { PicoStatusBar } from "../molecules/PicoStatusBar.slint";
import { PicoButtonBar } from "../molecules/PicoButtonBar.slint";

// What frames every screen: where you are, setup's steps, the floor.
export struct FrameView {
    place: string,
    sep: bool,
    label: string,
    clock: string,
    readout: string,
    hints: [HintView],
    has-lead: bool,
    lead-kind: string,
    lead: ButtonView,
    track: [StepView],
}

// Every screen of the catalog and setup: the status bar, setup's step track,
// the body (which scrolls to keep the cursor's control in sight), and the
// floor row. The frame never moves; only the body differs.
export component PicoScreenShell inherits Rectangle {
    callback activated(target: string, at: float, released: bool);
    in property <FrameView> frame;
    // Room kept between the body and the floor for what a page holds still
    // there (launch settings' keep row); `pinned-y` is where it stands.
    in property <length> pinned-room: 0;
    // The body draws a bar down its right edge when it holds more than it shows.
    in property <bool> marks;
    out property <length> body-y: bar.y + bar.height + (frame.track.length > 0 ? 6 * Tokens.p : 0) + Tokens.u;
    out property <length> body-h: max(0, floor.y - Tokens.u - body-y - pinned-room);
    // Right under a body shorter than its room; over the floor under a longer one.
    out property <length> pinned-y: body-y + min(body-h, body.natural) + Tokens.u;
    // The bar cut the place or left it out (a long game's title). A page that
    // then says the place itself sets `says-place`: the bar shows it whole or not at all.
    in property <bool> says-place;
    out property <bool> place-cut: bar.place-cut;
    out property <length> body-x: 2 * Tokens.u;
    out property <length> body-w: root.width - 4 * Tokens.u;
    // What the body holds reports its focused control here.
    public function show(left: length, top: length, wide: length, tall: length) {
        body.show(left, top, wide, tall);
    }
    bar := PicoStatusBar {
        x: 2 * Tokens.u;
        y: Tokens.u;
        width: root.width - 4 * Tokens.u;
        place: frame.place;
        sep: frame.sep;
        label: frame.label;
        clock: frame.clock;
        whole-or-none: root.says-place;
    }
    if frame.track.length > 0 : PicoStepTrack { x: 2 * Tokens.u; y: bar.y + bar.height + 3 * Tokens.p; width: root.width - 4 * Tokens.u; steps: frame.track; }
    body := PicoScroll { 
        x: 2 * Tokens.u;
        y: body-y;
        width: root.width - 4 * Tokens.u;
        height: body-h;
        marks: root.marks;
        @children
    }
    floor := PicoButtonBar { activated(target, at, released) => { root.activated(target, at, released); } 
        x: 2 * Tokens.u;
        y: root.height - self.height - Tokens.snap(Tokens.u * 1.5) + Tokens.u;
        width: root.width - 4 * Tokens.u;
        hints: frame.hints;
        readout: frame.readout;
        has-lead: frame.has-lead;
        lead-menu: frame.lead-kind == "menu";
        lead: frame.lead;
    }
}
