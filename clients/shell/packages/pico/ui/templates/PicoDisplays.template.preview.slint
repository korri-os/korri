// Preview states of PicoDisplays, with fixture data: the Caliper part's role.
// Render one: slint-viewer --component STATE --screenshot out.png PicoDisplays.template.preview.slint
import { P8 } from "../palette.slint";
import { Tokens } from "../tokens.slint";
import { PicoDisplays } from "PicoDisplays.slint";


export component Default inherits Window {
    background: P8.bg;
    default-font-family: Tokens.family;
    init => { Tokens.fit(self.width, self.height); }
    changed width => { Tokens.fit(self.width, self.height); }
    changed height => { Tokens.fit(self.width, self.height); }
    root-displays := PicoDisplays {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        split: { on: true, show-x: 0, show-y: 0, show-w: 640, show-h: 480, choose-x: 0, choose-y: 480, choose-w: 640, choose-h: 480 };
        Rectangle { x: root-displays.show-x; y: root-displays.show-y; width: root-displays.show-w; height: root-displays.show-h; background: P8.navy; }
        Rectangle { x: root-displays.choose-x; y: root-displays.choose-y; width: root-displays.choose-w; height: root-displays.choose-h; background: P8.maroon; }
    }
}
