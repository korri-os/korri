// VelvetProgramme: a list page, the theatre's programme: what the house can
// do, set out in rows. Its title in the display face, a line under it, the
// rows, and its buttons at the foot. Settings, Wi-Fi, getting games, invites,
// identity, saves, a runner, launch settings and first boot are all this one
// page with other rows.
//
// A page may hold a panel: a game's card, or a QR code Korri encoded (an
// account sign-in, ADR 0089), and its text. Beside the rows while the window
// is wide for its height (the plan decides), else over them. A code stands
// on a light plate with its quiet zone, as large as the panel allows: over
// the rows it takes three quarters of the height left and half the width.
// Where that would leave a module under the least size (`code-first`, the
// logic decides it from the plan), the page is one list from the window's
// top: the title, the code as a row as large as the window allows, its
// words, the rows and the buttons, each a row (src/pages.ts).
// First boot shows where it stands among its steps. The cluster stands at the
// top right; it has what the head leaves of the line. A code-first page has no
// head line, so it shows no cluster.

import { Tokens } from "../tokens.slint";
import { Page, Row, Pill, Tile, Cluster } from "../types.slint";
import { VelvetHead } from "../atoms/VelvetHead.slint";
import { VelvetWords } from "../atoms/VelvetWords.slint";
import { VelvetButtons } from "../molecules/VelvetButtons.slint";
import { VelvetTile } from "../molecules/VelvetTile.slint";
import { VelvetCode } from "../molecules/VelvetCode.slint";
import { VelvetRows } from "VelvetRows.slint";
import { VelvetCluster } from "VelvetCluster.slint";

export component VelvetProgramme inherits Rectangle {
    callback activated(target: string, at: float, released: bool);
    in property <Page> page;
    in property <Cluster> cluster;
    in property <[Row]> rows;
    in property <[Pill]> buttons;
    in property <[string]> panel-lines;
    in property <[Tile]> tiles;
    // The code's dark modules as path commands, in a viewbox `qr-size` modules square.
    in property <string> qr;
    in property <int> qr-size;
    in property <bool> inert;
    property <length> u: Tokens.unit;
    property <length> pad-x: Tokens.screen.pad-x * u;
    property <length> pad-y: Tokens.screen.pad-y * u;
    property <length> body: Tokens.screen.body * u;
    property <length> fact: Tokens.screen.fact * u;
    property <bool> beside: Tokens.screen.panel-beside;
    property <bool> alone: page.code-first;
    property <bool> coded: page.panel == "qr" && qr != "" && qr-size > 0 && !alone;
    property <bool> panelled: page.panel == "text" || page.panel == "tile" || coded;
    property <length> page-w: (panelled || beside) && !alone ? Tokens.screen.page-w * u : Math.min(self.width - 2 * pad-x, Tokens.page-most * Tokens.screen.kt);
    property <bool> broken: page.title-next != "";
    property <length> head-foot: Tokens.screen.head-y * u + (broken ? page.title-size * (1.2 + Tokens.display-line) * u : Tokens.screen.head-h * u);
    property <length> sub-h: page.sub == "" ? 0px : sub.preferred-height + fact * 0.4;
    property <length> body-top: head-foot + sub-h + fact * 1.1;
    // The panel over the rows takes at most two fifths of what is left.
    // A narrow window stacks the code over its words, the code as wide as the page allows.
    property <bool> qr-under: coded && !beside && Tokens.screen.narrow;
    property <length> qr-words: fact * 5;
    property <length> qr-side: Math.max(0px, Math.min(self.width - 2 * pad-x, (self.height - body-top - pad-y - buttons-h - fact) * 0.75 - qr-words));
    property <length> panel-h: !panelled ? 0px : beside ? self.height - body-top - pad-y
        : qr-under ? qr-side + fact + qr-words
        : coded ? Math.max(0px, Math.min((self.height - body-top - pad-y - buttons-h) * 0.75, (self.width - 2 * pad-x) * 0.5))
        : Math.min((self.height - body-top - pad-y) * 0.4, self.width - 2 * pad-x);
    property <length> rows-y: alone ? pad-y : body-top + (panelled && !beside ? panel-h + fact : 0px);
    property <length> buttons-h: buttons.length == 0 ? 0px : pills.block + body * 0.9;
    property <length> rows-h: Math.max(0px, self.height - rows-y - pad-y - buttons-h);
    // One list: the code's row is as large as the list's width and height allow.
    property <length> code-side: Math.max(0px, Math.min(page-w, rows-h));
    property <bool> in;
    init => { in = true; }
    opacity: in ? 1 : 0;
    animate opacity { duration: Tokens.t-level; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> cluster-gap: root.fact * 1.4;
    cluster := VelvetCluster {
        visible: !root.alone;
        x: root.width - root.pad-x - self.width;
        y: root.pad-y * 0.7;
        cluster: root.cluster;
        room: Math.max(0px, root.width - 2 * root.pad-x - head.preferred-width - root.cluster-gap);
    }
    // A title too long for one line beside the step: two lines, the step beside the second.
    if !root.alone && root.broken: VelvetHead {
        x: root.pad-x;
        y: Tokens.screen.head-y * root.u;
        width: Math.max(0px, parent.width - 2 * root.pad-x - (cluster.used > 0 ? cluster.used + root.cluster-gap : 0px));
        height: root.page.title-size * 1.2 * root.u;
        size: root.page.title-size * root.u;
        text: root.page.title-first;
    }
    if !root.alone && root.broken: HorizontalLayout {
        x: root.pad-x;
        y: Tokens.screen.head-y * root.u + root.page.title-size * Tokens.display-line * root.u;
        width: Math.min(self.preferred-width, parent.width - 2 * root.pad-x);
        height: root.page.title-size * 1.2 * root.u;
        spacing: root.fact;
        next := VelvetHead {
            horizontal-stretch: 0;
            size: root.page.title-size * root.u;
            text: root.page.title-next;
        }
        if root.page.steps > 0: VerticalLayout {
            alignment: end;
            padding-bottom: next.drop - root.fact * 0.24;
            VelvetWords {
                text: "Step " + root.page.step + " of " + root.page.steps;
            }
        }
    }
    // Always present, so the cluster can measure the title; shown when whole.
    head := HorizontalLayout {
        visible: !root.alone && !root.broken;
        x: root.pad-x;
        y: Tokens.screen.head-y * root.u;
        width: Math.max(0px, Math.min(self.preferred-width, parent.width - 2 * root.pad-x - (cluster.used > 0 ? cluster.used + root.cluster-gap : 0px)));
        height: Tokens.screen.head-h * root.u;
        spacing: root.fact;
        title := VelvetHead {
            horizontal-stretch: 0;
            text: root.page.title;
        }
        if root.page.steps > 0: VerticalLayout {
            alignment: end;
            padding-bottom: title.drop - root.fact * 0.24;
            VelvetWords {
                text: "Step " + root.page.step + " of " + root.page.steps;
            }
        }
    }
    sub := VelvetWords {
        visible: !root.alone;
        x: root.pad-x;
        y: root.head-foot + root.fact * 0.3;
        width: Math.min(parent.width - 2 * root.pad-x, root.body * 34);
        text: root.page.sub;
        wraps: true;
        vertical-alignment: TextVerticalAlignment.top;
    }
    list := VelvetRows {
        x: root.pad-x - root.body * 0.9;
        y: root.rows-y;
        width: root.page-w + root.body * 0.9;
        height: Math.min(root.rows-h, self.content);
        rows: root.rows;
        inert: root.inert;
        qr: root.alone ? root.qr : "";
        qr-size: root.qr-size;
        code-side: root.code-side;
        page: root.page;
        activated(target, at, released) => { root.activated(target, at, released); }
    }
    pills := VelvetButtons {
        x: root.pad-x;
        y: list.y + list.height + (root.rows.length > 0 ? root.body * 0.9 : 0px);
        width: root.page.stack ? Math.min(root.page-w, parent.width - 2 * root.pad-x) : parent.width - 2 * root.pad-x;
        pills: root.buttons;
        stack: root.page.stack;
        inert: root.inert;
        activated(target, at, released) => { root.activated(target, at, released); }
    }
    if root.panelled: Rectangle {
        x: root.beside ? root.pad-x + root.page-w + root.pad-x * 0.8 : root.pad-x;
        y: root.body-top;
        width: root.beside ? Tokens.screen.panel-w * root.u : parent.width - 2 * root.pad-x;
        height: root.panel-h;
        property <length> art: root.coded ? (root.beside ? Math.min(self.height * 0.62, self.width) : root.qr-under ? root.qr-side : self.height)
            : Math.min(self.height * (root.beside ? 0.56 : 1), root.beside ? self.width : self.width * 0.42);
        if root.coded: VelvetCode {
            x: 0;
            y: 0;
            width: parent.art;
            qr: root.qr;
            qr-size: root.qr-size;
            badge: root.page.code-badge;
            mark: root.page.code-mark;
            logo-shown: root.page.code-logo-shown;
            logo: root.page.code-logo;
        }
        for tile in root.tiles: VelvetTile {
            x: 0;
            y: 0;
            width: parent.art * Tokens.tile-ratio;
            height: parent.art;
            tile: tile;
            fixed: true;
            inert: true;
        }
        property <bool> under: root.beside || root.qr-under;
        VerticalLayout {
            x: parent.under ? 0px : parent.art + root.fact;
            y: parent.under ? parent.art + root.fact : 0px;
            width: parent.under ? parent.width : parent.width - parent.art - root.fact;
            height: Math.min(self.preferred-height, parent.height - self.y);
            spacing: root.fact * 0.2;
            alignment: start;
            if root.page.panel-title != "": VelvetWords {
                text: root.page.panel-title;
                ink: Tokens.house-light;
                strong: true;
            }
            for line in root.panel-lines: VelvetWords {
                text: line;
                wraps: true;
            }
        }
    }
}
