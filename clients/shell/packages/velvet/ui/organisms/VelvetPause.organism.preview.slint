ouch sensitivity", bars: -1, focus-id: "c:viewer:launch-7f3a:2:9:touch" }, { kind: "range", label: "SGSR sharpness", value: "20", bars: -1, share: 0.4, focus-id: "c:viewer:launch-7f3a:2:9:sgsr-sharpness" }, { kind: "range", label: "SGSR edge threshold", value: "8", bars: -1, share: 0.226, focus-id: "c:viewer:launch-7f3a:2:9:sgsr-edge" }, { kind: "row", label: "Flip A/B and X/Y", value: "Off", mark: "off", bars: -1, focus-id: "c:viewer:launch-7f3a:2:9:flip" }, { kind: "row", label: "Rumble", value: "On", mark: "on", bars: -1, focus-id: "c:viewer:launch-7f3a:2:9:rumble" }, { kind: "row", label: "Picture-in-picture", value: "Off", mark: "off", bars: -1, focus-id: "c:viewer:launch-7f3a:2:9:pip" }]; }
