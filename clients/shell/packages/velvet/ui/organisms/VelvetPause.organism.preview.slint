export component Plain inherits VelvetPreview {
    VelvetPause { x: 0; y: 0; width: parent.width; height: parent.height; title: ["PAUSED"]; title-size: 43 * Tokens.unit; clock: "21:47"; facts: []; rows: [{ kind: "row", label: "Continue", mark: "none", focus-id: "c:resume", focused: true }, { kind: "row", label: "Restart", mark: "none", danger: true, focus-id: "c:restart" }, { kind: "row", label: "Exit", mark: "none", danger: true, focus-id: "c:exit" }]; }
}

