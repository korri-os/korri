// VelvetPause's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetPause } from "VelvetPause.slint";

export component Plain inherits VelvetPreview {
    VelvetPause { x: 0; y: 0; width: parent.width; height: parent.height; title: ["PAUSED"]; title-size: 38 * Tokens.unit; clock: "21:47"; facts: []; rows: [{ kind: "row", label: "Continue", bars: -1, focus-id: "c:resume", focused: true }, { kind: "row", label: "Restart", bars: -1, danger: true, focus-id: "c:restart" }, { kind: "row", label: "Exit", bars: -1, danger: true, focus-id: "c:exit" }]; }
}

