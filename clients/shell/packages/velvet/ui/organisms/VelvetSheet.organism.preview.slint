export component Sort inherits VelvetPreview {
    VelvetSheet { x: 0; y: 0; width: parent.width; height: parent.height; sheet: { shown: true, title: "Sort and filter" }; rows: [{ kind: "head", label: "Sort", bars: -1 }, { kind: "row", label: "Recently played", mark: "check", bars: -1, focus-id: "o:recent", focused: true }, { kind: "row", label: "A to Z", bars: -1, focus-id: "o:title" }, { kind: "row", label: "Most played", bars: -1, focus-id: "o:mostPlayed" }, { kind: "head", label: "Show", bars: -1 }, { kind: "row", label: "Every system", mark: "check", bars: -1, focus-id: "o:all" }, { kind: "row", label: "Game Boy", value: "1", bars: -1, focus-id: "o:sys:gb" }, { kind: "row", label: "GBA", value: "2", bars: -1, focus-id: "o:sys:gba" }, { kind: "row", label: "GBC", value: "2", bars: -1, focus-id: "o:sys:gbc" }, { kind: "row", label: "Mega Drive", value: "1", bars: -1, focus-id: "o:sys:md" }, { kind: "row", label: "NES", value: "1", bars: -1, focus-id: "o:sys:nes" }, { kind: "row", label: "Nintendo 64", value: "1", bars: -1, focus-id: "o:sys:n64" }, { kind: "row", label: "Nintendo DS", value: "1", bars: -1, focus-id: "o:sys:nds" }, { kind: "row", label: "PC", value: "2", bars: -1, focus-id: "o:sys:windows" }, { kind: "row", label: "PICO-8", value: "1", bars: -1, focus-id: "o:sys:pico8" }, { kind: "row", label: "PlayStation", value: "1", bars: -1, focus-id: "o:sys:psx" }, { kind: "row", label: "SNES", value: "2", bars: -1, focus-id: "o:sys:snes" }, { kind: "row", label: "TIC-80", value: "1", bars: -1, focus-id: "o:sys:tic80" }, { kind: "row", label: "WASM-4", value: "1", bars: -1, focus-id: "o:sys:wasm4" }]; }
}

export component Menu inherits VelvetPreview {
    VelvetSheet { x: 0; y: 0; width: parent.width; height: parent.height; sheet: { shown: true, title: "Menu" }; rows: [{ kind: "row", label: "Find games", mark: "more", bars: -1, focus-id: "m:store", focused: true }, { kind: "row", label: "Settings", mark: "more", bars: -1, focus-id: "m:settings" }, { kind: "row", label: "Wi-Fi", value: "hummingbird-lake", mark: "more", bars: -1, focus-id: "m:wifi" }, { kind: "row", label: "Identity and backup", mark: "more", bars: -1, focus-id: "m:identity" }, { kind: "head", label: "This device", bars: -1 }, { kind: "row", label: "Allow controllers", note: "Lets Korri read every connected gamepad", bars: -1, focus-id: "m:a:controllers-permission" }, { kind: "row", label: "Restart Korri", bars: -1, focus-id: "m:a:restart-korri" }, { kind: "row", label: "Sleep", note: "Not while a game is running", bars: -1, dim: true, focus-id: "m:a:sleep" }, { kind: "row", label: "Power off", bars: -1, danger: true, focus-id: "m:a:power-off" }]; }
}

