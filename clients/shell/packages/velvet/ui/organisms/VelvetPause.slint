// VelvetPause: the gameplay overlay's panel. The game keeps running and
// shows through beside it (ADR 0053): a velvet panel at the left edge, never
// a full screen. In it: the game's name, a strip of facts that shows only
// here (time, battery, the stream's health, who else plays), then Korri's
// controls as rows: Resume, End, what the game's plugin offers.

import { Tokens } from "../tokens.slint";
import { Row, Fact } from "../types.slint";
import { VelvetCaps } from "../atoms/VelvetCaps.slint";
import { VelvetWords } from "../atoms/VelvetWords.slint";
import { VelvetIcon } from "../atoms/VelvetIcon.slint";
import { VelvetRows } from "VelvetRows.slint";

export component VelvetPause inherits Rectangle {
    callback activated(target: string, at: float, released: bool);
    in property <[string]> title;
    in property <length> title-size;
    in property <string> clock;
    in property <[Fact]> facts;
    in property <[Row]> rows;
    in property <bool> inert;
    // The panel's words come in a moment after the panel (and so the first view is drawn
    // more than once). A cover over them lifts; the rows themselves are never hidden, so
    // the focus is in sight from the first frame.
    property <bool> in;
    Timer {
        interval: 30ms;
        running: !root.in;
        triggered => { root.in = true; }
    }
    property <length> u: Tokens.unit;
    property <length> w: Tokens.screen.pause-w * u;
    property <length> pad-x: Math.min(Tokens.screen.pad-x * u, w * 0.1);
    property <length> pad-y: Tokens.screen.pad-y * u;
    property <length> fact: Tokens.screen.fact * u;
    // Facts two to a line.
    property <int> fact-rows: Math.ceil(facts.length / 2);
    // The head's rhythm, one step roomier than it was (owner, 2026-11-13): title to the clock,
    // the clock's line, each line of facts, and the facts to the rows.
    property <length> after-title: fact * 0.95;
    property <length> clock-pitch: fact * 2.0;
    property <length> fact-pitch: fact * 1.95;
    property <length> before-rows: fact * 1.9;
    property <length> strip-h: (clock != "" || facts.length > 0 ? clock-pitch : 0px) + fact-rows * fact-pitch;
    // A press beside the panel does nothing, and never reaches the game.
    TouchArea { }
    Rectangle {
        x: 0;
        y: 0;
        width: root.w;
        height: root.height;
        background: Tokens.velvet-94;
        Rectangle {
            x: parent.width;
            width: root.pad-x * 1.5;
            height: parent.height;
            background: @linear-gradient(90deg, Tokens.velvet-55 0%, Tokens.clear 100%);
        }
        head := VelvetCaps {
            x: root.pad-x;
            y: root.pad-y;
            width: parent.width - 2 * root.pad-x;
            lines: root.title;
            size: root.title-size;
        }
        if root.clock != "": VelvetWords {
            x: root.pad-x;
            y: root.pad-y + head.block + root.after-title;
            width: parent.width - 2 * root.pad-x;
            height: root.fact * 1.5;
            text: root.clock;
            ink: Tokens.house-light;
            strong: true;
        }
        for item[n] in root.facts: HorizontalLayout {
            x: root.pad-x + Math.mod(n, 2) * (parent.width - 2 * root.pad-x) / 2;
            y: root.pad-y + head.block + root.after-title + (root.clock != "" ? root.clock-pitch : 0px) + Math.floor(n / 2) * root.fact-pitch;
            width: (parent.width - 2 * root.pad-x) / 2 - root.fact * 0.5;
            height: root.fact * 1.5;
            spacing: root.fact * 0.45;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                VelvetIcon {
                    name: item.icon;
                    size: root.fact;
                }
            }
            VelvetWords {
                text: item.text;
                size: root.fact * 0.92;
            }
        }
        VelvetRows {
            x: root.pad-x - root.fact * 0.6;
            y: root.pad-y + head.block + root.after-title + root.before-rows - root.fact * 0.5 + root.strip-h;
            width: parent.width - 2 * root.pad-x + root.fact * 1.2;
            height: parent.height - self.y - root.pad-y;
            rows: root.rows;
            inert: root.inert;
            ground: Tokens.velvet-94;
            activated(target, at, released) => { root.activated(target, at, released); }
        }
    }
    Rectangle {
        x: 0;
        y: 0;
        width: root.w;
        height: root.height;
        background: Tokens.velvet-94;
        opacity: root.in ? 0 : 0.9;
        animate opacity { duration: Tokens.t-level; easing: ease-out; }
    }
}
