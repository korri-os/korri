// VelvetIcon: Velvet's small drawn marks, each a filled path in a 16 x 16
// box. A mark always stands beside its word; none needs a key.
//
//   clock    when it was last played        watch    how long it was played
//   here     plays on this device           peer     plays on another device
//   play     start                          resume   a session waits
//   grid     more games further in          sliders  sort and filter
//   check    the one in force               plus     get games
//   gear     settings                       menu     the house menu
//   more     one level deeper               back     one level back
//   lock     needs a key                    save     saves
//   down     a download                     note     something to read
//   key      identity                       wifi     the network
//   person   someone else                   stop     end

import { Tokens } from "../tokens.slint";
import { VelvetShape } from "VelvetShape.slint";

export component VelvetIcon inherits Rectangle {
    in property <string> name;
    in property <color> ink: Tokens.usher;
    in property <length> size: Tokens.screen.fact * Tokens.unit;
    width: size;
    height: size;
    VelvetShape {
        width: root.size;
        height: root.size;
        ink: root.ink;
        even-odd: true;
        commands: root.name == "clock" ? "M8 1.3A6.7 6.7 0 1 0 8 14.7A6.7 6.7 0 1 0 8 1.3ZM8 2.8A5.2 5.2 0 1 1 8 13.2A5.2 5.2 0 1 1 8 2.8ZM7.3 4.4H8.7V7.6L10.9 9.1L10.1 10.3L7.3 8.4Z"
            : root.name == "watch" ? "M6.2 0.9H9.8V2.3H6.2ZM8 3.2A5.8 5.8 0 1 0 8 14.8A5.8 5.8 0 1 0 8 3.2ZM8 4.7A4.3 4.3 0 1 1 8 13.3A4.3 4.3 0 1 1 8 4.7ZM7.3 6H8.7V9.7H7.3ZM12 3.4L13.1 2.3L14.1 3.3L13 4.4Z"
            : root.name == "here" ? "M4 3.6H12A2.9 2.9 0 0 1 14.9 6.5V9.5A2.9 2.9 0 0 1 12 12.4H4A2.9 2.9 0 0 1 1.1 9.5V6.5A2.9 2.9 0 0 1 4 3.6ZM4 5.1A1.4 1.4 0 0 0 2.6 6.5V9.5A1.4 1.4 0 0 0 4 10.9H12A1.4 1.4 0 0 0 13.4 9.5V6.5A1.4 1.4 0 0 0 12 5.1ZM4.9 6.5H6.1V7.4H7V8.6H6.1V9.5H4.9V8.6H4V7.4H4.9ZM10.4 6.6A0.8 0.8 0 1 0 12 6.6A0.8 0.8 0 1 0 10.4 6.6ZM9.2 8.6A0.8 0.8 0 1 0 10.8 8.6A0.8 0.8 0 1 0 9.2 8.6Z"
            : root.name == "peer" ? "M2.6 2.2H13.4A1.4 1.4 0 0 1 14.8 3.6V10.2A1.4 1.4 0 0 1 13.4 11.6H8.7V13H10.8V14.4H5.2V13H7.3V11.6H2.6A1.4 1.4 0 0 1 1.2 10.2V3.6A1.4 1.4 0 0 1 2.6 2.2ZM2.7 3.7V10.1H13.3V3.7Z"
            : root.name == "play" ? "M4.3 2.4V13.6L13.4 8Z"
            : root.name == "resume" ? "M8 1.3A6.7 6.7 0 1 0 8 14.7A6.7 6.7 0 1 0 8 1.3ZM8 2.8A5.2 5.2 0 1 1 8 13.2A5.2 5.2 0 1 1 8 2.8ZM6.5 5.2V10.8L11 8Z"
            : root.name == "grid" ? "M2 2H5.4V5.4H2ZM6.3 2H9.7V5.4H6.3ZM10.6 2H14V5.4H10.6ZM2 6.3H5.4V9.7H2ZM6.3 6.3H9.7V9.7H6.3ZM10.6 6.3H14V9.7H10.6ZM2 10.6H5.4V14H2ZM6.3 10.6H9.7V14H6.3ZM10.6 10.6H14V14H10.6Z"
            : root.name == "sliders" ? "M2 3.8H3.9A1.7 1.7 0 0 1 7.1 3.8H14V5.2H7.1A1.7 1.7 0 0 1 3.9 5.2H2ZM2 7.3H8.9A1.7 1.7 0 0 1 12.1 7.3H14V8.7H12.1A1.7 1.7 0 0 1 8.9 8.7H2ZM2 10.8H4.9A1.7 1.7 0 0 1 8.1 10.8H14V12.2H8.1A1.7 1.7 0 0 1 4.9 12.2H2Z"
            : root.name == "check" ? "M2.3 8.6L3.7 7.2L6.3 9.7L12.4 3.6L13.8 5L6.3 12.5Z"
            : root.name == "plus" ? "M7.1 2.6H8.9V7.1H13.4V8.9H8.9V13.4H7.1V8.9H2.6V7.1H7.1Z"
            : root.name == "gear" ? "M8 5.2A2.8 2.8 0 1 0 8 10.8A2.8 2.8 0 1 0 8 5.2ZM8 6.6A1.4 1.4 0 1 1 8 9.4A1.4 1.4 0 1 1 8 6.6ZM7.3 1.2H8.7V3.6H7.3ZM7.3 12.4H8.7V14.8H7.3ZM1.2 7.3H3.6V8.7H1.2ZM12.4 7.3H14.8V8.7H12.4ZM2.7 3.7L3.7 2.7L5.4 4.4L4.4 5.4ZM10.6 11.6L11.6 10.6L13.3 12.3L12.3 13.3ZM2.7 12.3L4.4 10.6L5.4 11.6L3.7 13.3ZM10.6 4.4L12.3 2.7L13.3 3.7L11.6 5.4Z"
            : root.name == "menu" ? "M2 3.4H14V5H2ZM2 7.2H14V8.8H2ZM2 11H14V12.6H2Z"
            : root.name == "more" ? "M5.4 2.6L6.6 1.4L13.2 8L6.6 14.6L5.4 13.4L10.8 8Z"
            : root.name == "back" ? "M10.6 2.6L9.4 1.4L2.8 8L9.4 14.6L10.6 13.4L5.2 8Z"
            : root.name == "lock" ? "M4.6 6.6V5A3.4 3.4 0 0 1 11.4 5V6.6H12.6V14H3.4V6.6ZM6 6.6H10V5A2 2 0 0 0 6 5Z"
            : root.name == "save" ? "M2.4 2.4H11.2L13.6 4.8V13.6H2.4ZM3.9 3.9V12.1H12.1V5.4L10.6 3.9H10.2V6.8H5V3.9ZM6.4 3.9V5.4H8.8V3.9ZM5.2 8.6H10.8V12.1H5.2Z"
            : root.name == "down" ? "M7.2 1.8H8.8V8.6L11.3 6.1L12.4 7.2L8 11.6L3.6 7.2L4.7 6.1L7.2 8.6ZM2.4 12.6H13.6V14.2H2.4Z"
            : root.name == "note" ? "M8 1.3A6.7 6.7 0 1 0 8 14.7A6.7 6.7 0 1 0 8 1.3ZM8 2.8A5.2 5.2 0 1 1 8 13.2A5.2 5.2 0 1 1 8 2.8ZM7.2 4.3H8.8V8.9H7.2ZM7.2 10.1H8.8V11.7H7.2Z"
            : root.name == "key" ? "M5.2 4.4A3.6 3.6 0 1 0 8.6 9.2H10.2V10.8H11.8V9.2H13V10.8H14.6V7.6H8.6A3.6 3.6 0 0 0 5.2 4.4ZM5.2 6.5A1.5 1.5 0 1 1 5.2 9.5A1.5 1.5 0 1 1 5.2 6.5Z"
            : root.name == "wifi" ? "M8 11A1.5 1.5 0 1 0 8 14A1.5 1.5 0 1 0 8 11ZM4.6 9.3L5.7 10.4A3.3 3.3 0 0 1 10.3 10.4L11.4 9.3A4.9 4.9 0 0 0 4.6 9.3ZM2.3 7L3.4 8.1A6.5 6.5 0 0 1 12.6 8.1L13.7 7A8.1 8.1 0 0 0 2.3 7Z"
            : root.name == "person" ? "M8 1.8A3 3 0 1 0 8 7.8A3 3 0 1 0 8 1.8ZM2.6 14.2A5.4 5.4 0 0 1 13.4 14.2Z"
            : root.name == "stop" ? "M3.4 3.4H12.6V12.6H3.4Z"
            : root.name == "again" ? "M8 2.2A5.8 5.8 0 1 1 2.5 9.8L4 9.3A4.2 4.2 0 1 0 5 5.1L6.6 6.7H2.2V2.3L3.9 4A5.8 5.8 0 0 1 8 2.2Z"
            : "";
    }
}
