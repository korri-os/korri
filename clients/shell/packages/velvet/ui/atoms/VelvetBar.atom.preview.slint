// VelvetBar's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetBar } from "VelvetBar.slint";

export component Half inherits VelvetPreview {
    VelvetBar { x: parent.width * 0.2; y: parent.height / 2; width: parent.width * 0.6; share: 0.5; }
}

export component Full inherits VelvetPreview {
    VelvetBar { x: parent.width * 0.2; y: parent.height / 2; width: parent.width * 0.6; share: 1; }
}

export component Started inherits VelvetPreview {
    VelvetBar { x: parent.width * 0.2; y: parent.height / 2; width: parent.width * 0.6; share: 0.04; }
}

export component UnderWay inherits VelvetPreview {
    VelvetBar { x: parent.width * 0.2; y: parent.height / 2; width: parent.width * 0.6; travels: true; }
}
