// VelvetIcon's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetIcon } from "VelvetIcon.slint";

export component Clock inherits VelvetPreview {
    VelvetIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: self.size; height: self.size; name: "clock"; ink: Tokens.house-light; size: Math.min(parent.width, parent.height) * 0.3; }
}

