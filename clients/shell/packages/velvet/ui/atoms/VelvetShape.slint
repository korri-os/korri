// VelvetShape: one filled path in a box of its own units. Every drawn mark
// and every part of a no-art card is one of these; the shell's renderer
// turns nothing, so a slant is already in the path's coordinates.

import { Tokens } from "../tokens.slint";

export component VelvetShape inherits Path {
    in property <brush> ink: Tokens.house-light;
    in property <float> box-w: 16;
    in property <float> box-h: 16;
    in property <bool> even-odd;
    fill: ink;
    fill-rule: even-odd ? FillRule.evenodd : FillRule.nonzero;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: box-w;
    viewbox-height: box-h;
    clip: false;
}
