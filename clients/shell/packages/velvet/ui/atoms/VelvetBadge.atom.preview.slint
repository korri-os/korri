// VelvetBadge's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetBadge } from "VelvetBadge.slint";

export component Short inherits VelvetPreview {
    VelvetBadge { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "GBA"; }
}

export component Long inherits VelvetPreview {
    VelvetBadge { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "Nintendo 64"; }
}
