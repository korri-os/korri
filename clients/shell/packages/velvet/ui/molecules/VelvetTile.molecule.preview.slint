// VelvetTile's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetTile } from "VelvetTile.slint";

export component Poster inherits VelvetPreview {
    VelvetTile { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: self.height * Tokens.tile-ratio; height: parent.height * 0.7; tile: { shown: true, kind: "game", art-kind: "poster", art: @image-url("../../preview/art/poster-ember.png"), poster: { shown: true, drawing: 82, palette: 47, lines: ["EMBER", "ROAD"], size: 17.73, ink: 14732216 }, label: "Ember Road", badge: "PC" };  }
}

export component PosterFocused inherits VelvetPreview {
    VelvetTile { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: self.height * Tokens.tile-ratio; height: parent.height * 0.7; tile: { shown: true, kind: "game", art-kind: "poster", art: @image-url("../../preview/art/poster-ember.png"), poster: { shown: true, drawing: 82, palette: 47, lines: ["EMBER", "ROAD"], size: 17.73, ink: 14732216 }, label: "Ember Road", lit: true, badge: "PC", focused: true };  }
}

