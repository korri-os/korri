// VelvetPoster's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetPoster } from "VelvetPoster.slint";

export component Card1 inherits VelvetPreview {
    VelvetPoster { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: self.height * Tokens.tile-ratio; height: parent.height * 0.8; poster: { shown: true, drawing: 82, palette: 47, lines: ["EMBER", "ROAD"], size: 11.102, ink: 14732216 }; }
}

