// VelvetPoster: the no-art card (src/poster.ts). A paper field, the parts of
// a machine or a pattern, and the title in the display face, in a 60 x 90
// box that this scales to the tile. The drawing is the package's own data
// (ui/drawings.slint, made at build time); the logic says which one, gives
// the card its sixteen colours and fits its title.
// It stands in every tile that has no picture, and under every picture
// until the picture arrives (ADR 0065).

import { Tokens } from "../tokens.slint";
import { Poster } from "../types.slint";
import { Drawings, Drawing, DrawingLayer } from "../drawings.slint";
import { VelvetShape } from "../atoms/VelvetShape.slint";
import { VelvetCaps } from "../atoms/VelvetCaps.slint";

export component VelvetPoster inherits Rectangle {
    in property <Poster> poster;
    // One card unit, in px.
    property <length> u: self.width / Tokens.card-w;
    clip: true;
    // The drawing, from the package's data: its layers, each in a colour of the card's palette.
    property <Drawing> drawing: Drawings.drawings[poster.drawing];
    for i in root.drawing.count: VelvetShape {
        property <DrawingLayer> layer: Drawings.layers[root.drawing.start + i];
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        box-w: Tokens.card-w;
        box-h: Tokens.card-h;
        commands: self.layer.path;
        ink: Tokens.tint(Drawings.colours[root.poster.palette * Drawings.palette-length + self.layer.slot]);
        opacity: self.layer.opacity;
        even-odd: self.layer.even-odd;
    }
    // The title stands on its box's foot, or hangs from its top.
    title := VelvetCaps {
        x: root.drawing.title-x * root.u;
        y: root.drawing.top ? root.drawing.title-y * root.u : (root.drawing.title-y + root.drawing.title-h) * root.u - self.block;
        width: root.drawing.title-w * root.u + root.u;
        lines: root.poster.lines;
        size: root.poster.size * root.u;
        ink: Tokens.tint(root.poster.ink);
    }
}
