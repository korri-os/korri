// VelvetRow's preview states, with data from Velvet's scenarios.
// Written by preview/previews.ts; do not edit by hand.

import { Tokens } from "../tokens.slint";
import { VelvetPreview } from "../preview-frame.slint";
import { VelvetRow } from "VelvetRow.slint";

export component Focused inherits VelvetPreview {
    VelvetRow { x: Tokens.screen.pad-x * Tokens.unit; y: parent.height / 2 - self.height / 2; width: Math.min(parent.width - 2 * self.x, Tokens.screen.page-w * Tokens.unit); it: { kind: "row", label: "Name", value: "mini", note: "What other devices call this one", mark: "more", focus-id: "s:device-name", focused: true }; }
}

export component Rest inherits VelvetPreview {
    VelvetRow { x: Tokens.screen.pad-x * Tokens.unit; y: parent.height / 2 - self.height / 2; width: Math.min(parent.width - 2 * self.x, Tokens.screen.page-w * Tokens.unit); it: { kind: "row", label: "Name", value: "mini", note: "What other devices call this one", mark: "more", focus-id: "s:device-name" }; }
}

export component Head inherits VelvetPreview {
    VelvetRow { x: Tokens.screen.pad-x * Tokens.unit; y: parent.height / 2 - self.height / 2; width: Math.min(parent.width - 2 * self.x, Tokens.screen.page-w * Tokens.unit); it: { kind: "head", label: "Device", mark: "none" }; }
}

export component Range inherits VelvetPreview {
    VelvetRow { x: Tokens.screen.pad-x * Tokens.unit; y: parent.height / 2 - self.height / 2; width: Math.min(parent.width - 2 * self.x, Tokens.screen.page-w * Tokens.unit); it: { kind: "range", label: "Volume", value: "60", mark: "none", share: 0.6, tier: "minor", focus-id: "c:volume" }; }
}

export component Network inherits VelvetPreview {
    VelvetRow { x: Tokens.screen.pad-x * Tokens.unit; y: parent.height / 2 - self.height / 2; width: Math.min(parent.width - 2 * self.x, Tokens.screen.page-w * Tokens.unit); it: { kind: "row", label: "hummingbird-lake", value: "Connected", mark: "check", signal: true, bars: 3, focus-id: "w:net:ap-hummingbird" }; }
}

export component Secret inherits VelvetPreview {
    VelvetRow { x: Tokens.screen.pad-x * Tokens.unit; y: parent.height / 2 - self.height / 2; width: Math.min(parent.width - 2 * self.x, Tokens.screen.page-w * Tokens.unit); it: { kind: "row", label: "SteamGridDB API key", value: "Configured", note: "Sent only to www.steamgriddb.com.", mark: "lock", focus-id: "s:plugin-credential:@korri:steamgriddb" }; }
