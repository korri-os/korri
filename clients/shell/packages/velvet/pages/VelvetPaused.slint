// VelvetPaused: the gameplay overlay. The game is the stage and keeps
// running; Velvet's panel stands at its left edge with Korri's controls.

import { Tokens } from "../ui/tokens.slint";
import { Row, Readout } from "../ui/types.slint";
import { VelvetPause } from "../ui/organisms/VelvetPause.slint";

export component VelvetPaused inherits Rectangle {
    callback activated(target: string, at: float, released: bool);
    in property <[string]> title;
    in property <length> title-size;
    in property <string> clock;
    in property <[Readout]> readouts;
    in property <[Row]> rows;
    in property <bool> inert;
    VelvetPause {
        width: parent.width;
        height: parent.height;
        title: root.title;
        title-size: root.title-size;
        clock: root.clock;
        readouts: root.readouts;
        rows: root.rows;
        inert: root.inert;
        activated(target, at, released) => { root.activated(target, at, released); }
    }
}
