// M0 is a diagnostic screen, not a second surface package or launch path.
export component AndroidM0 inherits Window {
    title: "Korri";
    background: #182b40;
    default-font-family: "sans-serif";
    in property <string> app-version;
    in property <string> brain-status: "Checking korrid…";
    VerticalLayout {
        padding: min(24px, min(root.width, root.height) / 12);
        spacing: min(16px, root.height / 24);
        alignment: center;
        Text {
            text: "Korri";
            color: #f4f8fc;
            font-size: min(48px, root.height / 5);
            font-weight: 700;
        }
        Text {
            text: "Version " + root.app-version;
            color: #c3d4e6;
            font-size: 18px;
            wrap: word-wrap;
        }
        Text {
            text: root.brain-status;
            color: #f4f8fc;
            font-size: 20px;
            wrap: word-wrap;
        }
    }
}
