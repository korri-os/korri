+    // unchanged file once; a file that changed on disk is registered again.
+    let metadata = std::fs::metadata(&requested_path)?;
+    let identity = (metadata.len(), metadata.modified().ok());
+    let unchanged = REGISTERED_FONT_FILES.with(|files| {
+        files.borrow().get(&requested_path).is_some_and(|known| *known == identity)
+    });
+    if unchanged {
+        return Ok(());
+    }
+    let contents = std::fs::read(&requested_path)?;
     collection.register_fonts(contents.into(), None);
+    REGISTERED_FONT_FILES.with(|files| files.borrow_mut().insert(requested_path, identity));
