+
+        struct Pool(alloc::vec::Vec<(Layout, alloc::vec::Vec<*mut u8>)>);
+
+        impl Drop for Pool {
+            fn drop(&mut self) {
+                for (layout, free) in self.0.drain(..) {
+                    for ptr in free {
+                        // Safety: allocated with this layout and not in use.
+                        unsafe { alloc::alloc::dealloc(ptr, layout) };
+                    }
+                }
+            }
+        }
