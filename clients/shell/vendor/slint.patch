+    window_adapter: Weak<WinitWindowAdapter>,
+    timer: Rc<Timer>,
+}
+
+impl PacedWinitFrameThrottle {
+    fn create(window_adapter: Weak<WinitWindowAdapter>) -> Box<dyn FrameThrottle> {
+        Box::new(Self { window_adapter, timer: Rc::new(Timer::default()) })
+    }
