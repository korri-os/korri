+    // The interpreter registers a file's imported fonts every time a component is created.
+    // Registering the same unchanged file again would add another copy of its faces, and
+    // SWASH_FONTS above keeps every registered blob alive for the life of the thread, so a
+    // program that creates components repeatedly would grow without bound. Register each
+    // unchanged file once; a file that changed on disk is registered again.
+    let metadata = std::fs::metadata(&requested_path)?;
