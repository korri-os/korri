+                } else if (*source).cutoff.tracker && !(*source).dirty.get() {
+                    if sources_changed(source) {
+                        (*source).dirty.set(true);
+                        (*source).cutoff.maybe.set(false);
+                        return true;
+                    }
+                    (*source).cutoff.maybe.set(false);
+                } else {
