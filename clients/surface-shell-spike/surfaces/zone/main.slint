// THROWAWAY SPIKE: Zone's GAMES page, Modern look, as a surface package
// the shell loads at run time (../../CONTRACT.md). Pure .slint: no Rust, no
// callbacks, no keys. Every value it shows arrives as a property from
// logic.ts's view(); every size, colour and motion is decided here.
//
// The plan is a function of the window's width and height alone, ported
// from clients/zone-native-spike/src/plan.rs (itself from Zone's
// src/plan/art-px.ts, zone-select.ts, top-strip.ts and the stylesheets).
// The ground's rings and dots follow surfaces/zone/src/plan/ground.ts.
//
// Frame cost (README.md): the rings are two bordered Rectangles that never
// move. Each frame only the three dots (small disc Paths) and the cursor
// triangles move, so the software renderer redraws only small rectangles
// around them. Everything else changes only when a property changes.

import "fonts/Anton-latin.ttf";

// ---- Zone's palette (src/zone-tokens.css) ----
global Z {
    out property <color> mint: #4ad39c;
    out property <color> black: #000000;
    out property <color> white: #f7f3f7;
    out property <color> yellow: #f7db08;
    out property <color> hud-edge: #3151ad;
    out property <color> blue: #5a71e7;
    out property <color> orange: #f78e18;
    out property <color> red: #e70000;
    out property <color> pink: #ce6584;
    out property <color> shade: #2e9e72;
    out property <color> track: #3a313a;
    out property <color> banner-blue: #0020b5;
    out property <color> banner-yellow: #f7db00;
    out property <color> banner-white: #e7e3e7;
    out property <color> green: #18a800;
    out property <color> key-disc: #292029;
    out property <color> key-b: #ef285a;
    out property <color> key-a: #639f3d;
    out property <color> ring-a: #39b2ce;
    out property <color> ring-b: #f78e18;
    out property <color> stripe-light: #9ce7c6;
    out property <color> stripe-teal: #5aa2b5;
    out property <color> inert: #84a2b5;

    // An SVG point from two lengths, for Path commands in local px.
    public pure function pt(x: length, y: length) -> string {
        return (x / 1px) + " " + (y / 1px);
    }
}

// ---- What logic.ts's view() hands over ----

export struct Tab {
    label: string,
    active: bool,
    focused: bool,
}

export struct Hints {
    back: string,
    confirm: string,
}

export struct Tag {
    label: string,
    // system, here, remote, continue, download
    kind: string,
    // Korri's names keep their own case; Zone's words are capitals.
    korri: bool,
}

export struct Card {
    title: string,
    art: image,
    has-art: bool,
    initials: string,
    stripes: int,
    tags: [Tag],
}

export struct Fact {
    label: string,
    value: string,
    known: bool,
}

export struct Act {
    label: string,
    lit: bool,
    focused: bool,
}

export struct Signal {
    shown: bool,
    name: string,
    korri: bool,
    bars: int,
    strength: string,
}

// ---- Drawing pieces ----

// One copy of a run of words, `dx`, `dy` from the face.
component Layer inherits Text {
    font-family: "Anton";
    vertical-alignment: top;
}

// Measures words at a cap height, without drawing them.
component Measure inherits Text {
    in property <length> cap;
    visible: false;
    width: 0;
    height: 0;
    font-family: "Anton";
    font-size: cap * 2048 / 1760;
}

// Words as Zone's caps draw them in the Modern look. y is the top of the
// cap, x its left (or the box's left). Anton is sized so its cap (1760 of
// 2048 units) is `cap` tall (zone-fonts.css size-adjust). Each ink is its
// own component, its copies written out: a frame walks every item, so a
// word carries no wrapper or repeater it does not draw.
//   Caps      white face (or HUD: yellow), ring and one-step drop
//   TagCaps   white face, one-art-px black ring
//   FlatCaps  one flat ink, no edge
//   BannerCaps  yellow face, black ring, orange two-step drop, white band
component Words {
    in property <string> text;
    in property <length> cap: 20px;
    in property <length> a: 2px;
    // The box the words stand in: their natural width (0) or this width.
    in property <length> box: 0px;
    in property <bool> centre: false;
    in property <bool> elide: false;
    in property <bool> wrap: false;
    out property <length> natural: measure.preferred-width;
    out property <length> size: cap * 2048 / 1760;
    out property <length> above: cap * 649 / 1760;
    out property <length> line: size * 3083 / 2048;
    out property <length> text-w: box > 0 ? box : natural + cap;
    out property <length> text-h: wrap ? line * 8 : line;
    out property <TextHorizontalAlignment> align: centre ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    out property <TextOverflow> cut: elide ? TextOverflow.elide : TextOverflow.clip;
    out property <TextWrap> wrapping: wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
    out property <float> spacing: wrap ? 0.8 : 1;
    // Lines 1.4 caps apart: the renderer centres each glyph run in its
    // shortened line, so the first line's cap moves back down by half the cut.
    out property <length> lead: wrap ? (1 - spacing) * line / 2 : 0;
    width: box > 0 ? box : natural;
    height: cap;
    measure := Measure {
        text: root.text;
        cap: root.cap;
    }
    @children
}

component Caps inherits Words {
    in property <bool> hud: false;
    property <color> edge: hud ? Z.hud-edge : Z.black;
    // The one-step drop, then the ring: all eight neighbours, one art px out.
    Layer {
        x: 2 * root.a;
        y: 0 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 2 * root.a;
        y: 1 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 2 * root.a;
        y: 2 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 1 * root.a;
        y: 2 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 0 * root.a;
        y: 2 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: -1 * root.a;
        y: -1 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 0 * root.a;
        y: -1 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 1 * root.a;
        y: -1 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: -1 * root.a;
        y: 0 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: 1 * root.a;
        y: 0 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
        overflow: root.cut;
        wrap: root.wrapping;
        line-height-factor: root.spacing;
    }
    Layer {
        x: -1 * root.a;
        y: 1 * root.a - root.above + root.lead;
        width: root.text-w;
        height: root.text-h;
        text: root.text;
        font-size: root.size;
        color: root.edge;
        horizontal-alignment: root.align;
