# THROWAWAY BENCHMARK: Zone's TypeScript update in QuickJS (rquickjs 0.14).
#
#   nix build --impure --expr 'let pkgs = import (builtins.getFlake (toString ./.)).inputs.nixpkgs { system = "aarch64-linux"; }; in pkgs.callPackage ./clients/zone-native-spike/logic-bench/package.nix {}'
#
# zone-logic.js is generated by bun from harness.ts (README.md) and
# committed, so this build needs no JavaScript toolchain.
{ pkgs }:
let
  lib = pkgs.lib;
in
pkgs.rustPlatform.buildRustPackage {
  pname = "zone-logic-bench";
  version = "0.0.0";
  src = lib.fileset.toSource {
    root = ./.;
    fileset = lib.fileset.unions [
      ./Cargo.toml
      ./Cargo.lock
      ./src
      ./zone-logic.js
    ];
  };
  cargoLock.lockFile = ./Cargo.lock;
  meta = {
    description = "THROWAWAY BENCHMARK: Zone's TypeScript update timed inside QuickJS";
    mainProgram = "zone-logic-bench";
    platforms = lib.platforms.linux;
  };
}
