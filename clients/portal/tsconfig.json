{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@types/bun"],
    "paths": {
      "@contracts/*": ["../../contracts/*"],
      "@korri/shift": ["../../surfaces/shift/src/index.ts"],
      "@korri/pico": ["../../surfaces/pico/src/index.ts"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../contracts",
    "../../surfaces/shift/src",
    "../../surfaces/pico/src"
  ]
}
