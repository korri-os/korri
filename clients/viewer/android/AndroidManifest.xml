<?xml version="1.0" encoding="utf-8"?>
<!-- The Rust viewer, slice D1 of #391 step D. Android's own NativeActivity
     loads libkorri_viewer_android.so; the APK has no Java (hasCode="false").
     Only the shell user and the system can start it (the DUMP permission):
     it connects where its starting intent says. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.simonwjackson.korri.viewer"
    android:versionCode="1"
    android:versionName="0.1.0">
    <!-- ADR 0064: Android 12. The target matches the Artemis app's. -->
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Korri viewer"
        android:hasCode="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="korri_viewer_android" />
        </activity>
    </application>
</manifest>
