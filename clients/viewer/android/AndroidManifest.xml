<?xml version="1.0" encoding="utf-8"?>
<!-- The Rust viewer, #391 step D. Android's own NativeActivity loads
     libkorri_viewer_android.so; the APK has no Java (hasCode="false").
     The activity connects where its starting intent says, so a caller needs
     the DUMP permission to start it: the shell user and the system, a
     privileged app that holds DUMP, and any app that asks for DUMP and is
     granted it through adb (pm grant). Other apps are refused. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.simonwjackson.korri.viewer"
    android:versionCode="1"
    android:versionName="0.1.0">
    <!-- ADR 0064: Android 12. The target matches the Artemis app's. -->
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No backup: the app's files hold a client key pair and a frame record. -->
    <application
        android:label="Korri viewer"
        android:hasCode="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- A finished stream leaves no entry in Recents to start it again. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask"
            android:autoRemoveFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="korri_viewer_android" />
        </activity>
    </application>
</manifest>
