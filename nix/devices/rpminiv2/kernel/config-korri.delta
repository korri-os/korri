# Product = the full ROCKNIX 20260901 Mini V2 `config` plus these changes.
# Per-game CPU utilization clamps, owned by the launch-limits helper.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
# Regenerate config-korri with derive-config-korri.py. The build checks the
# resolved configuration against this contract before compiling the kernel.
# Owner-approved toolchain probes (2026-09-30, carried 2026-10-18): Nix GCC 15.3 / Binutils 2.46.
CONFIG_CC_VERSION_TEXT="aarch64-unknown-linux-gnu-gcc (GCC) 15.3.0"
CONFIG_GCC_VERSION=150300
CONFIG_AS_VERSION=24600
CONFIG_LD_VERSION=24600
CONFIG_PAHOLE_VERSION=131
# Binutils 2.46 supports LSUI assembly; CONFIG_ARM64_LSUI stays disabled.
CONFIG_AS_HAS_LSUI=y
# CONFIG_ARM64_LSUI is not set
# Kernel cross compiler has no userspace linker in its configure environment.
# CONFIG_CC_CAN_LINK is not set
# ROCKNIX export carries inactive embedded-initramfs fields with SOURCE="".
# NixOS passes a separate initrd; usr/Kconfig removes these fields.
# CONFIG_INITRAMFS_ROOT_UID is not set
# CONFIG_INITRAMFS_ROOT_GID is not set
# CONFIG_INITRAMFS_COMPRESSION_GZIP is not set
# NixOS firewall and signed plugin host iptables-nft rules.
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
# Selected by NFT_REJECT/INET and XT_TARGET_LOG with IPv6 iptables built in.
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NF_LOG_IPV6=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
# NO_IOPORT_MAP cannot be enabled with PCI on ARM64 (arch/arm64/Kconfig).
# Retain PCI for the QCA6390 radio rather than copying the obsolete trim value.
# CONFIG_NO_IOPORT_MAP is not set
# Preserve the observed composite ACM serial console beside NCM. Enabling
# configfs ACM also selects these two dependencies built in (kernel .config).
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
# Internal UFS holds Android, the Retroid loader and the Qualcomm boot chain.
# The ROCKNIX host driver stays built in so the product can boot from an
# internal root (owner request, 2026-10-01). The UFS BSG node stays off, so
# userspace has no path for UFS query requests that change provisioning,
# boot-LUN selection or other device attributes.
# CONFIG_SCSI_UFS_BSG is not set
# PMIC RTC remains enabled from ROCKNIX, by owner choice on 2026-09-26.
# Its first runtime load set 2066 before NTP corrected the clock.
# Issue #314: a hang left no kernel record. The kernel answered ping while
# userspace and the journal stopped, and nothing reached disk. These detectors
# report tasks stuck in D state and CPUs stuck in kernel code. They only print
# by default; panic stays a runtime sysctl choice. DEBUG_KERNEL only makes the
# "Debug Oops, Lockups and Hangs" menu visible (lib/Kconfig.debug).
CONFIG_DEBUG_KERNEL=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
# Resolved with the two detectors: the 120 s default timeout, report-only
# panic defaults (0), the shared lockup core, and the mutex/semaphore blocker
# report that names the task holding the lock a hung task waits on.
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=0
CONFIG_LOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK_BLOCKER=y
# DEBUG_KERNEL turns these on by default. Keep them off, so the menu switch
# adds no other debug code and no RCU tracepoints. DEBUG_INFO_NONE is the
# visible form of the unchanged "no debug info" choice.
# CONFIG_DEBUG_MISC is not set
# CONFIG_RCU_TRACE is not set
CONFIG_DEBUG_INFO_NONE=y
# Kernel log to the build host over the USB network link (usb0), with no
# userspace and no disk on the path. Configured at runtime through configfs.
# NETCONSOLE selects NETPOLL; NETCONSOLE_DYNAMIC selects PRINTK_EXECUTION_CTX.
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_NETPOLL=y
CONFIG_NET_POLL_CONTROLLER=y
CONFIG_PRINTK_EXECUTION_CTX=y
