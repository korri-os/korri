Subject: [PATCH] drm/sun4i: disable DE33 planes before stopping TCON

Adapt the native plane-disable and pre-TCON commit shape from Jernej
Skrabec's fix b3664d8d5ac63b823ab79c613ca579ddabe4a26a, carried by
LibreELEC.tv packaging revision
12207af344a0de3341243325bd8400df043fd81d.
Do not import that stack's RCQ interfaces or DE3 DBUFF polling.

The standard tail disables TCON before clearing detached planes. For
all-H616-DE33 devices, clear the old CRTC's owned channels and commit while
TCON still runs, then wait for a native vblank before stopping it.
This orders retirement without changing mapping or buffer-release policy.
An unsuccessful wait is reported and normal shutdown still completes.

Supply NULL-safe UI/VI disable callbacks for the native old-plane helper.
Normal active flips and non-DE33 shutdown sequencing stay unchanged.
No diagnostic readbacks, extra counter samples, reset or bypass change.

diff --git a/drivers/gpu/drm/sun4i/sun4i_crtc.c b/drivers/gpu/drm/sun4i/sun4i_crtc.c
--- a/drivers/gpu/drm/sun4i/sun4i_crtc.c
+++ b/drivers/gpu/drm/sun4i/sun4i_crtc.c
@@ -108,10 +108,22 @@
 static void sun4i_crtc_atomic_disable(struct drm_crtc *crtc,
 				      struct drm_atomic_commit *state)
 {
+	struct drm_crtc_state *old_state = drm_atomic_get_old_crtc_state(state, crtc);
 	struct drm_encoder *encoder = sun4i_crtc_get_encoder(crtc);
 	struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(crtc);
 
 	DRM_DEBUG_DRIVER("Disabling the CRTC\n");
+
+	if (sun4i_crtc_uses_early_planes(crtc) && old_state->active) {
+		int ret;
+
+		/* Disable fetchers while their timing consumer still runs. */
+		drm_atomic_helper_disable_planes_on_crtc(old_state, false);
+		sunxi_engine_commit(scrtc->engine, crtc, state);
+		ret = drm_crtc_wait_one_vblank(crtc);
+		if (ret)
+			drm_err(crtc->dev, "DE33 scanout stop wait failed: %d\n", ret);
+	}
 
 	drm_crtc_vblank_off(crtc);
 
diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
@@ -186,6 +186,14 @@
 }
 
 
+static void sun8i_ui_layer_atomic_disable(struct drm_plane *plane,
+					  struct drm_atomic_commit *state)
+{
+	struct sun8i_layer *layer = plane_to_sun8i_layer(plane);
+
+	sun8i_ui_layer_disable(layer);
+}
+
 static void sun8i_ui_layer_atomic_update(struct drm_plane *plane,
 					 struct drm_atomic_commit *state)
 {
@@ -206,6 +214,7 @@
 static const struct drm_plane_helper_funcs sun8i_ui_layer_helper_funcs = {
 	.atomic_check	= sun8i_ui_layer_atomic_check,
 	.atomic_update	= sun8i_ui_layer_atomic_update,
+	.atomic_disable	= sun8i_ui_layer_atomic_disable,
 };
 
 static const struct drm_plane_funcs sun8i_ui_layer_funcs = {
diff --git a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
@@ -265,6 +265,14 @@
 						   true, true);
 }
 
+static void sun8i_vi_layer_atomic_disable(struct drm_plane *plane,
+					  struct drm_atomic_commit *state)
+{
+	struct sun8i_layer *layer = plane_to_sun8i_layer(plane);
+
+	sun8i_vi_layer_disable(layer);
+}
+
 static void sun8i_vi_layer_atomic_update(struct drm_plane *plane,
 					 struct drm_atomic_commit *state)
 {
@@ -286,6 +294,7 @@
 static const struct drm_plane_helper_funcs sun8i_vi_layer_helper_funcs = {
 	.atomic_check	= sun8i_vi_layer_atomic_check,
 	.atomic_update	= sun8i_vi_layer_atomic_update,
+	.atomic_disable	= sun8i_vi_layer_atomic_disable,
 };
 
 static const struct drm_plane_funcs sun8i_vi_layer_funcs = {
