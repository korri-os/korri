Subject: [PATCH] drm/sun4i: program H616 DE33 planes before enabling scanout

A display-only off/on cycle on H700 reproduces DE IOMMU faults at the
retired framebuffer address. The RPM tail skips inactive plane updates
and restarts TCON across panel preparation before replacing that address.

Use the standard commit order only when all bound engines are H616 DE33.
Their mixer clocks remain enabled during CRTC off. Keep the RPM order for
other engines. Defer modeset events until vblank is on so pre-enable plane
programming does not acquire a failed vblank reference or send an early
enable completion. Preserve the normal active flip path.

Both H616 mixer nodes use the existing de33-mixer-0 compatible. No IOMMU
bypass, new engine interface, or buffer retention is needed.

diff --git a/drivers/gpu/drm/sun4i/sun4i_framebuffer.c b/drivers/gpu/drm/sun4i/sun4i_framebuffer.c
--- a/drivers/gpu/drm/sun4i/sun4i_framebuffer.c
+++ b/drivers/gpu/drm/sun4i/sun4i_framebuffer.c
@@ -6,6 +6,8 @@
  * Maxime Ripard <maxime.ripard@free-electrons.com>
  */
 
+#include <linux/of.h>
+
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_blend.h>
@@ -13,6 +15,7 @@
 
 #include "sun4i_drv.h"
 #include "sun4i_framebuffer.h"
+#include "sunxi_engine.h"
 
 static int sun4i_de_atomic_check(struct drm_device *dev,
 				 struct drm_atomic_commit *state)
@@ -40,8 +43,15 @@
 	.atomic_commit_tail	= drm_atomic_helper_commit_tail_rpm,
 };
 
+static const struct drm_mode_config_helper_funcs sun4i_de_early_plane_helpers = {
+	.atomic_commit_tail	= drm_atomic_helper_commit_tail,
+};
+
 void sun4i_framebuffer_init(struct drm_device *drm)
 {
+	struct sun4i_drv *drv = drm->dev_private;
+	struct sunxi_engine *engine;
+
 	drm_mode_config_reset(drm);
 
 	drm->mode_config.max_width = 8192;
@@ -49,4 +59,18 @@
 
 	drm->mode_config.funcs = &sun4i_de_mode_config_funcs;
 	drm->mode_config.helper_private = &sun4i_de_mode_config_helpers;
+
+	/* DE33 registers stay accessible with TCON off. Replace retired
+	 * plane addresses before enabling scanout across panel preparation.
+	 * The tail is device-wide: do not reorder unrelated engines.
+	 */
+	if (list_empty(&drv->engine_list))
+		return;
+
+	list_for_each_entry(engine, &drv->engine_list, list)
+		if (!of_device_is_compatible(engine->node,
+					     "allwinner,sun50i-h616-de33-mixer-0"))
+			return;
+
+	drm->mode_config.helper_private = &sun4i_de_early_plane_helpers;
 }
diff --git a/drivers/gpu/drm/sun4i/sun4i_crtc.c b/drivers/gpu/drm/sun4i/sun4i_crtc.c
--- a/drivers/gpu/drm/sun4i/sun4i_crtc.c
+++ b/drivers/gpu/drm/sun4i/sun4i_crtc.c
@@ -60,6 +60,15 @@
 	return ret;
 }
 
+/* Follow the selected device-wide order, not an individual engine. */
+static bool sun4i_crtc_uses_early_planes(struct drm_crtc *crtc)
+{
+	const struct drm_mode_config_helper_funcs *helpers =
+		crtc->dev->mode_config.helper_private;
+
+	return helpers->atomic_commit_tail == drm_atomic_helper_commit_tail;
+}
+
 static void sun4i_crtc_atomic_begin(struct drm_crtc *crtc,
 				    struct drm_atomic_commit *state)
 {
@@ -70,7 +79,11 @@
 	struct sunxi_engine *engine = scrtc->engine;
 	unsigned long flags;
 
-	if (crtc->state->event) {
+	/* A modeset enables vblank after early plane programming. */
+	if (crtc->state->event &&
+	    !(sun4i_crtc_uses_early_planes(crtc) &&
+	      (!crtc->state->active ||
+	       drm_atomic_crtc_needs_modeset(crtc->state)))) {
 		WARN_ON(drm_crtc_vblank_get(crtc) != 0);
 
 		spin_lock_irqsave(&dev->event_lock, flags);
@@ -93,11 +106,17 @@
 
 	sunxi_engine_commit(scrtc->engine, crtc, state);
 
+	/* Keep an enable event for atomic_enable, where vblank is on. */
+	if (sun4i_crtc_uses_early_planes(crtc) && crtc->state->active &&
+	    drm_atomic_crtc_needs_modeset(crtc->state))
+		return;
+
 	if (event) {
 		crtc->state->event = NULL;
 
 		spin_lock_irq(&crtc->dev->event_lock);
-		if (drm_crtc_vblank_get(crtc) == 0)
+		if ((!sun4i_crtc_uses_early_planes(crtc) ||
+		     crtc->state->active) && drm_crtc_vblank_get(crtc) == 0)
 			drm_crtc_arm_vblank_event(crtc, event);
 		else
 			drm_crtc_send_vblank_event(crtc, event);
@@ -137,6 +156,16 @@
 	sun4i_tcon_set_status(scrtc->tcon, encoder, true);
 
 	drm_crtc_vblank_on(crtc);
+
+	if (sun4i_crtc_uses_early_planes(crtc) && crtc->state->event) {
+		spin_lock_irq(&crtc->dev->event_lock);
+		if (drm_crtc_vblank_get(crtc) == 0)
+			scrtc->event = crtc->state->event;
+		else
+			drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+		spin_unlock_irq(&crtc->dev->event_lock);
+	}
 }
 
 static void sun4i_crtc_mode_set_nofb(struct drm_crtc *crtc)
