Subject: [PATCH DEBUG] capture first DE fault, GEM retirement and address readback

Temporary diagnostic only. No DMA, permission, prefetch, reset or release
policy change. Capture the first DE fault before normal recovery and emit
its preallocated record afterwards. The bounded test keeps the platform
domain attached; CPU table snapshots are not atomic with map/unmap.

H616 manual page260 defines L1/L2 error-data registers at0x170/0x174.
Existing DRM debug controls bound the GEM lifetime/address records to the
short off/on test. A temporary root-only read-only debugfs file snapshots
raw error registers without acknowledging them. Remove all diagnostics
before landing.

diff --git a/drivers/iommu/sun50i-iommu.c b/drivers/iommu/sun50i-iommu.c
--- a/drivers/iommu/sun50i-iommu.c
+++ b/drivers/iommu/sun50i-iommu.c
@@ -6,6 +6,7 @@
 #include <linux/bug.h>
 #include <linux/clk.h>
 #include <linux/device.h>
+#include <linux/debugfs.h>
 #include <linux/dma-direction.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
@@ -21,6 +22,7 @@
 #include <linux/pm.h>
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
+#include <linux/seq_file.h>
 #include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
@@ -71,6 +73,8 @@
 #define IOMMU_INT_ERR_ADDR_L1_REG	0x130
 #define IOMMU_INT_ERR_ADDR_L2_REG	0x134
 #define IOMMU_INT_ERR_DATA_REG(i)	(0x150 + (i) * 4)
+#define IOMMU_INT_ERR_DATA_L1_REG	0x170
+#define IOMMU_INT_ERR_DATA_L2_REG	0x174
 #define IOMMU_L1PG_INT_REG		0x0180
 #define IOMMU_L2PG_INT_REG		0x0184
 
@@ -97,6 +101,15 @@
 
 #define SPAGE_SIZE			4096
 
+struct sun50i_fault_snapshot {
+	bool captured, pending, cpu_available;
+	phys_addr_t iova;
+	dma_addr_t dt_dma;
+	u32 status, l1_status, l2_status, master_data, l1_data, l2_data;
+	u32 dte, dte_sibling, pte, pte_sibling;
+	u32 ttb, enable, bypass, prefetch;
+};
+
 struct sun50i_iommu {
 	struct iommu_device iommu;
 
@@ -110,6 +123,7 @@
 
 	struct iommu_domain *domain;
 	struct kmem_cache *pt_pool;
+	struct sun50i_fault_snapshot diagnostic;
 };
 
 struct sun50i_iommu_domain {
@@ -868,6 +882,51 @@
 				      unsigned master, phys_addr_t iova,
 				      unsigned prot)
 {
+	/* The controlled test keeps this platform domain attached. Capture
+	 * only its first DE fault; emit after normal recovery below.
+	 */
+	if (master == 0 && !iommu->diagnostic.captured) {
+		struct sun50i_fault_snapshot *snapshot = &iommu->diagnostic;
+
+		snapshot->captured = true;
+		snapshot->pending = true;
+		snapshot->iova = iova;
+		snapshot->status = iommu_read(iommu, IOMMU_INT_STA_REG);
+		snapshot->l1_status = iommu_read(iommu, IOMMU_L1PG_INT_REG);
+		snapshot->l2_status = iommu_read(iommu, IOMMU_L2PG_INT_REG);
+		snapshot->master_data = iommu_read(iommu, IOMMU_INT_ERR_DATA_REG(0));
+		snapshot->l1_data = iommu_read(iommu, IOMMU_INT_ERR_DATA_L1_REG);
+		snapshot->l2_data = iommu_read(iommu, IOMMU_INT_ERR_DATA_L2_REG);
+		snapshot->ttb = iommu_read(iommu, IOMMU_TTB_REG);
+		snapshot->enable = iommu_read(iommu, IOMMU_ENABLE_REG);
+		snapshot->bypass = iommu_read(iommu, IOMMU_BYPASS_REG);
+		snapshot->prefetch = iommu_read(iommu, IOMMU_TLB_PREFETCH_REG);
+		if (iommu->domain &&
+		    iommu->domain != &sun50i_iommu_identity_domain) {
+			struct sun50i_iommu_domain *domain =
+				to_sun50i_domain(iommu->domain);
+			u32 *directory = READ_ONCE(domain->dt);
+			u32 index = sun50i_iova_get_dte_index(iova);
+
+			if (directory) {
+				snapshot->cpu_available = true;
+				snapshot->dt_dma = domain->dt_dma;
+				snapshot->dte = READ_ONCE(directory[index]);
+				snapshot->dte_sibling = READ_ONCE(directory[index ^ 1]);
+				if (sun50i_dte_is_pt_valid(snapshot->dte)) {
+					u32 *table;
+
+					table = phys_to_virt(
+						sun50i_dte_get_pt_address(snapshot->dte));
+
+					index = sun50i_iova_get_pte_index(iova);
+					snapshot->pte = READ_ONCE(table[index]);
+					snapshot->pte_sibling = READ_ONCE(table[index ^ 1]);
+				}
+			}
+		}
+	}
+
 	dev_err(iommu->dev, "Page fault for %pad (master %d, dir %s)\n",
 		&iova, master, (prot == IOMMU_FAULT_WRITE) ? "wr" : "rd");
 
@@ -962,6 +1021,7 @@
 {
 	u32 status, l1_status, l2_status, resets;
 	struct sun50i_iommu *iommu = dev_id;
+	bool emit;
 
 	spin_lock(&iommu->iommu_lock);
 
@@ -991,14 +1051,66 @@
 	iommu_write(iommu, IOMMU_RESET_REG, ~resets);
 	iommu_write(iommu, IOMMU_RESET_REG, IOMMU_RESET_RELEASE_ALL);
 
+	emit = iommu->diagnostic.pending;
+	iommu->diagnostic.pending = false;
 	spin_unlock(&iommu->iommu_lock);
 
+	if (emit) {
+		const struct sun50i_fault_snapshot *snapshot = &iommu->diagnostic;
+
+		dev_err(iommu->dev,
+			"[DEBUG-h700-dma] iova=%pad sta=%#x l1=%#x l2=%#x data0=%#x data_l1=%#x data_l2=%#x cpu_available=%u dte=%#x dte_pair=%#x pte=%#x pte_pair=%#x sw_ttb=%pad hw_ttb=%#x enable=%#x bypass=%#x prefetch=%#x\n",
+			&snapshot->iova, snapshot->status, snapshot->l1_status,
+			snapshot->l2_status, snapshot->master_data, snapshot->l1_data,
+			snapshot->l2_data, snapshot->cpu_available, snapshot->dte,
+			snapshot->dte_sibling, snapshot->pte, snapshot->pte_sibling,
+			&snapshot->dt_dma, snapshot->ttb, snapshot->enable,
+			snapshot->bypass, snapshot->prefetch);
+	}
+
 	return IRQ_HANDLED;
 }
 
+static int sun50i_diagnostic_show(struct seq_file *file, void *unused)
+{
+	struct sun50i_iommu *iommu = file->private;
+	unsigned long flags;
+	u32 status, l1, l2, address, l1_address, l2_address;
+	u32 data, l1_data, l2_data, prefetch;
+
+	if (!iommu->domain || iommu->domain == &sun50i_iommu_identity_domain) {
+		seq_puts(file, "No attached paging domain\n");
+		return 0;
+	}
+	spin_lock_irqsave(&iommu->iommu_lock, flags);
+	status = iommu_read(iommu, IOMMU_INT_STA_REG);
+	l1 = iommu_read(iommu, IOMMU_L1PG_INT_REG);
+	l2 = iommu_read(iommu, IOMMU_L2PG_INT_REG);
+	address = iommu_read(iommu, IOMMU_INT_ERR_ADDR_REG(0));
+	l1_address = iommu_read(iommu, IOMMU_INT_ERR_ADDR_L1_REG);
+	l2_address = iommu_read(iommu, IOMMU_INT_ERR_ADDR_L2_REG);
+	data = iommu_read(iommu, IOMMU_INT_ERR_DATA_REG(0));
+	l1_data = iommu_read(iommu, IOMMU_INT_ERR_DATA_L1_REG);
+	l2_data = iommu_read(iommu, IOMMU_INT_ERR_DATA_L2_REG);
+	prefetch = iommu_read(iommu, IOMMU_TLB_PREFETCH_REG);
+	spin_unlock_irqrestore(&iommu->iommu_lock, flags);
+	seq_printf(file,
+		   "sta=%#x l1=%#x l2=%#x addr0=%#x addr_l1=%#x addr_l2=%#x data0=%#x data_l1=%#x data_l2=%#x prefetch=%#x\n",
+		   status, l1, l2, address, l1_address, l2_address,
+		   data, l1_data, l2_data, prefetch);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sun50i_diagnostic);
+
+static void sun50i_diagnostic_remove(void *entry)
+{
+	debugfs_remove(entry);
+}
+
 static int sun50i_iommu_probe(struct platform_device *pdev)
 {
 	struct sun50i_iommu *iommu;
+	struct dentry *diagnostic;
 	int ret, irq;
 
 	iommu = devm_kzalloc(&pdev->dev, sizeof(*iommu), GFP_KERNEL);
@@ -1056,6 +1168,12 @@
 	if (ret < 0)
 		goto err_unregister;
 
+	diagnostic = debugfs_create_file("h700-iommu-fault-registers", 0400,
+					 NULL, iommu, &sun50i_diagnostic_fops);
+	ret = devm_add_action_or_reset(&pdev->dev, sun50i_diagnostic_remove,
+				      diagnostic);
+	if (ret)
+		dev_warn(&pdev->dev, "Temporary diagnostic file unavailable\n");
 	return 0;
 
 err_unregister:
