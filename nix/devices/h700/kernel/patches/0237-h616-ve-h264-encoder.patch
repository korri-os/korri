+/*
+ * IRQ banks are device facts, not properties read through an unpinned ctx.
+ * H.264 and VP8 share the same decoder bank and IRQ bit definitions.
+ */
+static const struct cedrus_irq_bank {
+	u32 control;
+	u32 status;
+	u32 irq_mask;
+	u32 status_mask;
+	u32 capabilities;
+} cedrus_irq_banks[CEDRUS_JOB_KINDS] = {
+	[CEDRUS_JOB_MPEG_DEC] = {
+		VE_DEC_MPEG_CTRL, VE_DEC_MPEG_STATUS,
+		VE_DEC_MPEG_CTRL_IRQ_MASK, VE_DEC_MPEG_STATUS_CHECK_MASK,
+		CEDRUS_CAPABILITY_MPEG2_DEC,
+	},
+	[CEDRUS_JOB_H264_DEC] = {
+		VE_H264_CTRL, VE_H264_STATUS,
+		VE_H264_CTRL_INT_MASK, VE_H264_STATUS_INT_MASK,
+		CEDRUS_CAPABILITY_H264_DEC | CEDRUS_CAPABILITY_VP8_DEC,
+	},
+	[CEDRUS_JOB_H265_DEC] = {
+		VE_DEC_H265_CTRL, VE_DEC_H265_STATUS,
+		VE_DEC_H265_CTRL_IRQ_MASK, VE_DEC_H265_STATUS_CHECK_MASK,
+		CEDRUS_CAPABILITY_H265_DEC,
+	},
+	[CEDRUS_JOB_AVC_ENC] = { 0xb14, 0xb1c, 0xf, 7, 0 },
+};
+
+static bool cedrus_irq_bank_present(struct cedrus_dev *dev, unsigned int kind)
+{
+	if (kind == CEDRUS_JOB_AVC_ENC)
+		return dev->has_avc_enc;
+	return dev->capabilities & cedrus_irq_banks[kind].capabilities;
+}
+
+static void cedrus_irq_mask_ack(struct cedrus_dev *dev, unsigned int kind)
+{
+	const struct cedrus_irq_bank *b = &cedrus_irq_banks[kind];
+
+	lockdep_assert_held(&dev->job_lock);
+	cedrus_write(dev, b->control, cedrus_read(dev, b->control) & ~b->irq_mask);
+	cedrus_write(dev, b->status, b->status_mask);
+	cedrus_read(dev, b->status); /* Flush W1C before returning a level-high IRQ. */
+}
+
+static void cedrus_irq_quiesce(struct cedrus_dev *dev)
+{
+	unsigned int kind;
+
+	for (kind = CEDRUS_JOB_MPEG_DEC; kind < CEDRUS_JOB_KINDS; kind++)
+		if (cedrus_irq_bank_present(dev, kind))
+			cedrus_irq_mask_ack(dev, kind);
+}
+
+u64 cedrus_job_prepare(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	enum cedrus_job_kind kind;
+	unsigned long flags;
+	u64 sequence;
+
+	if (ctx->enc) {
+		kind = CEDRUS_JOB_AVC_ENC;
+	} else {
+		switch (ctx->src_fmt.pixelformat) {
+		case V4L2_PIX_FMT_MPEG2_SLICE:
+			kind = CEDRUS_JOB_MPEG_DEC;
+			break;
+		case V4L2_PIX_FMT_H264_SLICE:
+		case V4L2_PIX_FMT_VP8_FRAME:
+			kind = CEDRUS_JOB_H264_DEC;
+			break;
+		case V4L2_PIX_FMT_HEVC_SLICE:
+			kind = CEDRUS_JOB_H265_DEC;
+			break;
+		default:
+			return 0;
+		}
+	}
+	/*
+	 * A previous IRQ may have won while its watchdog callback was already
+	 * running. Drain that callback before publishing a new sequence. This
+	 * is process context; neither completion path waits for device_run.
+	 */
+	cancel_delayed_work_sync(&dev->watchdog_work);
+	spin_lock_irqsave(&dev->job_lock, flags);
+	cedrus_irq_quiesce(dev);
+	sequence = ++dev->job_sequence;
+	dev->job_kind = kind;
+	dev->job_ctx = ctx;
+	dev->job_owner = CEDRUS_JOB_PREPARING;
+	spin_unlock_irqrestore(&dev->job_lock, flags);
+	return sequence;
+}
