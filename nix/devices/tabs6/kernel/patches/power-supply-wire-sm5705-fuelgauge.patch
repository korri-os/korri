diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index bcfa63fb9..f627dc19a 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -801,6 +801,16 @@ config BATTERY_GOLDFISH
 	  driver. Originated in the Android Studio Emulator (goldfish) it is
 	  going to be used in other emulators.
 
+config BATTERY_SM5705
+	tristate "Silicon Mitus SM5705 fuel gauge"
+	depends on I2C
+	help
+	  Say Y here to enable support for the fuel gauge in the Silicon
+	  Mitus SM5705, as fitted to the Samsung Galaxy Tab S6.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sm5705_fuelgauge.
+
 config BATTERY_RT5033
 	tristate "RT5033 fuel gauge support"
 	depends on I2C
