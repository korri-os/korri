diff --git a/drivers/usb/typec/Kconfig b/drivers/usb/typec/Kconfig
--- a/drivers/usb/typec/Kconfig
+++ b/drivers/usb/typec/Kconfig
@@ -1,5 +1,14 @@
 # SPDX-License-Identifier: GPL-2.0
 
+config TYPEC_S2MM005_READ_ONLY
+	tristate "Galaxy Tab S6 read-only s2mm005 data-role policy"
+	depends on TYPEC && I2C && OF && USB_ROLE_SWITCH
+	help
+	  Read only the s2mm005 and SM5705 status registers on Galaxy Tab S6.
+	  Select the host data role only while sinking power with three fresh
+	  qualifying samples. Never send PD commands or control VBUS.
+	  The module is called s2mm005.
+
 menuconfig TYPEC
 	tristate "USB Type-C Support"
 	help
diff --git a/drivers/usb/typec/Makefile b/drivers/usb/typec/Makefile
--- a/drivers/usb/typec/Makefile
+++ b/drivers/usb/typec/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_TYPEC_S2MM005_READ_ONLY) += s2mm005.o
 obj-$(CONFIG_TYPEC)		+= typec.o
 typec-y				:= class.o mux.o bus.o pd.o retimer.o mode_selection.o
 typec-$(CONFIG_ACPI)		+= port-mapper.o
