# Korri product delta on top of tabs6.config. The console kernel does not
# carry it. Every line must survive olddefconfig unchanged; default.nix fails
# the build if one does not.

# InputPlumber and inputd create their virtual controllers through uinput,
# and InputPlumber reads controller HID reports through hidraw.
CONFIG_INPUT_UINPUT=y
CONFIG_HIDRAW=y
# BlueZ hands Bluetooth LE controllers (HOGP) to the kernel through uhid.
CONFIG_UHID=m

# USB gamepads on the USB-C port (host role, tabs6-usb-role). HID gamepads
# already work through hid-generic; Xbox pads need xpad, and the vendor HID
# drivers give the controllers InputPlumber has profiles for their full
# button and stick maps.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m

# Hardware video encode for Sunshine: the Venus core through the Iris driver
# (media-iris-sm8150-legacy-vpu5.patch) and its clock controller. The venus
# driver is off: SM8150 is not one of its platforms.
CONFIG_SM_VIDEOCC_8150=y
CONFIG_VIDEO_QCOM_IRIS=m
# CONFIG_VIDEO_QCOM_VENUS is not set

# Read-only s2mm005 data-role owner; never configures PD or VBUS.
CONFIG_TYPEC_S2MM005_READ_ONLY=m
