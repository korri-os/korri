# tabs6 additions on top of gts6lwifi_defconfig-full (the 6.12 config that
# booted Fedora in upstream/gts6l-mainline-linux). Every line here must survive
# olddefconfig unchanged; nix/kernel/default.nix fails the build if one does not.

# Release string is exactly the kernel version, so modDirVersion matches.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# Boot: Project Mu UEFI -> systemd-boot -> EFI-stub Image. The command line
# comes from the boot entry, never from the kernel.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_CMDLINE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y

# Console on the panel only (console=tty0). A serial console with no cable
# attached blocks every later printk (docs/UFS.md), so no UART can become a
# console. SERIAL_QCOM_GENI itself stays: Bluetooth (hci_qca) rides on it.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
# CONFIG_SERIAL_QCOM_GENI_CONSOLE is not set
# CONFIG_SERIAL_MSM_CONSOLE is not set

# rtc-efi claims rtc0 and cannot be read here; rtc-pm8xxx is the clock (docs/SLEEP.md).
# CONFIG_RTC_DRV_EFI is not set

# Swap: zram with zstd. Without an explicit backend Kconfig forces LZO.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_SWAP=y

# NixOS requirements (system.requiredKernelConfig in nixpkgs: systemd.nix,
# stage-1.nix, kernel.nix, swap.nix, systemd-boot.nix, etc-activation.nix,
# zram-generator.nix).
CONFIG_MODULES=y
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
# IPv6 is bool in 7.3; the port's 6.12 config had it as a module.
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_DMIID=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
# NixOS installs firmware zstd-compressed (hardware.firmwareCompression).
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Root on ext4 (userdata) and the ESP on vfat (cache) mount without an initrd module.
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Tailscale and the NixOS firewall (docs/DAILY_DRIVER.md: no policy routing and
# no nf_tables in the 6.12 config). nixpkgs iptables is the nft backend.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_CT=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_DUP_IPV4=m
CONFIG_NFT_DUP_IPV6=m
CONFIG_NF_NAT=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_IP_NF_MATCH_RPFILTER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_NAT=m
CONFIG_TUN=y
# Legacy iptables: the NixOS firewall in nix/system uses the iptables legacy backend.
# Since 6.17 the legacy tables sit behind their own switch.
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NF_LOG_SYSLOG=m

# No initrd (nix/system/modules/boot.nix): root=PARTLABEL=userdata is resolved
# by the kernel, and the USB lifeline (configfs gadget: RNDIS + ACM on DWC3)
# comes up before any module can load. Everything on that path is built in.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_FAT_FS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# The SS PHY was a module in the port (TYPEC=m caps it). Built in, so DWC3
# never waits for a module before the gadget binds.
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_U_SERIAL=y

# iwd does its crypto through AF_ALG and the kernel keyring and refuses to
# start without these (iwd's own startup check). Built in, so nothing waits on
# a crypto-* module autoload. PKCS8 and MD4 are for EAP-TLS and MSCHAPv2.
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA512=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# Native display: MDSS/DPU, bonded DSI 0+1 with the 7nm PHY, and the panel
# (drivers/panel-samsung-ana38401.c). msm itself stays a module.
CONFIG_SM_DISPCC_8250=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_SAMSUNG_ANA38401=m

# Ported drivers (nix/kernel/drivers, patches/*-wire-*.patch). The mic codec is
# the upstream CS48L32 driver (patches/cs48l32-accept-cs48l33.patch).
CONFIG_TOUCHSCREEN_FTS1BA90A=y
CONFIG_BATTERY_SM5705=y
CONFIG_SND_SOC_CS48L32=m
# The four CS35L41 speaker amps on Secondary TDM (AUDIO.md section 5). Without
# the codec driver the sm8250 card defers forever ("codec dai not found").
CONFIG_SND_SOC_CS35L41_I2C=m
