// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device tree for the AISLPC R36T Max handheld.
 *
 * Copyright (c) 2026 Simon W. Jackson
 *
 * Written against mainline conventions so it can be submitted upstream, and
 * usable as-is if it never is. Values come from the running device: the
 * display controller for panel timings, resolved phandles from the vendor
 * device tree for GPIO assignments, and measured SDIO behaviour for the
 * Wi-Fi bus. Nothing is copied from the vendor tree's structure, which is a
 * generic Rockchip EVB with board nodes grafted onto it.
 *
 * Closest upstream relative is rk3326-anbernic-rg351m.dtsi: same SoC, same
 * RK817 PMIC, same I2S interface, same SD card wiring. Where this board
 * agrees with it, it deliberately says the same thing.
 *
 * The PMIC is declared as RK817, not identified by a silicon ID read.
 * The regulator table is not a verbatim vendor copy: vcc7's input and
 * BOOST's voltage constraints differ. The vendor also declares mixed
 * RK809/RK817 regulator nodes. See PANEL-PMIC-AUDIT.md for exact Linux
 * 6.12.63 matches, source differences and unresolved electrical routes.
 *
 * Unresolved, and deliberately absent rather than guessed:
 *
 *  - Analog sticks. ROCKNIX uses a GPIO-controlled multiplexer feeding
 *    SARADC channel 1, not four independent ADC inputs. Mux enable wiring,
 *    physical axis mapping and calibration still need hardware acceptance.
 *    The 17 GPIO game buttons below do not implement analog movement.
 *  - Battery/charger profile and amplifier electrical characteristics.
 *    The source-grounded speaker route below is not audible acceptance.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3326.dtsi"

/ {
	model = "AISLPC R36T Max";
	compatible = "aislpc,r36t-max", "rockchip,rk3326";

	aliases {
		mmc0 = &sdmmc;
	};

	/*
	 * Persistent crash log. The stock firmware reserves this exact region
	 * for the same purpose, so it is memory the boot chain already treats
	 * as off limits, and a log written here survives the one-second
	 * panic reboot into the next kernel's /sys/fs/pstore.
	 *
	 * On a board with no console, this is the console. Keep it even after
	 * a wire exists; it costs 960 KB.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@110000 {
			compatible = "ramoops";
			reg = <0x0 0x110000 0x0 0xf0000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x50000>;
			max-reason = <5>;
		};
	};

	chosen {
		/*
		 * UART5, not the UART2 that most RK3326 boards use. The stock
		 * kernel is started with earlycon at 0xff178000, which is
		 * UART5 on this SoC. Boards in this clone family share the
		 * wiring; ROCKNIX retunes its DDR blob for the same reason.
		 */
		stdout-path = "serial5:1500000n8";
	};

	/*
	 * Buttons only, using Linux's native gpio-keys-polled binding and
	 * default device identity (no joystick name/product ID).
	 * GPIO/code pairs, 10 ms polling and btn_pins come from ROCKNIX:
	 * distribution@697d112a64e442e79e3d27b064351d917657301a,
	 * projects/ROCKNIX/devices/RK3326/linux/dts/rockchip/
	 * rk3326-gameconsole-eeclone.dts:166-265,819-841.
	 * Saved vendor rg42t.dts corroborates pins/polarity, not key codes;
	 * see README.md for its hash and the 19-versus-18 count discrepancy.
	 * Keep native 5 ms debounce; neither it nor the source labels are
	 * physical acceptance. Exclude volume PD2/PD3 and all mux/motor pins.
	 */
	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins>;
		poll-interval = <10>;

		button-up {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
		};

		button-down {
			gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
		};

		button-left {
			gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
		};

		button-right {
			gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "GPIO DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
		};

		button-a {
			gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
			label = "GPIO KEY BTN-A";
			linux,code = <BTN_EAST>;
		};

		button-b {
			gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-B";
			linux,code = <BTN_SOUTH>;
		};

		button-y {
			gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-Y";
			linux,code = <BTN_WEST>;
		};

		button-x {
			gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-X";
			linux,code = <BTN_NORTH>;
		};

		button-thumbl {
			gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_THUMBL";
			linux,code = <BTN_THUMBL>;
		};

		button-thumbr {
			gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_THUMBR";
			linux,code = <BTN_THUMBR>;
		};

		button-fn {
			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_FN";
			linux,code = <BTN_MODE>;
		};

		button-tl {
			gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "GPIO TOP-LEFT";
			linux,code = <BTN_TL>;
		};

		button-tr {
			gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "GPIO TOP-RIGHT";
			linux,code = <BTN_TR>;
		};

		button-select {
			gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_SELECT";
			linux,code = <BTN_SELECT>;
		};

		button-tr2 {
			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "GPIO TOP-RIGHT2";
			linux,code = <BTN_TR2>;
		};

		button-tl2 {
			gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "GPIO TOP-LEFT2";
			linux,code = <BTN_TL2>;
		};

		button-start {
			gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN_START";
			linux,code = <BTN_START>;
		};
	};

	/*
	 * The vendor backlight has no power-supply property. Its electrical
	 * feed is unresolved; PWM1 identifies brightness control only.
	 * SWITCH_REG2 is an RK809 descriptor, not a missing RK817 descriptor.
	 * Do not add a supply reference without evidence of the board route.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 25000 0>;
	};

	/*
	 * Vendor panel power-supply resolves to this GPIO0 PB5 fixed rail.
	 * The vendor declares neither voltage constraints nor vin-supply;
	 * the 1.8 V value and vcc_3v0 input below are not verified by that
	 * record. Preserve the current setup pending electrical evidence.
	 */
	vcc18_lcd_n: regulator-vcc18-lcd-n {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
		regulator-name = "vcc18_lcd_n";
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v0>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	/*
	 * Ring lights around both analog sticks.
	 *
	 * Held on deliberately. This board's panel does not work yet and its USB
	 * port has produced no gadget, so the rings are the only thing it can
	 * say out loud. The regulator core switches this on during its own init,
	 * which is early: rings lit means the kernel got at least that far.
	 *
	 * Drop always-on once there is a real console and something owns the
	 * LEDs.
	 */
	vcc_led: regulator-vcc-led {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio2 RK_PA1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&led_vcc_en>;
		regulator-name = "vcc_led";
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_3v0>;
	};

	vccsys: regulator-vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&cru SCLK_WIFI_PMU>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <100>;
		/*
		 * The vendor tree declares this active-high. On a mainline
		 * kernel that inverts what mmc-pwrseq-simple asserts, and the
		 * June bring-up measured the result directly: active-high
		 * stopped SDIO enumerating at all, reporting
		 * "mmc2: Failed to initialize a non-removable card".
		 * Active-low enumerates, downloads firmware, and associates.
		 */
		reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
	};

	/*
	 * ROCKNIX distribution@697d112a64e442e79e3d27b064351d917657301a,
	 * rk3326-gameconsole-eeclone.dts:292-330,896-900. Vendor rg42t.dts
	 * spk-con-gpio corroborates GPIO3 PA7 active-high. No measured gain
	 * or controllable supply is known; do not invent either. The card now
	 * depends on the simple-amplifier auxiliary component probing.
	 */
	spk_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&spk_amp_enable_h>;
		pinctrl-names = "default";
		sound-name-prefix = "Speaker Amp";
	};

	rk817-sound {
		compatible = "simple-audio-card";
		simple-audio-card,aux-devs = <&spk_amp>;
		simple-audio-card,name = "rk817_int";
		simple-audio-card,format = "i2s";
		simple-audio-card,hp-det-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_HIGH>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphones",
			"Speaker", "Internal Speakers";
		/* Route both amp channels: an unconnected output can keep DRV on. */
		simple-audio-card,routing =
			"MICL", "Mic Jack",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Internal Speakers", "Speaker Amp OUTL",
			"Internal Speakers", "Speaker Amp OUTR",
			"Speaker Amp INL", "HPOL",
			"Speaker Amp INR", "HPOR";
		simple-audio-card,pin-switches = "Internal Speakers";

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};

		simple-audio-card,cpu {
			sound-dai = <&i2s1_2ch>;
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

&display_subsystem {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	ports {
		mipi_out: port@1 {
			reg = <1>;

			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};

	/*
	 * 720x720 at 61 Hz on a 50 MHz pixel clock, four DSI lanes. Read
	 * from the display controller while the stock system was running:
	 *
	 *   Display mode: 720x720p61  clk[50000]
	 *   H: 720 860 940 1080       V: 720 740 744 764
	 *
	 * Note that /sys/class/graphics/fb0 reports 680x680 on the stock
	 * system. That is the plane, inset 20 px inside the display, not the
	 * panel.
	 *
	 * NOT UPSTREAMABLE AS WRITTEN. This node drives ROCKNIX's
	 * data-driven panel driver, carried out of tree, with the description
	 * the community generator produced from this unit's stock dtb. It is
	 * here because seven boots of mainline's ST7703 driver with this
	 * glass's own sequence, timings and phase left the panel white, and
	 * this description draws on this exact unit under ROCKNIX. With a
	 * working screen in hand, the ST7703 entry can be made right and this
	 * node can use the candidate only after its supply binding, error
	 * cleanup and transaction schedule are checked on hardware.
	 *
	 * The description's lines: G is geometry, delays
	 * (prepare,reset,init,enable,ready), format, lanes and DSI flags.
	 * The ready delay is unused by the carried driver. M is a display
	 * mode; default=1 marks the preferred mode. I is one DCS write as
	 * hex. Its wait is also hex: 250 means 592 ms; 50 means 80 ms.
	 * The driver then adds display-on, sleep-out and 120 ms. Keep this
	 * schedule; source comparison does not establish minimum timing.
	 */
	panel: panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		iovcc-supply = <&vcc18_lcd_n>;
		vdd-supply = <&vcc18_lcd_n>;
		panel_description =
			"G size=153,85 delays=20,20,20,120,20 format=rgb888 lanes=4 flags=0xe03",
			"M clock=50000 horizontal=720,140,80,140 vertical=720,20,4,20 default=1",
			"M clock=50000 horizontal=720,140,100,140 vertical=720,20,150,20",
			"M clock=50040 horizontal=720,140,112,140 vertical=720,20,140,20",
			"M clock=51400 horizontal=720,140,132,140 vertical=720,20,148,20",
			"M clock=50140 horizontal=720,140,90,140 vertical=720,20,40,20",
			"M clock=56900 horizontal=720,140,90,140 vertical=720,20,114,20",
			"M clock=50400 horizontal=720,140,92,140 vertical=720,20,10,20",
			"M clock=50220 horizontal=720,140,80,140 vertical=720,20,15,20",
			"M clock=54600 horizontal=720,140,112,140 vertical=720,20,57,20",
			"M clock=75450 horizontal=720,140,95,140 vertical=720,20,153,20",
			"M clock=75330 horizontal=720,140,80,140 vertical=720,20,15,20",
			"M clock=100440 horizontal=720,140,80,140 vertical=720,20,15,20",
			"I seq=b9f11283",
			"I seq=b1000000da80",
			"I seq=b23c1230",
			"I seq=b31010282803ff00000000",
			"I seq=b480",
			"I seq=b50a0a",
			"I seq=b69797",
			"I seq=b82622f013",
			"I seq=ba338105f90e0e2000000000000000442500900a0000014f01000037",
			"I seq=bc47",
			"I seq=bf021100",
			"I seq=c0737350500000127000",
			"I seq=c12500323277e4ffffcccc7777",
			"I seq=c68200bfff00ff",
			"I seq=c7b8000a000000",
			"I seq=c810401e02",
			"I seq=cc0b",
			"I seq=e0000b102c3d3f423a070d0f131513140f16000b102c3d3f423a070d0f131513140f16",
			"I seq=e307070b0b0b0b00000000ff00c010",
			"I seq=e9c8100a000080811231234f86a000470800000c00000000000c00000098028baf4602888888888898138baf5713888888888800000000000000000000000000",
			"I seq=ea970c090909780000000000009f318ba8317588888888889f208ba820648888888888230000027100000000000000000000000000000040808100000000",
			"I seq=efffff01",
			"I seq=11 wait=250",
			"I seq=29 wait=50";

		port {
			mipi_in_panel: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};
};

&dsi_dphy {
	status = "okay";
};

&gpu {
	mali-supply = <&vdd_logic>;
	status = "okay";
};

&i2c0 {
	clock-frequency = <400000>;
	i2c-scl-falling-time-ns = <16>;
	i2c-scl-rising-time-ns = <280>;
	status = "okay";

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		#clock-cells = <1>;
		clock-names = "mclk";
		clock-output-names = "rk808-clkout1", "xin32k";
		clocks = <&cru SCLK_I2S1_OUT>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&pmic_int>, <&i2s1_2ch_mclk>;
		pinctrl-names = "default";
		#sound-dai-cells = <0>;
		wakeup-source;

		vcc1-supply = <&vccsys>;
		vcc2-supply = <&vccsys>;
		vcc3-supply = <&vccsys>;
		vcc4-supply = <&vccsys>;
		vcc5-supply = <&vccsys>;
		vcc6-supply = <&vccsys>;
		vcc7-supply = <&vccsys>;
		vcc8-supply = <&vccsys>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-name = "vdd_logic";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vdd_arm: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-name = "vdd_arm";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vcc_ddr";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			/*
			 * Named vcc_3v0 by the vendor but declared as 3.3 V there.
			 * It feeds io domains 4 and 5 in both trees. The name is not
			 * a voltage measurement. Keep the existing 3.3 V constraint.
			 */
			vcc_3v0: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v0: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-name = "vcc_1v0";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vcc1v8_soc: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc1v8_soc";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcc1v0_soc: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-name = "vcc1v0_soc";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			/*
			 * 3.0 V, not the RG351M's 3.3 V. This is the PMU I/O domain
			 * supply, and pmu_io_domains configures the SoC's I/O
			 * voltage from it: the wrong number here is a wrong I/O
			 * voltage on every PMU-domain pin.
			 */
			vcc3v0_pmu: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-name = "vcc3v0_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_sd: LDO_REG6 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_sd";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			/*
			 * The three DVP rails carry the vendor's names, which do not
			 * match their voltages, because the names are what the board
			 * calls them. vcc2v8_dvp feeds io domain 1 and is always on.
			 */
			vcc2v8_dvp: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc2v8_dvp";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc1v8_dvp";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vdd1v5_dvp: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <1500000>;
				regulator-name = "vdd1v5_dvp";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1500000>;
				};
			};

			/*
			 * Vendor "boost" declares 4.8 V: dtc renders its cells as
			 * "", "I>" (00 49 3e 00). Linux 6.12.63 supports 4.7-5.4 V
			 * in 0.1 V steps. Preserve this differing constraint until
			 * the board route and operating requirements are verified.
			 */
			usb_midu: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <4900000>;
				regulator-max-microvolt = <5400000>;
				regulator-name = "usb_midu";
			};

			/*
			 * Vendor DCDC_REG5 and SWITCH_REG1/2 belong to the RK809
			 * descriptor set in Linux 6.12.63. RK817 instead has BOOST
			 * and OTG_SWITCH. Mixed vendor nodes do not prove extra
			 * silicon switches, their boot state or a backlight feed.
			 * Do not copy RK809 descriptors into rk817_reg[].
			 */
		};

		rk817_codec: codec {
			rockchip,mic-in-differential;
		};
	};
};

&i2s1_2ch {
	status = "okay";
};

/*
 * Each domain's supply is the vendor tree's resolved phandle. Domains 3
 * and 6 are 1.8 V on this board, not 3.3 V as on the RG351M; the io-domain
 * driver programs the SoC's pad voltage from these, so a wrong supply here
 * is a wrong voltage on a whole bank of pins.
 */
&io_domains {
	vccio1-supply = <&vcc2v8_dvp>;
	vccio2-supply = <&vccio_sd>;
	vccio3-supply = <&vcc1v8_soc>;
	vccio4-supply = <&vcc_3v0>;
	vccio5-supply = <&vcc_3v0>;
	vccio6-supply = <&vcc1v8_soc>;
	status = "okay";
};

&pmu_io_domains {
	pmuio1-supply = <&vcc3v0_pmu>;
	pmuio2-supply = <&vcc3v0_pmu>;
	status = "okay";
};

&pwm1 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc1v8_soc>;
	status = "okay";
};

/* SDIO, Wi-Fi only. */
&sdio {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	/*
	 * 25 MHz, not the 50 the bus is capable of. Measured: at 50 MHz the
	 * card enumerates but RK915 firmware reset times out with -110.
	 * 25 MHz holds the bus stable long enough for firmware download,
	 * reset, scan, and association.
	 */
	max-frequency = <25000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	no-mmc;
	no-sd;
	vqmmc-supply = <&vcc1v8_soc>;
	status = "okay";

	/* The prior RK915 proof and its pinned MMC patch use this property. */
	supports-rk912;
	wifi@1 {
		reg = <1>;
		interrupt-names = "host-wake";
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA5 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake>;
	};
};

&sdmmc {
	cap-sd-highspeed;
	card-detect-delay = <200>;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

&u2phy {
	status = "okay";

	u2phy_host: host-port {
		status = "okay";
	};

	u2phy_otg: otg-port {
		status = "okay";
	};
};

&usb20_otg {
	/*
	 * Peripheral, not otg. The USB-C port has no ID pin to arbitrate with,
	 * and this port's job is the recovery console: a composed NCM plus ACM
	 * gadget over the one cable, because the UART console exists only on
	 * internal pads.
	 */
	dr_mode = "peripheral";
	status = "okay";
};

&uart5 {
	status = "okay";
};

&vopb {
	status = "okay";
};

&vopb_mmu {
	status = "okay";
};

/*
 * The vibration motor, gpio3 RK_PA6, is deliberately unclaimed.
 *
 * A gpio-hog on it was the one node in this tree that neither the vendor
 * tree nor ROCKNIX's carries, and the board it was meant to quiet never
 * went quiet. A hog is applied inside the GPIO bank's own probe, at 0.1 s
 * on this board, and an error there fails the whole bank: gpio3 never
 * registers, and the panel reset, the amplifier enable and the motor line
 * all sit on it. ROCKNIX leaves the line unclaimed and its boot is silent,
 * so quiet comes from elsewhere. Find where before claiming it again.
 */

&pinctrl {
	btns {
		btn_pins: btn-pins {
			rockchip,pins =
				<2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	speaker {
		spk_amp_enable_h: spk-amp-enable-h {
			rockchip,pins = <3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		led_vcc_en: led-vcc-en {
			rockchip,pins = <2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wifi {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_host_wake: wifi-host-wake {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};
