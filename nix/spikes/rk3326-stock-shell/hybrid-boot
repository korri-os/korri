#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash util-linux coreutils
# Boot our kernel through ROCKNIX's bootloader.
#
# A bisection, not a product. Our own boot chain builds U-Boot's open PX30
# DRAM init, which no shipping RK3326 distribution uses, and a card written
# with it shows no sign of life on this board. ROCKNIX boots the same board,
# so putting our kernel behind its loader isolates which half is at fault.
#
# Three things make this work:
#
#   - ROCKNIX's loader already sits at sector 64 from swap-loader.
#   - Its U-Boot ends in `sysboot ... /extlinux/extlinux.conf` against the
#     first partition, and our image already has an unused 30 MB FAT there.
#   - Its boot.scr picks a device tree by reading an ADC pin and falls back to
#     the Odroid Go Advance tree for anything it does not recognise -- which is
#     what put a lit backlight and no picture on this board.
#
# Naming FDT explicitly in extlinux.conf does not work: that U-Boot expects
# FDTDIR plus the fdtfile its boot.scr sets, and without boot.scr fdtfile is
# never set. It wrote 'dtb load fail' to error.log on the boot partition and
# stopped.
#
# So use its convention rather than fighting it. Ship its own boot.scr, keep
# FDTDIR, and install our device tree under the name its ADC fallback asks
# for. Every path through its loader is then one it already takes on this
# board; only the bytes behind the filename are ours.
#
# The root filesystem and its own /boot are untouched; this only fills the FAT
# partition U-Boot reads first.
#
# The initrd is not optional and was missing here for several cycles. NixOS
# puts stage 1 in the initrd: it is what mounts the root filesystem by label
# and execs the init named on the command line. A kernel started without it
# panics before any of this image's own diagnostics can run, which is exactly
# what the empty flight.log said. Carry INITRD through, and do not invent a
# root= argument -- the kernel cannot resolve root=LABEL= on its own, and
# stage 1 does not need to be told.
set -euo pipefail

target=${1:-}
confirm=${2:-}
[ -n "$target" ] && [ "$confirm" = "--i-know" ] || {
  echo "usage: hybrid-boot /dev/<device> --i-know" >&2
  exit 2
}

[ -b "$target" ] || { echo "not a block device: $target" >&2; exit 1; }
[ -e "/sys/block/$(basename "$target")" ] || { echo "not a whole disk" >&2; exit 1; }
if lsblk -no MOUNTPOINT "$target" | grep -q .; then
  echo "refusing: something on $target is mounted" >&2
  exit 1
fi
size_bytes=$(blockdev --getsize64 "$target")
[ "$size_bytes" -gt 0 ] && [ "$size_bytes" -le $((128 * 1000 * 1000 * 1000)) ] || {
  echo "refusing: $target is empty or over the 128 GB cap" >&2
  exit 1
}

# Partition nodes are named sda1 on a card reader and loop0p1 on a loop
# device. Accepting both is what lets this run against the built image on a
# loop device, which is the only way to test this path without the handheld.
if [ -b "${target}1" ]; then
  part_prefix="$target"
elif [ -b "${target}p1" ]; then
  part_prefix="${target}p"
else
  echo "no first partition on $target" >&2
  exit 1
fi
boot_part="${part_prefix}1"
root_part="${part_prefix}2"
[ -b "$boot_part" ] && [ -b "$root_part" ] || {
  echo "expected two partitions on $target" >&2
  exit 1
}

work=$(mktemp -d)
bootmnt="$work/boot"
rootmnt="$work/root"
mkdir -p "$bootmnt" "$rootmnt"
cleanup() {
  mountpoint -q "$bootmnt" && umount "$bootmnt"
  mountpoint -q "$rootmnt" && umount "$rootmnt"
  rm -rf "$work"
}
trap cleanup EXIT

mount -o ro "$root_part" "$rootmnt"
mount "$boot_part" "$bootmnt"

# Read what our own extlinux entry resolved to, rather than guessing at store
# paths: the generation's config already names the kernel, the device tree,
# and the exact kernel command line.
src_conf="$rootmnt/boot/extlinux/extlinux.conf"
[ -f "$src_conf" ] || { echo "no extlinux.conf on the root partition" >&2; exit 1; }

kernel_rel=$(awk '/^[[:space:]]*LINUX/ {print $2; exit}' "$src_conf")
initrd_rel=$(awk '/^[[:space:]]*INITRD/ {print $2; exit}' "$src_conf")
fdt_rel=$(awk '/^[[:space:]]*FDT/ {print $2; exit}' "$src_conf")
append=$(awk '/^[[:space:]]*APPEND/ {sub(/^[[:space:]]*APPEND[[:space:]]+/,""); print; exit}' "$src_conf")

[ -n "$initrd_rel" ] || { echo "no INITRD in $src_conf -- refusing to boot stage 2 without stage 1" >&2; exit 1; }

kernel_src=$(readlink -f "$rootmnt/boot/extlinux/$kernel_rel")
initrd_src=$(readlink -f "$rootmnt/boot/extlinux/$initrd_rel")
fdt_src=$(readlink -f "$rootmnt/boot/extlinux/$fdt_rel")
[ -f "$kernel_src" ] || { echo "kernel not found: $kernel_rel" >&2; exit 1; }
[ -f "$initrd_src" ] || { echo "initrd not found: $initrd_rel" >&2; exit 1; }
[ -f "$fdt_src" ] || { echo "device tree not found: $fdt_rel" >&2; exit 1; }

echo "kernel: $kernel_src ($(stat -c%s "$kernel_src") bytes)"
echo "initrd: $initrd_src ($(stat -c%s "$initrd_src") bytes)"
echo "fdt:    $fdt_src ($(stat -c%s "$fdt_src") bytes)"
echo

# The command line is used exactly as the generation wrote it. It carries
# init=/nix/store/...; stage 1 mounts the root filesystem by the label in its
# own configuration.
append_fixed=$append

boot_scr=${KORRI_ROCKNIX_BOOT_SCR:-$HOME/.local/share/korri/rk3326-stock-shell/rocknix-boot.scr}
[ -f "$boot_scr" ] || { echo "missing ROCKNIX boot.scr: $boot_scr" >&2; exit 1; }

# Clear anything a previous run left, so the space check below measures the
# card as it will be rather than as it was.
rm -f "$bootmnt/Image" "$bootmnt/initrd" "$bootmnt/boot.scr" \
  "$bootmnt/error.log" "$bootmnt"/rk3326-*.dtb

# The FAT partition holds the kernel, the initrd, and one copy of the device
# tree per name below. Running out of room mid-copy leaves a card that looks
# written and boots nothing, so check first and say which knob fixes it.
dtb_bytes=$(stat -c%s "$fdt_src")
needed=$((
  $(stat -c%s "$kernel_src")
  + $(stat -c%s "$initrd_src")
  + 9 * dtb_bytes
  + $(stat -c%s "$boot_scr")
  + 65536
))
free_blocks=$(stat -f -c %a "$bootmnt")
block_size=$(stat -f -c %S "$bootmnt")
free=$((free_blocks * block_size))
if [ "$needed" -gt "$free" ]; then
  echo "boot partition too small: need $needed bytes, have $free" >&2
  echo "raise sdImage.firmwareSize in sd-image.nix and rebuild the image" >&2
  exit 1
fi

install -Dm444 "$kernel_src" "$bootmnt/Image"
install -Dm444 "$initrd_src" "$bootmnt/initrd"
install -Dm444 "$boot_scr" "$bootmnt/boot.scr"

# Every filename boot.scr can choose, all holding our device tree.
#
# One name is not enough. boot.scr reads an ADC pin and maps it to a model,
# and its ranges include a catch-all -- anything under 541 becomes
# rg351v.dtb -- so an unrecognised board does not reliably reach the
# "unexpected value" fallback. Providing only the fallback name produced
# 'dtb load fail' twice. A full ROCKNIX card never hits this because it
# ships all fifteen trees.
#
# Which name it picks is not interesting; the bytes behind every one of them
# are the same.
for name in \
  rk3326-odroid-go2.dtb \
  rk3326-odroid-go2-v11.dtb \
  rk3326-odroid-go3.dtb \
  rk3326-gameconsole-r33s.dtb \
  rk3326-gameforce-chi.dtb \
  rk3326-anbernic-rg351v.dtb \
  rk3326-anbernic-rg351m.dtb \
  rk3326-powkiddy-rgb10.dtb \
  rk3326-magicx-xu10.dtb
do
  install -Dm444 "$fdt_src" "$bootmnt/$name"
done
mkdir -p "$bootmnt/extlinux"
cat > "$bootmnt/extlinux/extlinux.conf" <<EOF
DEFAULT korri
LABEL korri
  LINUX /Image
  INITRD /initrd
  FDTDIR /
  APPEND $append_fixed
EOF

sync
echo "wrote:"
find "$bootmnt" -type f -printf '  %P  %s bytes\n' | sort
echo
echo "extlinux.conf:"
sed 's/^/  /' "$bootmnt/extlinux/extlinux.conf"
