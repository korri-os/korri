+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, ST7703_CMD_SETGAMMA, 0x00, 0x0b, 0x10,
+				     0x2c, 0x3d, 0x3f, 0x42, 0x3a, 0x07, 0x0d, 0x0f,
+				     0x13, 0x15, 0x13, 0x14, 0x0f, 0x16, 0x00, 0x0b,
+				     0x10, 0x2c, 0x3d, 0x3f, 0x42, 0x3a, 0x07, 0x0d,
