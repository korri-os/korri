+/*
+ * Read off the stock system's display controller while it was drawing:
+ * 720x720p61 at 50 MHz, porches 140/80/140 and 20/4/20. The vendor tree's
+ * timing0 says the same.
+ */
+static const struct drm_display_mode r36tmax_mode = {
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 140,
+	.hsync_end	= 720 + 140 + 80,
+	.htotal		= 720 + 140 + 80 + 140,
+	.vdisplay	= 720,
+	.vsync_start	= 720 + 20,
+	.vsync_end	= 720 + 20 + 4,
+	.vtotal		= 720 + 20 + 4 + 20,
+	.clock		= 50000,
+	.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	.width_mm	= 76,
+	.height_mm	= 76,
+};
+
+static const struct st7703_panel_desc r36tmax_desc = {
+	.mode = &r36tmax_mode,
+	.lanes = 4,
+	/*
+	 * Burst with sync pulses: the vendor's dsi,flags on this board is
+	 * 0xa03, which is VIDEO | VIDEO_BURST | VIDEO_SYNC_PULSE plus its
+	 * own bits, and the community overlay keeps both video bits.
+	 */
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+		      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM,
+	.format = MIPI_DSI_FMT_RGB888,
+	.init_sequence = r36tmax_init_sequence,
+	/*
+	 * The vendor's enable-delay-ms, also the panel-exit-sequence's own
+	 * 50 ms after display-on. Without it the DSI host switches to HS
+	 * video while the controller is still finishing display-on, and the
+	 * glass stays white behind a lit backlight.
+	 */
+	.enable_delay_ms = 120,
+};
