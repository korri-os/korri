+#[cfg(test)]
+mod device_paths_tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    #[tokio::test]
+    #[ignore = "requires an explicitly authorized off-device /dev/uinput test host"]
+    async fn identical_xbox_targets_report_only_their_own_kernel_nodes() {
+        let mut first = XBoxController::new("xb360").unwrap();
+        let mut second = XBoxController::new("xb360").unwrap();
+        let expected = first
+            .device
+            .enumerate_dev_nodes_blocking()
+            .unwrap()
+            .map(|path| path.unwrap().into_os_string().into_string().unwrap())
+            .collect::<Vec<_>>();
+        let second_paths = second.get_device_paths().unwrap();
+        let first = Mutex::new(first);
+        let mut actual = super::super::device_paths_test::query(&mut first.lock().unwrap())
+            .await
+            .unwrap();
+        let mut expected = expected;
+        expected.sort();
+        actual.sort();
+        assert!(!actual.is_empty());
+        assert!(!second_paths.is_empty());
+        assert_eq!(actual, expected);
+        assert!(actual.iter().all(|path| !second_paths.contains(path)));
+    }
+}
