+    /// Returns the actual evdev nodes owned by this target.
+    pub async fn get_device_paths(&self) -> Result<Vec<String>, ClientError> {
+        let (tx, rx) = channel(1);
+        self.send(TargetCommand::GetDevicePaths(tx)).await?;
+        match Self::recv(rx).await {
+            Some(Ok(paths)) => Ok(paths),
+            Some(Err(err)) => Err(ClientError::ServiceError(err.into())),
+            None => Err(ClientError::ChannelClosed),
+        }
+    }
