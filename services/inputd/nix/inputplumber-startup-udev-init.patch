+    /// Add devices that were not yet initialized by udev at startup, each once
+    /// and with properties re-read after initialization. A device removed while
+    /// waiting is dropped. The wait is bounded: past the deadline a device is
+    /// added with whatever udev has by then, which is what upstream did at once.
+    async fn discover_pending_devices(
+        cmd_tx: &mpsc::Sender<ManagerCommand>,
+        mut pending: Vec<PathBuf>,
+    ) -> Result<(), Box<dyn Error>> {
+        let deadline = tokio::time::Instant::now() + STARTUP_UDEV_WAIT;
+        while !pending.is_empty() {
+            let timed_out = tokio::time::Instant::now() >= deadline;
+            let (ready, waiting) = sort_pending(pending, |syspath| {
+                match ::udev::Device::from_syspath(syspath) {
+                    Err(_) => {
+                        log::debug!("Device removed before udev initialized it: {syspath:?}");
+                        PendingProbe::Gone
+                    }
+                    Ok(device) if device.is_initialized() => PendingProbe::Ready(device),
+                    Ok(device) if timed_out => {
+                        log::warn!("Device not initialized by udev after {STARTUP_UDEV_WAIT:?}; adding it as is: {syspath:?}");
+                        PendingProbe::Ready(device)
+                    }
+                    Ok(_) => PendingProbe::Pending,
+                }
+            });
+            pending = waiting;
+            Manager::discover_devices(cmd_tx, ready.into_iter().map(|dev| dev.into()).collect())
+                .await?;
+            if !pending.is_empty() {
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+        }
 
         Ok(())
     }
@@ -1792,3 +1838,71 @@ impl Manager {
         });
     }
 }
+
+/// Startup discovery: devices udev has initialized, and the syspaths of those
+/// it has not.
+fn split_initialized(devices: Vec<::udev::Device>) -> (Vec<::udev::Device>, Vec<PathBuf>) {
+    let mut ready = Vec::new();
+    let mut pending = Vec::new();
+    for device in devices {
+        if device.is_initialized() {
+            ready.push(device);
+        } else {
+            log::debug!("Waiting for udev to initialize {:?}", device.syspath());
+            pending.push(device.syspath().to_path_buf());
+        }
+    }
+    (ready, pending)
+}
+
+enum PendingProbe<D> {
+    Gone,
+    Pending,
+    Ready(D),
+}
+
+/// Probe each pending device once: ready ones are returned for adding, gone
+/// ones are dropped, the rest stay pending in order.
+fn sort_pending<K, D>(pending: Vec<K>, mut probe: impl FnMut(&K) -> PendingProbe<D>) -> (Vec<D>, Vec<K>) {
+    let mut ready = Vec::new();
+    let mut waiting = Vec::new();
+    for key in pending {
+        match probe(&key) {
+            PendingProbe::Gone => {}
+            PendingProbe::Pending => waiting.push(key),
+            PendingProbe::Ready(device) => ready.push(device),
+        }
+    }
+    (ready, waiting)
+}
+
+#[cfg(test)]
+mod startup_discovery_tests {
+    use super::{sort_pending, PendingProbe};
+
+    #[test]
+    fn pending_devices_are_added_once_dropped_when_gone_and_kept_in_order() {
+        let mut probes = Vec::new();
+        let (ready, waiting) = sort_pending(vec!["event6", "event7", "event11", "hidraw0"], |key| {
+            probes.push(*key);
+            match *key {
+                "event6" => PendingProbe::Ready("event6 initialized"),
+                "event7" => PendingProbe::Gone,
+                _ => PendingProbe::Pending,
+            }
+        });
+        assert_eq!(probes, ["event6", "event7", "event11", "hidraw0"]);
+        assert_eq!(ready, ["event6 initialized"]);
+        assert_eq!(waiting, ["event11", "hidraw0"]);
+
+        // A later round probes only what is still pending; nothing is re-added.
+        let mut probes = Vec::new();
+        let (ready, waiting) = sort_pending(waiting, |key| {
+            probes.push(*key);
+            PendingProbe::Ready(*key)
+        });
+        assert_eq!(probes, ["event11", "hidraw0"]);
+        assert_eq!(ready, ["event11", "hidraw0"]);
+        assert!(waiting.is_empty());
+    }
+}
