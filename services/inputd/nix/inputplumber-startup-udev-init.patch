 const BUFFER_SIZE: usize = 20480;
+/// Upper bound for startup discovery to wait for udev to initialize a device.
+const STARTUP_UDEV_WAIT: Duration = Duration::from_secs(10);
 const VIRT_DEVICE_WHITELIST: &[&str] = &[
     "Sunshine PS5 (virtual) pad",
     "Sunshine X-Box One (virtual) pad",
@@ -1625,12 +1627,19 @@ impl Manager {
