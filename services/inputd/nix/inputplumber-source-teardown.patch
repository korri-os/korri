@@ -1589,6 +1616,32 @@ impl CompositeDevice {
         let path = device.path();
         let id = device.get_id();
 
+        // A devnode disappearing does not guarantee that its driver has exited
+        // (udev can recreate a node without disconnecting the kernel device).
+        // Release the old EVIOGRAB/hidraw fd before advertising a vacant slot.
+        // Joining also makes an already-queued stop notification harmless: its
+        // task ID no longer belongs to the active source.
+        if let Some(mut task) = self.source_device_tasks.remove(&id) {
+            let result = tokio::time::timeout(Duration::from_secs(5), async {
+                if let Some(source) = self.source_devices.get(&id) {
+                    if let Err(e) = source.stop().await {
+                        log::debug!("Source {id} already stopped: {e}");
+                    }
+                }
+                (&mut task).await
+            })
+            .await;
+            match result {
+                Ok(result) => result?,
+                Err(e) => {
+                    // Keep the slot occupied if the driver cannot stop safely.
+                    self.source_device_tasks.insert(id, task);
+                    return Err(e.into());
+                }
+            }
+        }
+        self.source_devices.remove(&id);
+
         // Remove any ffb effects this device registered
         let mut freed_effect_ids = Vec::new();
 
@@ -2218,3 +2271,47 @@ impl CompositeDevice {
         });
     }
 }
+
+// eventN/hidrawN identify a slot, not the task that currently owns it.
+fn source_task_is_current(
+    tasks: &HashMap<String, JoinHandle<()>>,
+    device_id: &str,
+    task_id: tokio::task::Id,
+) -> bool {
+    tasks
+        .get(device_id)
+        .is_some_and(|task| task.id() == task_id)
+}
+
+#[cfg(test)]
+mod source_task_tests {
+    use super::source_task_is_current;
+    use std::collections::HashMap;
+
+    #[tokio::test]
+    async fn late_completion_does_not_own_a_reconnected_source_slot() {
+        let old = tokio::spawn(async {});
+        let old_id = old.id();
+        old.await.unwrap();
+        let replacement = tokio::spawn(async {});
+        let replacement_id = replacement.id();
+        let mut tasks = HashMap::from([("evdev://event12".into(), replacement)]);
+        assert!(!source_task_is_current(&tasks, "evdev://event12", old_id));
+        assert!(source_task_is_current(
+            &tasks,
+            "evdev://event12",
+            replacement_id
+        ));
+        assert!(!source_task_is_current(
+            &tasks,
+            "hidraw://hidraw0",
+            replacement_id
+        ));
+        tasks.remove("evdev://event12").unwrap().await.unwrap();
+        assert!(!source_task_is_current(
+            &tasks,
+            "evdev://event12",
+            replacement_id
+        ));
+    }
+}
