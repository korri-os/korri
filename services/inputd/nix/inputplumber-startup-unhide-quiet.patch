--- /dev/null
+++ b/src/udev/unhide_test.rs
@@ -0,0 +1,36 @@
+use std::{fs, path::PathBuf};
+
+use crate::udev::remove_hide_rules;
+
+fn scratch_dir(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("inputplumber-{name}-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+#[test]
+fn no_hide_rules_means_nothing_to_undo() {
+    let dir = scratch_dir("no-hide-rules");
+    fs::write(dir.join("61-dev-root-link.rules"), "").unwrap();
+    fs::write(dir.join("99-z-other.rules"), "").unwrap();
+
+    assert_eq!(remove_hide_rules(&dir).unwrap(), 0);
+    assert!(dir.join("61-dev-root-link.rules").exists());
+    assert!(dir.join("99-z-other.rules").exists());
+    fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
+fn stale_hide_rules_are_removed_and_counted() {
+    let dir = scratch_dir("stale-hide-rules");
+    fs::write(dir.join("50-inputplumber-hide-event0-early.rules"), "").unwrap();
+    fs::write(dir.join("96-inputplumber-hide-event0-late.rules"), "").unwrap();
+    fs::write(dir.join("61-dev-root-link.rules"), "").unwrap();
+
+    assert_eq!(remove_hide_rules(&dir).unwrap(), 2);
+    assert!(!dir.join("50-inputplumber-hide-event0-early.rules").exists());
+    assert!(!dir.join("96-inputplumber-hide-event0-late.rules").exists());
+    assert!(dir.join("61-dev-root-link.rules").exists());
+    fs::remove_dir_all(&dir).unwrap();
+}
