[Unit]
After=korri-certificate-control.socket korri-input-source-guard.service korri-compositor.service network-online.target suid-sgid-wrappers.service korri-input-seat-receiver.service
BindsTo=korri-compositor.service
Description=Sunshine stream host for Korri
Requires=korri-certificate-control.socket korri-input-source-guard.service korri-compositor.service suid-sgid-wrappers.service korri-input-seat-receiver.service
Wants=network-online.target

[Service]
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus"
Environment="DISPLAY=:0"
Environment="HOME=/home/gameplay"
Environment="KORRI_CERTIFICATE_CONTROL_GID=976"
Environment="KORRI_CERTIFICATE_CONTROL_MODE=0660"
Environment="KORRI_CERTIFICATE_CONTROL_OWNER_GID=976"
Environment="KORRI_CERTIFICATE_CONTROL_PATH=/run/korri-certificate-control/control.sock"
Environment="KORRI_CERTIFICATE_CONTROL_UID=976"
Environment="KORRI_INPUT_SEAT_MIRROR_SOCKET=/run/korri-input-seat/sunshine-input-seat.sock"
Environment="KORRI_INPUT_SEAT_RUNTIME_DIR=/run/korri-input-seat"
Environment="LOCALE_ARCHIVE=/nix/store/fxcf3lz7hwyz5z2r25bkhs3mg1pl3si6-glibc-locales-2.40-66/lib/locale/locale-archive"
Environment="PATH=/nix/store/d9jxdwalyr5qzmyz9m5avmzn7w40h7iy-coreutils-9.8/bin:/nix/store/cy7aqw5j5rjk2pza5p2j2jcdm3vjy12q-findutils-4.10.0/bin:/nix/store/5728bdap49nsnk1c8zq96fqsm4b7ihj6-gnugrep-3.12/bin:/nix/store/xcjag3jcsfdmixjcm3xckkrkcl5r48b6-gnused-4.9/bin:/nix/store/xn64fgz1z7jz4nnhln9nkdkd4p1bparg-systemd-258.2/bin:/nix/store/d9jxdwalyr5qzmyz9m5avmzn7w40h7iy-coreutils-9.8/sbin:/nix/store/cy7aqw5j5rjk2pza5p2j2jcdm3vjy12q-findutils-4.10.0/sbin:/nix/store/5728bdap49nsnk1c8zq96fqsm4b7ihj6-gnugrep-3.12/sbin:/nix/store/xcjag3jcsfdmixjcm3xckkrkcl5r48b6-gnused-4.9/sbin:/nix/store/xn64fgz1z7jz4nnhln9nkdkd4p1bparg-systemd-258.2/sbin"
Environment="PULSE_SERVER=unix:/run/user/1001/pulse/native"
Environment="SUNSHINE_LIVE_SETTINGS_MVP=1"
Environment="SUNSHINE_STRICT_ENCODER=1"
Environment="TZDIR=/nix/store/qzx55k27rdhpg9f792fg7dwcbwz78mc8-tzdata-2025b/share/zoneinfo"
Environment="WAYLAND_DISPLAY=korri-wayland"
Environment="XDG_CONFIG_HOME=/home/gameplay/.config"
Environment="XDG_RUNTIME_DIR=/run/user/1001"
Environment="XDG_SESSION_TYPE=wayland"
Environment="mpp_drm_dev=/dev/dri/by-path/platform-display-subsystem-card"
CapabilityBoundingSet=CAP_SETPCAP
CapabilityBoundingSet=CAP_SYS_ADMIN
ExecStart=/run/wrappers/bin/sunshine /home/gameplay/.config/sunshine/sunshine.conf log_path=/dev/null capture=kms encoder=rkmpp
ExecStartPre=+/nix/store/ziqd3cw8rwa58b2994bvk9rph111ibk7-korri-wait-for-compositor
ExecStartPre=/nix/store/b886dv5ck0jrrmwl95z8sr6h7pxiflbm-korri-wait-for-audio
Group=korri-sunshine-input-seat
InaccessiblePaths=/dev/inputplumber/sources
InaccessiblePaths=/run/korri-compositor
LockPersonality=true
MemoryDenyWriteExecute=false
NoNewPrivileges=false
PrivateDevices=false
PrivatePIDs=false
PrivateTmp=false
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/home/gameplay/.config/sunshine
ReadWritePaths=/tmp
Restart=on-failure
RestartSec=5
RestrictSUIDSGID=true
Sockets=korri-certificate-control.socket
SupplementaryGroups=video
SupplementaryGroups=render
SupplementaryGroups=korri-sunshine-uinput
SystemCallArchitectures=native
Type=simple
UMask=0077
User=gameplay
WorkingDirectory=/home/gameplay

[Install]
WantedBy=multi-user.target
