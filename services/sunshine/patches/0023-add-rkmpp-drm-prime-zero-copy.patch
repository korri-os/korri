+    class rkmpp_vram_t: public avcodec_encode_device_t {
+    public:
+      rkmpp_vram_t() {
+        // A non-null data field tells the generic AVCodec path that this
+        // device supplies its own frame conversion and ownership handling.
+        data = this;
+      }
+
+      int init(int width, int height) {
+        this->width = width;
+        this->height = height;
+        return 0;
+      }
+
+      int set_frame(AVFrame *frame, AVBufferRef *hw_frames_ctx) override {
+        if (!hw_frames_ctx) {
+          BOOST_LOG(error) << "RKMPP zero-copy input requires a hardware frames context"sv;
+          return -1;
+        }
+
+        frame_owner.reset(frame);
+        this->frame = frame_owner.get();
+        this->frame->hw_frames_ctx = av_buffer_ref(hw_frames_ctx);
+        return this->frame->hw_frames_ctx ? 0 : -1;
+      }
+
+      int convert(img_t &img) override {
+        auto &descriptor = (egl::img_descriptor_t &) img;
+        auto &sd = descriptor.sd;
+
+        if (descriptor.sequence == 0 || sd.fds[0] < 0) {
+          BOOST_LOG(error) << "RKMPP zero-copy input has no KMS framebuffer"sv;
+          return -1;
+        }
+        if (sd.width != width || sd.height != height) {
+          BOOST_LOG(error) << "RKMPP zero-copy input size changed from "sv << width << 'x' << height << " to "sv << sd.width << 'x' << sd.height;
+          return -1;
+        }
+        if (sd.fourcc != DRM_FORMAT_XRGB8888 || sd.fds[1] >= 0) {
+          BOOST_LOG(error) << "RKMPP zero-copy only supports a single-plane XRGB8888 framebuffer"sv;
+          return -1;
+        }
+        if (sd.modifier != DRM_FORMAT_MOD_LINEAR && sd.modifier != DRM_FORMAT_MOD_INVALID) {
+          BOOST_LOG(error) << "RKMPP zero-copy only supports a linear framebuffer modifier"sv;
+          return -1;
+        }
+
+        auto drm_desc = (AVDRMFrameDescriptor *) av_mallocz(sizeof(AVDRMFrameDescriptor));
+        if (!drm_desc) {
+          return -1;
+        }
+
+        drm_desc->objects[0].fd = dup(sd.fds[0]);
+        if (drm_desc->objects[0].fd < 0) {
+          av_free(drm_desc);
+          return -1;
+        }
+
+        auto object_size = lseek(drm_desc->objects[0].fd, 0, SEEK_END);
+        if (object_size <= 0) {
+          close(drm_desc->objects[0].fd);
+          av_free(drm_desc);
+          BOOST_LOG(error) << "Couldn't determine RKMPP dma-buf size: "sv << strerror(errno);
+          return -1;
+        }
+
+        drm_desc->nb_objects = 1;
+        drm_desc->objects[0].size = object_size;
+        drm_desc->objects[0].format_modifier =
+          sd.modifier == DRM_FORMAT_MOD_INVALID ? DRM_FORMAT_MOD_LINEAR : sd.modifier;
+        drm_desc->nb_layers = 1;
+        drm_desc->layers[0].format = sd.fourcc;
+        drm_desc->layers[0].nb_planes = 1;
+        drm_desc->layers[0].planes[0].object_index = 0;
+        drm_desc->layers[0].planes[0].offset = sd.offsets[0];
+        drm_desc->layers[0].planes[0].pitch = sd.pitches[0];
+
+        auto buffer = av_buffer_create(
+          (std::uint8_t *) drm_desc,
+          sizeof(*drm_desc),
+          [](void *, std::uint8_t *data) {
+            auto desc = (AVDRMFrameDescriptor *) data;
+            for (int i = 0; i < desc->nb_objects; ++i) {
+              if (desc->objects[i].fd >= 0) {
+                close(desc->objects[i].fd);
+              }
+            }
+            av_free(desc);
+          },
+          nullptr,
+          0
+        );
+        if (!buffer) {
+          close(drm_desc->objects[0].fd);
+          av_free(drm_desc);
+          return -1;
+        }
+
+        av_buffer_unref(&frame->buf[0]);
+        frame->buf[0] = buffer;
+        frame->data[0] = buffer->data;
+        return 0;
+      }
+
+      frame_t frame_owner;
+      int width {};
+      int height {};
+    };
