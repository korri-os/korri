+      void blend_rotated_cursor(img_t &img) {
+        // Only visit cursor pixels. The image shader maps a raw source pixel
+        // (x, y) to (source_height - 1 - y, x) in top-left image coordinates.
+        auto *pixels = reinterpret_cast<std::uint32_t *>(img.data);
+        for (std::uint32_t y = 0; y < captured_cursor.src_h; ++y) {
+          for (std::uint32_t x = 0; x < captured_cursor.src_w; ++x) {
+            auto target_x = img.width - 1 - (captured_cursor.y - img_offset_y + static_cast<std::int32_t>(y));
+            auto target_y = captured_cursor.x - img_offset_x + static_cast<std::int32_t>(x);
+            if (target_x < 0 || target_x >= img.width || target_y < 0 || target_y >= img.height) {
+              continue;
+            }
+            std::uint32_t cursor_pixel;
+            std::memcpy(&cursor_pixel, captured_cursor.pixels.data() + (y * captured_cursor.src_w + x) * 4, sizeof cursor_pixel);
+            auto *pixel = &pixels[target_y * (img.row_pitch / img.pixel_pitch) + target_x];
+            auto alpha = cursor_pixel >> 24u;
+            if (alpha == 255) {
+              *pixel = cursor_pixel;
+            } else {
+              auto *colors_in = reinterpret_cast<std::uint8_t *>(pixel);
+              auto *colors_out = reinterpret_cast<std::uint8_t *>(&cursor_pixel);
+              colors_in[0] = colors_out[0] + (colors_in[0] * (255 - alpha) + 255 / 2) / 255;
+              colors_in[1] = colors_out[1] + (colors_in[1] * (255 - alpha) + 255 / 2) / 255;
+              colors_in[2] = colors_out[2] + (colors_in[2] * (255 - alpha) + 255 / 2) / 255;
+            }
+          }
+        }
+      }
