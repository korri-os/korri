+namespace korri_certificate_control {
+
+  protocol_error::protocol_error(std::string code, std::string message):
+      std::runtime_error(std::move(message)), code_(std::move(code)) {}
+
+  const std::string &protocol_error::code() const noexcept {
+    return code_;
+  }
+
+  namespace {
+    std::string hex_sha256(const unsigned char *data, const std::size_t size) {
+      std::array<unsigned char, SHA256_DIGEST_LENGTH> digest {};
+      SHA256(data, size, digest.data());
+      static constexpr char alphabet[] = "0123456789abcdef";
+      std::string output(digest.size() * 2, '\0');
+      for (std::size_t i = 0; i < digest.size(); ++i) {
+        output[i * 2] = alphabet[digest[i] >> 4];
+        output[i * 2 + 1] = alphabet[digest[i] & 0x0f];
+      }
+      return output;
+    }
+
+#ifndef _WIN32
+    bool should_fail(fault_plan *faults, const fault_stage stage) {
+      if (faults && faults->stage == stage && !faults->triggered) {
+        faults->triggered = true;
+        errno = EIO;
+        return true;
+      }
+      if (faults && faults->recovery_stage == stage && !faults->recovery_triggered) {
+        faults->recovery_triggered = true;
+        errno = EIO;
+        return true;
+      }
+      return false;
+    }
+
+    bool write_all(const int fd, const std::string_view contents, fault_plan *faults) {
+      if (should_fail(faults, fault_stage::write)) {
+        return false;
+      }
+      std::size_t offset = 0;
+      while (offset < contents.size()) {
+        const auto written = ::write(fd, contents.data() + offset, contents.size() - offset);
+        if (written > 0) {
+          offset += static_cast<std::size_t>(written);
+          continue;
+        }
+        if (written < 0 && errno == EINTR) {
+          continue;
+        }
+        return false;
+      }
+      return true;
+    }
+
+    class temporary_file {
+    public:
+      explicit temporary_file(const std::filesystem::path &target) {
+        auto pattern = target.string() + ".korri-XXXXXX";
+        storage_.assign(pattern.begin(), pattern.end());
+        storage_.push_back('\0');
+        fd_ = ::mkostemp(storage_.data(), O_CLOEXEC);
+        if (fd_ >= 0) {
+          path_ = storage_.data();
+          (void) ::fchmod(fd_, 0600);
+        }
+      }
+
+      temporary_file(const temporary_file &) = delete;
+      temporary_file &operator=(const temporary_file &) = delete;
+
+      ~temporary_file() {
+        if (fd_ >= 0) {
+          ::close(fd_);
+        }
+        if (!path_.empty()) {
+          ::unlink(path_.c_str());
+        }
+      }
+
+      [[nodiscard]] int fd() const noexcept {
+        return fd_;
+      }
+
+      [[nodiscard]] const std::string &path() const noexcept {
+        return path_;
+      }
+
+      bool close() {
+        if (fd_ < 0) {
+          return false;
+        }
+        const int fd = std::exchange(fd_, -1);
+        return ::close(fd) == 0;
+      }
+
+      void release_path() {
+        path_.clear();
+      }
+
+    private:
+      std::vector<char> storage_;
+      std::string path_;
+      int fd_ {-1};
+    };
+
+    std::optional<std::string> read_existing(const std::string &path, bool &exists) {
+      std::error_code error;
+      exists = std::filesystem::exists(path, error);
+      if (error) {
+        return std::nullopt;
+      }
+      if (!exists) {
+        return std::string {};
+      }
+      std::ifstream input(path, std::ios::binary);
+      if (!input) {
+        return std::nullopt;
+      }
+      std::ostringstream contents;
+      contents << input.rdbuf();
+      if (input.bad()) {
+        return std::nullopt;
+      }
+      return contents.str();
+    }
+
+    bool sync_parent(const std::filesystem::path &target, fault_plan *faults) {
+      if (should_fail(faults, fault_stage::directory_sync)) {
+        return false;
+      }
+      const auto parent = target.has_parent_path() ? target.parent_path() : std::filesystem::path{"."};
+      const int parent_fd = ::open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+      if (parent_fd < 0) {
+        return false;
+      }
+      bool ok = ::fsync(parent_fd) == 0;
+      if (::close(parent_fd) != 0) {
+        ok = false;
+      }
+      return ok;
+    }
+
+
+
+    bool sync_parent_after_restore(
+        const std::filesystem::path &target,
+        fault_plan *faults) {
+      if (should_fail(faults, fault_stage::restore_directory_sync)) {
+        return false;
+      }
+      return sync_parent(target, nullptr);
+    }
+
+    bool replace_bytes_after_restore(
+        const std::filesystem::path &target,
+        const std::string_view contents,
+        fault_plan *faults) {
+      temporary_file temporary(target);
+      if (temporary.fd() < 0 || should_fail(faults, fault_stage::restore_write) ||
+          !write_all(temporary.fd(), contents, nullptr)) {
+        return false;
+      }
+      if (should_fail(faults, fault_stage::restore_file_sync) ||
+          ::fsync(temporary.fd()) != 0 || !temporary.close()) {
+        return false;
+      }
+      if (should_fail(faults, fault_stage::restore_rename) ||
+          ::rename(temporary.path().c_str(), target.c_str()) != 0) {
+        return false;
+      }
+      temporary.release_path();
+      return sync_parent_after_restore(target, faults);
+    }
+
+    bool restore_after_uncertain_rename(
+        const std::filesystem::path &target,
+        const bool existed,
+        const std::string_view previous,
+        fault_plan *faults) {
+      if (!existed) {
+        if (::unlink(target.c_str()) != 0 && errno != ENOENT) {
+          return false;
+        }
+        return sync_parent_after_restore(target, faults);
+      }
+
+      return replace_bytes_after_restore(target, previous, faults);
+    }
+
+    bool restore_after_committed_replace(
+        const std::filesystem::path &target,
+        const bool existed,
+        const std::string_view previous,
+        fault_plan *faults) {
+      if (existed) {
+        return replace_bytes_after_restore(target, previous, faults);
+      }
+      if (::unlink(target.c_str()) != 0 && errno != ENOENT) {
+        return false;
+      }
+      return sync_parent_after_restore(target, faults);
+    }
+#endif
+  }  // namespace
+
+  validated_certificate validate_single_certificate(const std::string &pem) {
+    if (pem.empty() || pem.size() > max_frame_bytes || pem.find('\0') != std::string::npos) {
+      throw protocol_error("InvalidCertificate", "certificate is empty or too large");
+    }
+
+    constexpr std::string_view begin_marker = "-----BEGIN CERTIFICATE-----";
+    const auto begin = pem.find(begin_marker);
+    if (begin == std::string::npos || !std::all_of(
+          pem.begin(), pem.begin() + static_cast<std::ptrdiff_t>(begin),
+          [](const unsigned char byte) { return std::isspace(byte); })) {
+      throw protocol_error("InvalidCertificate", "certificate contains leading data");
+    }
+
+    std::unique_ptr<BIO, decltype(&BIO_free)> bio(
+        BIO_new_mem_buf(pem.data(), static_cast<int>(pem.size())), BIO_free);
+    if (!bio) {
+      throw protocol_error("InvalidCertificate", "certificate parser unavailable");
+    }
+    std::unique_ptr<X509, decltype(&X509_free)> cert(
+        PEM_read_bio_X509(bio.get(), nullptr, nullptr, nullptr), X509_free);
+    if (!cert) {
+      throw protocol_error("InvalidCertificate", "certificate is not valid X.509 PEM");
+    }
+
+    std::array<char, 256> tail {};
+    for (;;) {
+      const auto read = BIO_read(bio.get(), tail.data(), static_cast<int>(tail.size()));
+      if (read <= 0) {
+        break;
+      }
+      for (int i = 0; i < read; ++i) {
+        if (!std::isspace(static_cast<unsigned char>(tail[static_cast<std::size_t>(i)]))) {
+          throw protocol_error("InvalidCertificate", "certificate contains trailing data");
+        }
+      }
+    }
+
+    const auto der_size = i2d_X509(cert.get(), nullptr);
+    if (der_size <= 0) {
+      throw protocol_error("InvalidCertificate", "certificate encoding failed");
+    }
+    std::vector<unsigned char> der(static_cast<std::size_t>(der_size));
+    auto *cursor = der.data();
+    if (i2d_X509(cert.get(), &cursor) != der_size) {
+      throw protocol_error("InvalidCertificate", "certificate encoding failed");
+    }
+    return {hex_sha256(der.data(), der.size())};
+  }
+
+  std::string json_quote(const std::string &value) {
+    return nlohmann::json(value).dump();
+  }
+
+  request parse_request(const std::string &frame, const std::string_view expected_host_uuid) {
+    if (frame.empty() || frame.size() > max_frame_bytes || frame.find('\0') != std::string::npos) {
+      throw protocol_error("InvalidFrame", "request frame is empty or too large");
+    }
+
+    nlohmann::json document;
+    try {
+      document = nlohmann::json::parse(frame);
+    } catch (const std::exception &) {
+      throw protocol_error("InvalidFrame", "request is not valid JSON");
+    }
+    if (!document.is_object() || !document.contains("operation") ||
+        !document["operation"].is_string() || !document.contains("hostUuid") ||
+        !document["hostUuid"].is_string()) {
+      throw protocol_error("InvalidFrame", "request has an invalid shape");
+    }
+
+    const auto &operation_name = document["operation"].get_ref<const std::string &>();
+    const bool host_matches =
+        document["hostUuid"].get_ref<const std::string &>() == expected_host_uuid;
+    if (operation_name == "attest") {
+      if (document.size() != 2) {
+        throw protocol_error("InvalidFrame", "attest request has an invalid shape");
+      }
+      return {operation::attest, {}, host_matches};
+    }
+    if (document.size() != 3 || !document.contains("certificate") ||
+        !document["certificate"].is_string()) {
+      throw protocol_error("InvalidFrame", "mutation request has an invalid shape");
+    }
+    if (!host_matches) {
+      throw protocol_error("HostMismatch", "requested host identity does not match this Sunshine instance");
+    }
+
+    operation parsed_operation;
+    if (operation_name == "provision") {
+      parsed_operation = operation::provision;
+    } else if (operation_name == "revoke") {
+      parsed_operation = operation::revoke;
+    } else {
+      throw protocol_error("UnknownOperation", "request operation is not supported");
+    }
+    auto certificate = document["certificate"].get<std::string>();
+    (void) validate_single_certificate(certificate);
+    return {parsed_operation, std::move(certificate), true};
+  }
+
+  mutation_result apply_revoke(
+      std::vector<named_certificate> &clients,
+      const std::string &certificate) {
+    const auto fingerprint = validate_single_certificate(certificate).fingerprint;
+    const auto before = clients.size();
+    std::erase_if(clients, [&](named_certificate &client) {
+      if (client.fingerprint.empty()) {
+        client.fingerprint = validate_single_certificate(client.certificate).fingerprint;
+      }
+      return client.fingerprint == fingerprint;
+    });
+    return {clients.size() != before};
+  }
+
+  std::string attest_response(const bool matched) {
+    auto response = nlohmann::json::object();
+    response["status"] = "ok";
+    response["matched"] = matched;
+    return response.dump();
+  }
+
+  std::string success_response(const std::string &server_certificate, const bool changed) {
+    auto response = nlohmann::json::object();
+    response["status"] = "ok";
+    response["changed"] = changed;
+    response["serverCertificate"] = server_certificate;
+    auto encoded = response.dump();
+    if (encoded.size() > max_frame_bytes) {
+      throw protocol_error("ResponseTooLarge", "response exceeds the frame limit");
+    }
+    return encoded;
+  }
+
+  std::string error_response(const std::string_view code) {
+    auto response = nlohmann::json::object();
+    response["status"] = "error";
+    response["code"] = code;
+    return response.dump();
+  }
+
+  std::string build_state_document(
+      const std::string_view existing_document,
+      const std::string_view unique_id,
+      const std::vector<named_certificate> &clients) {
+    nlohmann::json document = nlohmann::json::object();
+    if (!existing_document.empty()) {
+      try {
+        document = nlohmann::json::parse(existing_document);
+      } catch (const std::exception &) {
+        throw protocol_error("InvalidState", "Sunshine state is not valid JSON");
+      }
+      if (!document.is_object()) {
+        throw protocol_error("InvalidState", "Sunshine state root is not an object");
+      }
+    }
+    if (!document.contains("root")) {
+      document["root"] = nlohmann::json::object();
+    }
+    if (!document["root"].is_object()) {
+      throw protocol_error("InvalidState", "Sunshine credential root is not an object");
+    }
+    auto &root = document["root"];
+    root["uniqueid"] = unique_id;
+    root.erase("devices");
+    auto named_devices = nlohmann::json::array();
+    for (const auto &client : clients) {
+      named_devices.push_back({
+          {"name", client.name},
+          {"cert", client.certificate},
+          {"uuid", client.uuid},
+      });
+    }
+    root["named_devices"] = std::move(named_devices);
+    return document.dump(4) + "\n";
+  }
+
+#ifndef _WIN32
+  bool persist_offline_retirement(
+      const std::string &path,
+      const std::string &candidate_document,
+      fault_plan *faults) {
+    // Administrative only: exclusion belongs to the caller. Once renamed,
+    // retired trust must never return, even when durability is uncertain.
+    const std::filesystem::path target(path);
+    temporary_file temporary(target);
+    if (temporary.fd() < 0 || !write_all(temporary.fd(), candidate_document, faults) ||
+        should_fail(faults, fault_stage::file_sync) || ::fsync(temporary.fd()) != 0 ||
+        !temporary.close()) {
+      return false;
+    }
+    if (should_fail(faults, fault_stage::rename) ||
+        ::rename(temporary.path().c_str(), target.c_str()) != 0) {
+      return false;
+    }
+    temporary.release_path();
+    return sync_parent(target, faults);
+  }
+#endif
+
+  transaction_result replace_state_and_activate(
+      const std::string &path,
+      const std::string &candidate_document,
+      const std::function<bool()> &activate,
+      fault_plan *faults) {
+#ifdef _WIN32
+    (void) path;
+    (void) candidate_document;
+    (void) activate;
+    (void) faults;
+    return transaction_result::failed;
+#else
+    bool existed = false;
+    auto previous = read_existing(path, existed);
+    if (!previous) {
+      return transaction_result::failed;
+    }
+
+    const std::filesystem::path target(path);
+    temporary_file temporary(target);
+    if (temporary.fd() < 0 || !write_all(temporary.fd(), candidate_document, faults) ||
+        should_fail(faults, fault_stage::file_sync) || ::fsync(temporary.fd()) != 0 ||
+        !temporary.close()) {
+      return transaction_result::failed;
+    }
+    if (should_fail(faults, fault_stage::rename) ||
+        ::rename(temporary.path().c_str(), target.c_str()) != 0) {
+      return transaction_result::failed;
+    }
+    temporary.release_path();
+
+    if (!sync_parent(target, faults)) {
+      return restore_after_uncertain_rename(target, existed, *previous, faults)
+          ? transaction_result::failed
+          : transaction_result::recovery_failed;
+    }
+
+    bool activated = false;
+    try {
+      activated = !should_fail(faults, fault_stage::activation) && activate();
+    } catch (...) {
+      activated = false;
+    }
+    if (!activated) {
+      return restore_after_committed_replace(target, existed, *previous, faults)
+          ? transaction_result::failed
+          : transaction_result::recovery_failed;
+    }
+    return transaction_result::committed;
+#endif
+  }
