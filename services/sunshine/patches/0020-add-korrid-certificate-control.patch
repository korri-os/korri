+#ifndef _WIN32
+  std::optional<int> select_systemd_descriptor(
+      const unsigned long listen_fds,
+      const std::string_view fd_names) {
+    if (listen_fds != 1 || fd_names != "korri-certificate-control") {
+      return std::nullopt;
+    }
+    return 3;
+  }
+
+  bool validate_and_harden_listening_descriptor(
+      const int fd,
+      const std::string_view expected_path,
+      const uid_t expected_owner,
+      const gid_t expected_owner_gid,
+      const mode_t expected_mode) {
+    if (expected_path.empty() || expected_path.front() != '/' ||
+        expected_path.size() >= sizeof(((sockaddr_un *) nullptr)->sun_path) ||
+        expected_mode == 0 || (expected_mode & ~0777U) != 0) {
+      return false;
+    }
+    int type = 0;
+    socklen_t type_size = sizeof(type);
+    int accepting = 0;
+    socklen_t accepting_size = sizeof(accepting);
+    sockaddr_un address {};
+    socklen_t address_size = sizeof(address);
+    if (::getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &type_size) != 0 || type != SOCK_SEQPACKET ||
+        ::getsockopt(fd, SOL_SOCKET, SO_ACCEPTCONN, &accepting, &accepting_size) != 0 || !accepting ||
+        ::getsockname(fd, reinterpret_cast<sockaddr *>(&address), &address_size) != 0 ||
+        address.sun_family != AF_UNIX ||
+        address_size <= offsetof(sockaddr_un, sun_path) + 1 || address.sun_path[0] == '\0') {
+      return false;
+    }
+    const auto path_bytes = static_cast<std::size_t>(address_size - offsetof(sockaddr_un, sun_path));
+    const auto terminator = static_cast<const char *>(
+        std::memchr(address.sun_path, '\0', std::min(path_bytes, sizeof(address.sun_path))));
+    if (!terminator) {
+      return false;
+    }
+    const std::string_view actual_path(address.sun_path, static_cast<std::size_t>(terminator - address.sun_path));
+    if (actual_path != expected_path) {
+      return false;
+    }
+    struct stat socket_state {};
+    if (::lstat(address.sun_path, &socket_state) != 0 || !S_ISSOCK(socket_state.st_mode) ||
+        socket_state.st_uid != expected_owner || socket_state.st_gid != expected_owner_gid ||
+        (socket_state.st_mode & 0777U) != expected_mode) {
+      return false;
+    }
+    const auto flags = ::fcntl(fd, F_GETFL, 0);
+    const auto descriptor_flags = ::fcntl(fd, F_GETFD, 0);
+    return flags >= 0 && descriptor_flags >= 0 &&
+        ::fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0 &&
+        ::fcntl(fd, F_SETFD, descriptor_flags | FD_CLOEXEC) == 0;
+  }
+#endif
+
+}  // namespace korri_certificate_control
