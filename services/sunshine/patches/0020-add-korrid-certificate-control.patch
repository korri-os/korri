+  // Shared by load_state and the offline administrator. Keep the producer's
+  // legacy devices/certs import and named_devices field interpretation here.
+  template<typename UuidFactory>
+  std::vector<named_certificate> parse_client_state(
+      const boost::property_tree::ptree &root,
+      UuidFactory &&uuid_factory) {
+    std::vector<named_certificate> clients;
+    if (root.get_child_optional("devices")) {
+      for (const auto &[_, device] : root.get_child("devices")) {
+        if (device.count("certs")) {
+          for (const auto &[__, certificate] : device.get_child("certs")) {
