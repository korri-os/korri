+#ifndef _WIN32
+  enum class packet_result {
+    responded,
+    rejected_peer,
+    no_packet,
+    send_failed,
+  };
+
+  std::optional<int> select_systemd_descriptor(
+      unsigned long listen_fds,
+      std::string_view fd_names);
+
+  bool validate_and_harden_listening_descriptor(
+      int fd,
+      std::string_view expected_path,
+      uid_t expected_owner,
+      gid_t expected_owner_gid,
+      mode_t expected_mode);
+
+  template<typename Handler>
+  packet_result serve_one_packet(
+      const int fd,
+      const uid_t expected_uid,
+      const gid_t expected_gid,
+      Handler &&handler) {
+    ucred credentials {};
+    socklen_t credentials_size = sizeof(credentials);
+    if (::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &credentials_size) != 0 ||
+        credentials_size != sizeof(credentials) ||
+        credentials.uid != expected_uid || credentials.gid != expected_gid) {
+      return packet_result::rejected_peer;
+    }
+
+    pollfd wait_fd {fd, POLLIN, 0};
+    if (::poll(&wait_fd, 1, 250) <= 0 || !(wait_fd.revents & POLLIN)) {
+      return packet_result::no_packet;
+    }
+    std::array<char, max_frame_bytes + 1> frame {};
+    const auto received = ::recv(fd, frame.data(), frame.size(), MSG_DONTWAIT | MSG_TRUNC);
+    std::string response;
+    if (received <= 0 || static_cast<std::size_t>(received) > max_frame_bytes) {
+      response = error_response("InvalidFrame");
+    } else {
+      char extra = 0;
+      const auto queued = ::recv(fd, &extra, sizeof(extra), MSG_DONTWAIT | MSG_PEEK | MSG_TRUNC);
+      if (queued > 0) {
+        response = error_response("InvalidFrame");
+      } else {
+        response = std::invoke(
+            std::forward<Handler>(handler),
+            std::string(frame.data(), static_cast<std::size_t>(received)));
+      }
+    }
+    const auto sent = ::send(fd, response.data(), response.size(), MSG_DONTWAIT | MSG_NOSIGNAL);
+    return sent == static_cast<ssize_t>(response.size())
+        ? packet_result::responded
+        : packet_result::send_failed;
+  }
+
+  template<typename ShouldStop, typename Handler>
+  void serve_listener(
+      const int listener_fd,
+      const uid_t expected_uid,
+      const gid_t expected_gid,
+      ShouldStop &&should_stop,
+      Handler &&handler) {
+    while (!std::invoke(should_stop)) {
+      pollfd wait_fd {listener_fd, POLLIN, 0};
+      const auto ready = ::poll(&wait_fd, 1, 100);
+      if (ready <= 0 || !(wait_fd.revents & POLLIN)) {
+        continue;
+      }
+      const int client_fd = ::accept4(listener_fd, nullptr, nullptr, SOCK_CLOEXEC | SOCK_NONBLOCK);
+      if (client_fd < 0) {
+        continue;
+      }
+      (void) serve_one_packet(client_fd, expected_uid, expected_gid, handler);
+      ::close(client_fd);
+    }
+  }
+#endif
+
