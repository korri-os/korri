+  struct mutation_result {
+    bool changed;
+  };
+
+  enum class transaction_result {
+    committed,
+    failed,
+    recovery_failed,
+  };
+
+  enum class fault_stage {
+    none,
+    write,
+    file_sync,
+    rename,
+    directory_sync,
+    activation,
+    restore_write,
+    restore_file_sync,
+    restore_rename,
+    restore_directory_sync,
+  };
+
+  struct fault_plan {
+    fault_stage stage {fault_stage::none};
+    fault_stage recovery_stage {fault_stage::none};
+    bool triggered {false};
+    bool recovery_triggered {false};
+  };
+
+  validated_certificate validate_single_certificate(const std::string &pem);
+  std::string json_quote(const std::string &value);
+  request parse_request(const std::string &frame, std::string_view expected_host_uuid);
+
+  template<typename UuidFactory>
+  mutation_result apply_provision(
+      std::vector<named_certificate> &clients,
+      const std::string &certificate,
+      UuidFactory &&uuid_factory) {
+    const auto validated = validate_single_certificate(certificate);
+    for (auto &client : clients) {
+      if (client.fingerprint.empty()) {
+        client.fingerprint = validate_single_certificate(client.certificate).fingerprint;
+      }
+      if (client.fingerprint == validated.fingerprint) {
+        return {false};
+      }
+    }
+    clients.push_back({
+        std::string(fixed_client_name),
+        std::invoke(std::forward<UuidFactory>(uuid_factory)),
+        certificate,
+        validated.fingerprint,
+    });
+    return {true};
+  }
+
+  mutation_result apply_revoke(
+      std::vector<named_certificate> &clients,
+      const std::string &certificate);
+
+  std::string attest_response(bool matched);
+  std::string success_response(const std::string &server_certificate, bool changed);
+  std::string error_response(std::string_view code);
+
+  std::string build_state_document(
+      std::string_view existing_document,
+      std::string_view unique_id,
+      const std::vector<named_certificate> &clients);
+
+#ifndef _WIN32
+  // Offline administrator only; false includes an unsynced replacement. Never
+  // activates authority or restores the previous document. Caller must inspect.
+  bool persist_offline_retirement(
+      const std::string &path,
+      const std::string &candidate_document,
+      fault_plan *faults = nullptr);
+#endif
+
+  transaction_result replace_state_and_activate(
+      const std::string &path,
+      const std::string &candidate_document,
+      const std::function<bool()> &activate,
+      fault_plan *faults = nullptr);
+
+  template<typename Snapshot, typename Commit, typename UuidFactory>
+  std::string handle_serialized_request(
+      const std::string &frame,
+      const std::string_view expected_host_uuid,
+      const std::string &server_certificate,
+      std::mutex &state_mutex,
+      Snapshot &&snapshot,
+      Commit &&commit,
+      UuidFactory &&uuid_factory) {
+    try {
+      const auto parsed = parse_request(frame, expected_host_uuid);
+      if (parsed.action == operation::attest) {
+        return attest_response(parsed.host_matches);
+      }
+      std::lock_guard lock(state_mutex);
+      auto candidate = std::invoke(std::forward<Snapshot>(snapshot));
+      mutation_result result {false};
+      if (parsed.action == operation::provision) {
+        result = apply_provision(
+            candidate,
+            parsed.certificate,
+            std::forward<UuidFactory>(uuid_factory));
+      } else {
+        result = apply_revoke(candidate, parsed.certificate);
+      }
+      if (result.changed && !std::invoke(std::forward<Commit>(commit), std::move(candidate))) {
+        return error_response("PersistenceFailed");
+      }
+      return success_response(server_certificate, result.changed);
+    } catch (const protocol_error &error) {
+      return error_response(error.code());
+    } catch (const std::exception &) {
+      return error_response("InternalError");
+    }
+  }
+
+  template<typename Stop>
+  bool accept_transaction_result(
+      const transaction_result result,
+      std::atomic<bool> &integrity_failed,
+      Stop &&fatal_stop) {
+    if (result == transaction_result::recovery_failed) {
+      integrity_failed.store(true);
+      std::invoke(std::forward<Stop>(fatal_stop));
+      return false;
+    }
+    return result == transaction_result::committed;
+  }
+
+  template<typename State, typename Chain, typename Parser>
+  bool activate_verified_state(
+      State &live_state,
+      Chain &live_chain,
+      State &&candidate_state,
+      Chain &&candidate_chain,
+      const std::vector<std::string> &certificates,
+      Parser &&parse_certificate) {
+    for (const auto &certificate : certificates) {
+      auto parsed = std::invoke(parse_certificate, certificate);
+      if (!parsed || candidate_chain.verify(parsed.get()) != nullptr) {
+        return false;
+      }
+    }
+    live_state = std::move(candidate_state);
+    live_chain = std::move(candidate_chain);
+    return true;
+  }
