+  std::optional<unsigned long> parse_unsigned_environment(const char *name) {
+    const char *raw = std::getenv(name);
+    if (!raw || !*raw) {
+      return std::nullopt;
+    }
+    char *end = nullptr;
+    errno = 0;
+    const auto value = std::strtoul(raw, &end, 10);
+    if (errno != 0 || !end || *end != '\0') {
+      return std::nullopt;
+    }
+    return value;
+  }
+
+  std::optional<unsigned long> parse_octal_environment(const char *name) {
+    const char *raw = std::getenv(name);
+    if (!raw || !*raw) {
+      return std::nullopt;
+    }
+    char *end = nullptr;
+    errno = 0;
+    const auto value = std::strtoul(raw, &end, 8);
+    if (errno != 0 || !end || *end != '\0') {
+      return std::nullopt;
+    }
+    return value;
+  }
+
+  std::optional<korri_control_socket> systemd_korri_control_socket() {
+    const char *fd_names = std::getenv("LISTEN_FDNAMES");
+    const auto listen_pid = parse_unsigned_environment("LISTEN_PID");
+    const auto listen_fds = parse_unsigned_environment("LISTEN_FDS");
+    const auto expected_uid = parse_unsigned_environment("KORRI_CERTIFICATE_CONTROL_UID");
+    const auto expected_gid = parse_unsigned_environment("KORRI_CERTIFICATE_CONTROL_GID");
+    const auto expected_owner_gid =
+        parse_unsigned_environment("KORRI_CERTIFICATE_CONTROL_OWNER_GID");
+    const auto expected_mode = parse_octal_environment("KORRI_CERTIFICATE_CONTROL_MODE");
+    const char *expected_path = std::getenv("KORRI_CERTIFICATE_CONTROL_PATH");
+    if (!fd_names && !listen_pid && !listen_fds && !expected_uid && !expected_gid &&
+        !expected_owner_gid && !expected_mode && !expected_path) {
+      return std::nullopt;
+    }
+    const auto selected = fd_names && listen_fds
+        ? korri_certificate_control::select_systemd_descriptor(*listen_fds, fd_names)
+        : std::nullopt;
+    if (!selected || !listen_pid || !expected_uid || !expected_gid || !expected_owner_gid ||
+        !expected_mode || !expected_path || !*expected_path ||
+        *listen_pid != static_cast<unsigned long>(::getpid()) ||
+        *expected_uid > static_cast<unsigned long>(std::numeric_limits<uid_t>::max()) ||
+        *expected_gid > static_cast<unsigned long>(std::numeric_limits<gid_t>::max()) ||
+        *expected_owner_gid > static_cast<unsigned long>(std::numeric_limits<gid_t>::max()) ||
+        *expected_mode > 0777UL) {
+      BOOST_LOG(error) << "Korri certificate control socket activation is invalid"sv;
+      return std::nullopt;
+    }
+
+    if (!korri_certificate_control::validate_and_harden_listening_descriptor(
+            *selected,
+            expected_path,
+            0,
+            static_cast<gid_t>(*expected_owner_gid),
+            static_cast<mode_t>(*expected_mode))) {
+      BOOST_LOG(error) << "Korri certificate control descriptor does not match the protected socket unit"sv;
+      return std::nullopt;
+    }
+
+    return korri_control_socket {
+        *selected,
+        static_cast<uid_t>(*expected_uid),
+        static_cast<gid_t>(*expected_gid),
+    };
+  }
