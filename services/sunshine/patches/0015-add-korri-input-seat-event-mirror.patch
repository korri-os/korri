+  bool korri_input_seat_emit_json(std::string_view json, const korri_input_seat_active_launch_t &active) {
+    auto socket_path = korri_input_seat_socket_path();
+    if (!korri_input_seat_mirror_ready(socket_path, active)) {
+      return false;
+    }
+
+    std::string frame;
+    frame.reserve(json.size() + active.mirror_token.size() + 65);
+    frame += "{\"mirrorToken\":\"";
+    frame += korri_input_seat_json_escape(active.mirror_token);
+    frame += "\",\"frame\":";
+    frame += json;
+    frame += "}\n";
+
+    if (frame.size() > KORRI_INPUT_SEAT_MAX_FRAME_BYTES) {
+      if (!korri_input_seat_logged_oversized_frame.exchange(true)) {
+        BOOST_LOG(warning) << "input seat mirror frame exceeded maximum size"sv;
+      }
+      return true;
+    }
+
+    auto fd = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0) {
+      if (!korri_input_seat_logged_socket_failure.exchange(true)) {
+        BOOST_LOG(warning) << "failed to create input seat mirror socket"sv;
+      }
+      return true;
+    }
+
+    sockaddr_un addr {};
+    addr.sun_family = AF_UNIX;
+    std::strncpy(addr.sun_path, socket_path, sizeof(addr.sun_path) - 1);
+
+    if (::connect(fd, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) < 0) {
+      auto connect_error = errno;
+      ::close(fd);
+      if (connect_error != EINPROGRESS && connect_error != EAGAIN && connect_error != EWOULDBLOCK &&
+          !korri_input_seat_logged_socket_failure.exchange(true)) {
+        BOOST_LOG(warning) << "failed to connect input seat mirror socket"sv;
+      }
+      return true;
+    }
+
+#ifdef MSG_NOSIGNAL
+    constexpr auto send_flags = MSG_NOSIGNAL | MSG_DONTWAIT;
+#else
+    constexpr auto send_flags = MSG_DONTWAIT;
+#endif
+    // Do not disclose launch authority to an untrusted local socket replacement.
+    ucred peer {};
+    socklen_t peer_size = sizeof(peer);
+    if (::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size) != 0 ||
+        peer_size != sizeof(peer) || peer.uid != 0) {
+      ::close(fd);
+      return true;
+    }
+    auto result = ::send(fd, frame.data(), frame.size(), send_flags);
+    auto incomplete_send = result != static_cast<ssize_t>(frame.size());
+    ::close(fd);
+    if (incomplete_send && !korri_input_seat_logged_write_failure.exchange(true)) {
+      BOOST_LOG(warning) << "failed to write complete input seat mirror message"sv;
+    }
+    return true;
+  }
