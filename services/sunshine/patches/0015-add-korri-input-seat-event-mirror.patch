+  korri_input_seat_active_launch_t korri_input_seat_active_launch() {
+    auto runtime_dir = korri_input_seat_runtime_dir();
+    if (runtime_dir == nullptr || runtime_dir[0] != '/' || std::strchr(runtime_dir, '%') != nullptr) {
+      if (!korri_input_seat_logged_bad_runtime_dir.exchange(true)) {
+        BOOST_LOG(warning) << "invalid input seat mirror runtime directory"sv;
+      }
+      return {};
+    }
+
+    auto dir_fd = ::open(runtime_dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (dir_fd < 0) {
+      return {};
+    }
+    auto sidecar_fd = ::openat(dir_fd, KORRI_INPUT_SEAT_SIDECAR_NAME.data(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    ::close(dir_fd);
+    if (sidecar_fd < 0) {
+      return {};
+    }
+
+    struct stat sidecar_stat {};
+    auto stat_ok = ::fstat(sidecar_fd, &sidecar_stat) == 0;
+    auto authority_ok = stat_ok && sidecar_stat.st_uid == 0 && sidecar_stat.st_gid == ::getegid();
+    auto mode_ok = stat_ok && (sidecar_stat.st_mode & S_IRGRP) != 0 && (sidecar_stat.st_mode & (S_IWGRP | S_IXGRP | S_IRWXO)) == 0;
+    auto size_ok = stat_ok && sidecar_stat.st_size > 0 &&
+                   static_cast<std::uint64_t>(sidecar_stat.st_size) <= KORRI_INPUT_SEAT_MAX_SIDECAR_BYTES;
+    if (!stat_ok || !S_ISREG(sidecar_stat.st_mode) || !authority_ok || !mode_ok || !size_ok) {
+      ::close(sidecar_fd);
+      if (!korri_input_seat_logged_bad_sidecar.exchange(true)) {
+        BOOST_LOG(warning) << "invalid input seat mirror active-launch sidecar metadata"sv;
+      }
+      return {};
+    }
+
+    std::array<char, KORRI_INPUT_SEAT_MAX_SIDECAR_BYTES + 1> buffer {};
+    std::size_t used = 0;
+    while (used < buffer.size()) {
+      auto result = ::read(sidecar_fd, buffer.data() + used, buffer.size() - used);
+      if (result < 0 && errno == EINTR) {
+        continue;
+      }
+      if (result <= 0) {
+        break;
+      }
+      used += static_cast<std::size_t>(result);
+    }
+    ::close(sidecar_fd);
+    if (used == 0 || used > KORRI_INPUT_SEAT_MAX_SIDECAR_BYTES) {
+      if (!korri_input_seat_logged_bad_sidecar.exchange(true)) {
+        BOOST_LOG(warning) << "invalid input seat mirror active-launch sidecar size"sv;
+      }
+      return {};
+    }
+
+    auto document = nlohmann::json::parse(buffer.data(), buffer.data() + used, nullptr, false);
+    if (document.is_discarded() || !document.is_object() || document.size() != 3 ||
+        !document.contains("launchId") || !document["launchId"].is_string() ||
+        !document.contains("generation") || !document["generation"].is_number_integer() ||
+        !document.contains("mirrorToken") || !document["mirrorToken"].is_string()) {
+      if (!korri_input_seat_logged_bad_sidecar.exchange(true)) {
+        BOOST_LOG(warning) << "invalid input seat mirror active-launch sidecar schema"sv;
+      }
+      return {};
+    }
+
+    std::uint64_t generation = 0;
+    if (document["generation"].is_number_unsigned()) {
+      generation = document["generation"].get<std::uint64_t>();
+    } else {
+      auto signed_generation = document["generation"].get<std::int64_t>();
+      if (signed_generation < 0) {
+        if (!korri_input_seat_logged_bad_sidecar.exchange(true)) {
+          BOOST_LOG(warning) << "invalid input seat mirror active-launch generation"sv;
+        }
+        return {};
+      }
+      generation = static_cast<std::uint64_t>(signed_generation);
+    }
+
+    korri_input_seat_active_launch_t active;
+    active.launch_id = document["launchId"].get<std::string>();
+    active.mirror_token = document["mirrorToken"].get<std::string>();
+    active.generation = generation;
+    active.ready = korri_input_seat_authority_string_valid(active.launch_id, KORRI_INPUT_SEAT_MAX_LAUNCH_ID_BYTES) &&
+                   korri_input_seat_authority_string_valid(active.mirror_token, KORRI_INPUT_SEAT_MAX_MIRROR_TOKEN_BYTES);
+    if (!active.ready && !korri_input_seat_logged_bad_sidecar.exchange(true)) {
+      BOOST_LOG(warning) << "invalid input seat mirror active-launch authority values"sv;
+    }
+    return active;
+  }
