+  // All mutable controller state and timer IDs belong to the single upstream
+  // input task_pool thread (main.cpp: task_pool.start(1)). Only stopped crosses
+  // threads. Never capture input_t strongly in a recurring timer.
+  struct korri_input_seat_stream_t;
+  static std::vector<std::weak_ptr<korri_input_seat_stream_t>> korri_input_seat_streams;
+
+  bool korri_input_seat_same_launch(const korri_input_seat_active_launch_t &a, const korri_input_seat_active_launch_t &b) {
+    return a.ready && b.ready && a.launch_id == b.launch_id &&
+           a.generation == b.generation && a.mirror_token == b.mirror_token;
+  }
+
+  struct korri_input_seat_stream_t: std::enable_shared_from_this<korri_input_seat_stream_t> {
+    // Capture exactly once, at input::alloc, NOT on first input or on a timer.
+    const bool configured {korri_input_seat_receiver_configured()};
+    const korri_input_seat_active_launch_t authority {configured ? korri_input_seat_active_launch() : korri_input_seat_active_launch_t {}};
+    std::atomic_bool stopped {false};
+    bool fenced {!authority.ready};
+    bool registered {false};
+    struct controller_t {
+      bool connected {false};
+      bool has_state {false};
+      NV_MULTI_CONTROLLER_PACKET state {};
+    };
+    std::array<controller_t, MAX_GAMEPADS> controllers {};
+    thread_pool_util::ThreadPool::task_id_t timer {};
+
+    ~korri_input_seat_stream_t() {
+      task_pool.cancel(timer);
+    }
+
+    void disconnect(std::size_t number, std::string_view reason) {
+      if (controllers[number].connected) {
+        korri_input_seat_emit_source_disconnected(number, reason, authority);
+        controllers[number] = {};
+      }
+    }
+
+    void retire(std::string_view reason) {
+      fenced = true;
+      task_pool.cancel(timer);
+      timer = nullptr;
+      for (std::size_t number = 0; number < controllers.size(); ++number) {
+        disconnect(number, reason);
+      }
+    }
+
+    bool allowed() {
+      if (stopped.load() || fenced) {
+        return false;
+      }
+      if (!korri_input_seat_same_launch(authority, korri_input_seat_active_launch())) {
+        // Even disappearance is terminal. An old stream can never acquire a
+        // replacement launch's authority or replay held state into that launch.
+        retire("launch-authority-changed"sv);
+        return false;
+      }
+      return true;
+    }
+
+    bool claim(std::size_t number) {
+      if (!allowed()) {
+        return false;
+      }
+      if (!registered) {
+        korri_input_seat_streams.erase(std::remove_if(korri_input_seat_streams.begin(), korri_input_seat_streams.end(),
+          [](const auto &entry) { return entry.expired(); }), korri_input_seat_streams.end());
+        korri_input_seat_streams.emplace_back(shared_from_this());
+        registered = true;
+      }
+      for (const auto &entry : korri_input_seat_streams) {
+        auto other = entry.lock();
+        if (other && other.get() != this && korri_input_seat_same_launch(authority, other->authority) &&
+            other->controllers[number].connected) {
+          // The private treaty has no stream ID. Do not merge two streams or
+          // silently remap controllerNumber. Neither ambiguous stream may win.
+          other->retire("ambiguous-controller-number"sv);
+          retire("ambiguous-controller-number"sv);
+          BOOST_LOG(warning) << "input seat mirror fenced colliding stream controller numbers"sv;
+          return false;
+        }
+      }
+      if (!controllers[number].connected) {
+        controllers[number].connected = true;
+        korri_input_seat_emit_source_connected(number, authority);
+      }
+      schedule();
+      return true;
+    }
+
+    void schedule() {
+      if (!timer && !stopped.load() && !fenced) {
+        timer = task_pool.pushDelayed([weak = weak_from_this()]() {
+          if (auto stream = weak.lock()) {
+            stream->timer = nullptr;
+            stream->refresh();
+          }
+        }, 200ms).task_id;
+      }
+    }
+
+    void refresh() {
+      if (!allowed()) {
+        return;
+      }
+      bool live = false;
+      for (std::size_t number = 0; number < controllers.size(); ++number) {
+        auto &controller = controllers[number];
+        if (!controller.connected) {
+          continue;
+        }
+        live = true;
+        if (stopped.load()) {
+          break;
+        }
+        if (controller.has_state) {
+          korri_input_seat_emit_source_state(&controller.state, authority);
+        }
+        // Arrival does not establish neutral state. Never fabricate a baseline
+        // for a controller that has not sent its first actual state packet.
+      }
+      if (live) {
+        schedule();
+      }
+    }
+
+    void arrival(std::size_t number) {
+      claim(number);
+    }
+
+    void update(PNV_MULTI_CONTROLLER_PACKET packet) {
+      if (!allowed()) {
+        return;
+      }
+      // The mask describes the stream's live set, not just this packet's index.
+      for (std::size_t number = 0; number < controllers.size(); ++number) {
+        if (!(static_cast<std::uint16_t>(packet->activeGamepadMask) & (1u << number))) {
+          disconnect(number, "active-gamepad-mask-cleared"sv);
+        }
+      }
+      auto number = packet->controllerNumber;
+      if ((static_cast<std::uint16_t>(packet->activeGamepadMask) & (1u << number)) && claim(number)) {
+        controllers[number].state = *packet;
+        controllers[number].has_state = true;
+        if (!stopped.load()) {
+          korri_input_seat_emit_source_state(packet, authority);
+        }
+      }
+    }
+  };
+
+  void korri_input_seat_stop(const std::shared_ptr<korri_input_seat_stream_t> &stream) {
+    if (!stream->stopped.exchange(true)) {
+      task_pool.push([stream]() { stream->retire("stream-stopped"sv); });
+    }
+  }
