+  std::string korri_input_seat_json_escape(std::string_view value) {
+    std::string escaped;
+    escaped.reserve(value.size());
+    for (auto ch : value) {
+      switch (ch) {
+        case '\\':
+          escaped += "\\\\";
+          break;
+        case '"':
+          escaped += "\\\"";
+          break;
+        case '\n':
+          escaped += "\\n";
+          break;
+        case '\r':
+          escaped += "\\r";
+          break;
+        case '\t':
+          escaped += "\\t";
+          break;
+        default:
+          escaped += ch;
+          break;
+      }
+    }
+    return escaped;
+  }
+
+  bool korri_input_seat_authority_string_valid(std::string_view value, std::size_t max_bytes) {
+    if (value.empty() || value.size() > max_bytes) {
+      return false;
+    }
+    for (auto ch : value) {
+      if (static_cast<unsigned char>(ch) < 0x20) {
+        return false;
+      }
+    }
+    return true;
+  }
