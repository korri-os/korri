+    return socket_path != nullptr && socket_path[0] == '/' &&
+           std::strlen(socket_path) < sizeof(sockaddr_un::sun_path) &&
+           runtime_dir != nullptr && runtime_dir[0] == '/' &&
+           std::strchr(runtime_dir, '%') == nullptr;
