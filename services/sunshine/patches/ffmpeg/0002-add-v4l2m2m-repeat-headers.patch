Subject: [PATCH] avcodec/v4l2_m2m_enc: add opt-in repeated in-band headers

Korri-local change against the reviewed FFmpeg commit. Sunshine sends each
AVPacket as one video frame. Separate sequence-header packets do not meet
that contract, and a recovery IDR must carry its own parameter sets.

Add repeat_headers=1 for the Sunshine profile. Preserve the default encoder
behavior when the option is absent. Reject opening the encoder if the
requested V4L2 header controls cannot be read back with the required values.

The controls and both supported values were read from the Portal Iris
encoder with v4l2-ctl. This is not an upstream patch.

--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -75,6 +75,7 @@
 
     int num_output_buffers;
     int num_capture_buffers;
+    int repeat_headers;
 } V4L2m2mPriv;
 
 /**
--- a/libavcodec/v4l2_m2m_enc.c
+++ b/libavcodec/v4l2_m2m_enc.c
@@ -193,7 +193,20 @@
         v4l2_set_timeperframe(s, avctx->framerate.den, avctx->framerate.num);
 
     /* set ext ctrls */
-    v4l2_set_ext_ctrl(s, MPEG_CID(HEADER_MODE), MPEG_VIDEO(HEADER_MODE_SEPARATE), "header mode", 0);
+    if (((V4L2m2mPriv *)avctx->priv_data)->repeat_headers) {
+        /* Sunshine needs complete, independently decodable IDR packets. */
+        v4l2_set_ext_ctrl(s, MPEG_CID(HEADER_MODE),
+                         MPEG_VIDEO(HEADER_MODE_JOINED_WITH_1ST_FRAME), "header mode", 1);
+        ret = v4l2_get_ext_ctrl(s, MPEG_CID(HEADER_MODE), &val, "header mode", 1);
+        if (ret < 0 || val != MPEG_VIDEO(HEADER_MODE_JOINED_WITH_1ST_FRAME))
+            return AVERROR(EINVAL);
+        v4l2_set_ext_ctrl(s, MPEG_CID(PREPEND_SPSPPS_TO_IDR), 1, "repeat headers", 1);
+        ret = v4l2_get_ext_ctrl(s, MPEG_CID(PREPEND_SPSPPS_TO_IDR), &val, "repeat headers", 1);
+        if (ret < 0 || val != 1)
+            return AVERROR(EINVAL);
+    } else {
+        v4l2_set_ext_ctrl(s, MPEG_CID(HEADER_MODE), MPEG_VIDEO(HEADER_MODE_SEPARATE), "header mode", 0);
+    }
     v4l2_set_ext_ctrl(s, MPEG_CID(BITRATE) , avctx->bit_rate, "bit rate", 1);
     v4l2_set_ext_ctrl(s, MPEG_CID(FRAME_RC_ENABLE), 1, "frame level rate control", 0);
     v4l2_set_ext_ctrl(s, MPEG_CID(GOP_SIZE), avctx->gop_size,"gop size", 1);
@@ -402,6 +415,8 @@
 
 static const AVOption options[] = {
     V4L_M2M_CAPTURE_OPTS,
+    { "repeat_headers", "Join sequence headers to the first frame and repeat them at every IDR",
+        OFFSET(repeat_headers), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, FLAGS },
     { NULL },
 };
 
