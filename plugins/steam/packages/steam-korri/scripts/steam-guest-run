#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: steam-guest-run [steam args...]

Run the mutable ARM64 Steam client from the package-owned FHS runtime capsule.
The caller/guest adapter supplies paths, session variables, driver variables,
and default Steam args. This helper owns the generic FHS execution capsule;
it does not mutate Steam-owned runtime or pressure-vessel files during normal
startup.

Required environment:
  STEAM_HOME        Steam client home containing steamrtarm64/steam
  FEX_ROOTFS        FEX rootfs path for x86/x86_64 Steam Runtime helpers

Optional environment:
  STEAM_PRESSURE_VESSEL_RW_PATHS
                    Colon-separated paths exposed read-write to pressure-vessel
                    (default: /dev/input)
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

require_env() {
  local name="$1" value="${!1:-}"
  if [ -z "$value" ]; then
    echo "error: $name must be set explicitly" >&2
    exit 2
  fi
}

require_env STEAM_HOME
require_env FEX_ROOTFS

client="$STEAM_HOME/steamrtarm64/steam"
if [ ! -x "$client" ]; then
  cat >&2 <<EOF
error: guest-native Steam client is missing or not executable: $client
hint: seed the ARM64 Steam payload into STEAM_HOME first.
EOF
  exit 1
fi

pv_rw_paths="${STEAM_PRESSURE_VESSEL_RW_PATHS:-/dev/input}"
if [ -n "${PRESSURE_VESSEL_FILESYSTEMS_RW:-}" ]; then
  export PRESSURE_VESSEL_FILESYSTEMS_RW="$pv_rw_paths:$PRESSURE_VESSEL_FILESYSTEMS_RW"
else
  export PRESSURE_VESSEL_FILESYSTEMS_RW="$pv_rw_paths"
fi

# The FHS environment supplies the generic distro ABI and Nix-provided system
# libraries. Keep Valve's video codec directory before the wider ARM64 payload:
# steamrtarm64/libvideo.so expects the adjacent video/libavutil.so.60 carrying
# av_malloc_tracked, while the root steamrtarm64/libavutil.so.60 does not.
# Putting the root first makes Steam fail to load steamui.so on Bandai.
export LD_LIBRARY_PATH="$STEAM_HOME/steamrtarm64/video:$STEAM_HOME/steamrtarm64:$STEAM_HOME/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Some Steam helper commands are launched by basename.
export PATH="$STEAM_HOME/steamrtarm64:$STEAM_HOME/steamrtarm64/bin:$PATH"

# e5d3adca1: Steam splices this onto overlay paths without adding a separator.
export LD_PRELOAD=:@inputGuard@
export KORRI_STEAM_INPUT_GUARD=1
export SDL_JOYSTICK_DISABLE_UDEV=1
export GTK_IM_MODULE=xim
unset GIO_EXTRA_MODULES
export LIBGL_DRIVERS_PATH=/run/opengl-driver/lib/dri
export __EGL_VENDOR_LIBRARY_DIRS=/run/opengl-driver/share/glvnd/egl_vendor.d
export LIBVA_DRIVERS_PATH=/run/opengl-driver/lib/dri
export VDPAU_DRIVER_PATH=/run/opengl-driver/lib/vdpau

# Suppressors can strand Valve's mutable ARM64 update metadata. Keep Steam's
# normal verification and repair path active, including in forwarding calls.
filtered=()
for arg in "$@"; do
  case "$arg" in
    -noverifyfiles|-nobootstrapupdate|-skipinitialbootstrap|-norepairfiles) ;;
    *) filtered+=("$arg") ;;
  esac
done
set -- "${filtered[@]}"

# Steam owns its mutable client/runtime tree after seed/bootstrap. Do not run
# steam-guest-runtime-prep --apply here: pre-start pressure-vessel mutations make
# Steam's installed-file verifier repair and relaunch the client repeatedly.
cd "$STEAM_HOME"
exec "$client" "$@"
